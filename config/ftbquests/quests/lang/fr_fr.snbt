	task.6DB1CE8BD67690A5.title: "Faire passer des canaux à travers le tunnel"
	task.778131F448631986.title: "Démarrer un réacteur passif complet"
	task.7E46888DECB0C3D6.title: "Former une structure de fusion basique"
	quest.0A71000000000001.quest_desc: [
		"Le Marqueur est la brique de base de tout QuarryPlus."
		""
		"Poudre de pierre lumineuse, lapis et torche de redstone. Toutes les machines et tous les modules du mod le réclament dans leur recette : fabriques-en large dès maintenant."
	]
	quest.0A71000000000001.quest_subtitle: "Niveau 1 / 5"
	quest.0A71000000000001.title: "Le Marqueur"
	quest.0A71000000000002.quest_desc: [
		"Le Marqueur flexible se règle à la main, hauteur comprise."
		""
		"Commence par une petite zone visible et vérifie chaque bord avant de poser la carrière. Un clic droit ouvre le réglage des dimensions."
	]
	quest.0A71000000000002.quest_subtitle: "Niveau 1 / 5"
	quest.0A71000000000002.title: "Délimiter une zone"
	quest.0A71000000000003.quest_desc: [
		"La Carrière excave toute la zone définie et laisse un trou permanent."
		""
		"Teste-la sur une petite surface, avec énergie et stockage surdimensionnés. La dimension minière est préférable aux grands chantiers."
	]
	quest.0A71000000000003.quest_subtitle: "Niveau 2 / 5"
	quest.0A71000000000003.title: "La première carrière"
	quest.0A71000000000004.quest_desc: [
		"Le Vérificateur d'état lit ce que fait une machine et où elle en est."
		""
		"Indispensable quand une carrière semble bloquée : il distingue un manque d'énergie d'un stockage plein."
	]
	quest.0A71000000000004.quest_subtitle: "Niveau 2 / 5"
	quest.0A71000000000004.title: "Vérifier l'état"
	quest.0A71000000000005.quest_desc: [
		"Le Régleur de Y fixe l'altitude à laquelle la carrière s'arrête."
		""
		"Évite de creuser jusqu'à la bedrock quand seule la couche des diamants t'intéresse. Gros gain de temps et d'énergie."
	]
	quest.0A71000000000005.quest_subtitle: "Niveau 2 / 5"
	quest.0A71000000000005.title: "Régler la profondeur"
	quest.0A71000000000006.quest_desc: [
		"Le Module de pompe évacue les fluides rencontrés pendant l'excavation."
		""
		"Sans lui, une nappe de lave ou un océan noie le chantier et bloque la machine. C'est le premier module à installer."
	]
	quest.0A71000000000006.quest_subtitle: "Niveau 3 / 5"
	quest.0A71000000000006.title: "Module de pompe"
	quest.0A71000000000007.quest_desc: [
		"Le Module de filtre choisit ce que la carrière ramasse et ce qu'elle laisse."
		""
		"Écarte la pierre et la terre : ton réseau de stockage te remerciera. Il se configure avec un livre écrit."
	]
	quest.0A71000000000007.quest_subtitle: "Niveau 3 / 5"
	quest.0A71000000000007.title: "Module de filtre"
	quest.0A71000000000008.quest_desc: [
		"Le Module d'expérience collecte les orbes libérées par l'extraction."
		""
		"L'expérience s'accumule dans la machine et se récupère à la demande. Pratique avec un module anti-bedrock qui casse énormément de blocs."
	]
	quest.0A71000000000008.quest_subtitle: "Niveau 3 / 5"
	quest.0A71000000000008.title: "Module d'expérience"
	quest.0A71000000000009.quest_desc: [
		"Le Module de répétition fait travailler la machine plusieurs fois par tick."
		""
		"La vitesse monte, la consommation d'énergie aussi. À réserver aux installations déjà bien alimentées."
	]
	quest.0A71000000000009.quest_subtitle: "Niveau 3 / 5"
	quest.0A71000000000009.title: "Accélérer l'extraction"
	quest.0A7100000000000A.quest_desc: [
		"Le Déplaceur transfère les enchantements d'un outil vers une machine."
		""
		"C'est ainsi qu'on donne Fortune ou Toucher de soie à une carrière. Prépare une pioche enchantée avant de le poser."
	]
	quest.0A7100000000000A.quest_subtitle: "Niveau 3 / 5"
	quest.0A7100000000000A.title: "Déplacer les enchantements"
	quest.0A7100000000000B.quest_desc: [
		"Le Module anti-bedrock autorise l'extraction de la roche-mère."
		""
		"Il ouvre le fond du monde. Attention dans le Nether : sous la bedrock il n'y a que le vide."
	]
	quest.0A7100000000000B.quest_subtitle: "Niveau 4 / 5"
	quest.0A7100000000000B.title: "Percer la bedrock"
	quest.0A7100000000000C.quest_desc: [
		"Le Marqueur de chunk aligne automatiquement la zone sur les limites du chunk."
		""
		"Bien plus rapide que de poser des marqueurs à la main, et la zone tombe juste avec le chargement de chunks."
	]
	quest.0A7100000000000C.quest_subtitle: "Niveau 4 / 5"
	quest.0A7100000000000C.title: "Marquer un chunk entier"
	quest.0A7100000000000D.quest_desc: [
		"Le Placeur pose des blocs depuis son inventaire."
		""
		"Il sert à reboucher derrière une carrière, ou à automatiser la pose de n'importe quel bloc."
	]
	quest.0A7100000000000D.quest_subtitle: "Niveau 4 / 5"
	quest.0A7100000000000D.title: "Le Placeur"
	quest.0A7100000000000E.quest_desc: [
		"Le Placeur distant agit à plusieurs blocs de lui."
		""
		"Sa portée se règle dans son interface. Utile pour intervenir dans une zone déjà excavée."
	]
	quest.0A7100000000000E.quest_subtitle: "Niveau 4 / 5"
	quest.0A7100000000000E.title: "Placer à distance"
	quest.0A7100000000000F.quest_desc: [
		"La Pompe avancée vide un océan entier et fonctionne de façon autonome."
		""
		"Elle remplace le module de pompe quand tu passes à l'échelle industrielle."
	]
	quest.0A7100000000000F.quest_subtitle: "Niveau 5 / 5"
	quest.0A7100000000000F.title: "La Pompe avancée"
	quest.0A71000000000010.quest_desc: [
		"La Carrière avancée est la machine ultime du mod : elle ne laisse aucun trou."
		""
		"Étoile du Nether, tête de dragon et blocs de diamant et d'émeraude. Elle accepte tous les modules à la fois."
	]
	quest.0A71000000000010.quest_subtitle: "Niveau 5 / 5"
	quest.0A71000000000010.title: "La Carrière avancée"
	quest.65C2C00000000001.title: "Fondations mécaniques"
	quest.65C2C00000000001.quest_subtitle: "Campagne technologique facultative"
	quest.65C2C00000000001.quest_desc: ["Produis un alliage d'andésite pour ouvrir la route technologique. Les recettes et machines détaillées restent expliquées dans l'annexe Create."]
	quest.65C2C00000000002.title: "Convertir le mouvement en énergie"
	quest.65C2C00000000002.quest_desc: ["L'Alternator de Create Crafts & Additions relie la force cinétique au réseau FE et rend les branches industrielles interopérables."]
	quest.65C2C00000000003.title: "Traitement industriel"
	quest.65C2C00000000003.quest_desc: ["Le Metallurgic Infuser marque l'entrée dans Mekanism. Il ouvre les alliages et composants nécessaires aux machines plus avancées."]
	quest.65C2C00000000004.title: "Centraliser le réseau"
	quest.65C2C00000000004.quest_desc: ["Le contrôleur ME transforme les stockages isolés en infrastructure numérique. L'annexe Applied Energistics 2 détaille canaux, énergie et autocraft."]
	quest.65C2C00000000005.title: "Automatiser la production"
	quest.65C2C00000000005.quest_desc: ["Le châssis avancé d'Industrial Foregoing représente une usine capable d'exécuter durablement les tâches répétitives."]
	quest.65C2C00000000006.title: "Produire à grande échelle"
	quest.65C2C00000000006.quest_desc: ["Le contrôleur de réacteur ouvre une production énergétique de grande capacité. Dimensionne-la selon les besoins réels du serveur."]
	quest.65C2C00000000007.title: "Technologie de fin de jeu"
	quest.65C2C00000000007.quest_desc: ["L'Awakened Core conclut cette route facultative. Draconic Evolution reste une annexe endgame et ne conditionne jamais la campagne aventure."]
}
