	reward_table.65C6000000000001.title: "Composant Armory - Acte I"
	reward_table.65C6000000000002.title: "Composant Armory - Acte II"
	reward_table.65C6000000000003.title: "Composant Armory - Acte III"

	quest.65C2100000000001.title: "Bienvenue dans Ascendant"
	quest.65C2100000000001.quest_subtitle: "Un monde commun, plusieurs ambitions"
	quest.65C2100000000001.quest_desc: [
		"Ascendant est une campagne collective où l'exploration, la construction et l'industrie progressent côte à côte."
		""
		"La route principale mène de Twilight Forest à Eternal Starlight, puis aux trois actes de Cataclysm. Elle donne un ordre conseillé sans interdire les détours."
		""
		"Les chapitres annexes expliquent les mods en détail. Ouvre-les lorsque tu veux approfondir une magie, une usine ou une colonie."
	]
	quest.65C2100000000002.title: "Une équipe permanente"
	quest.65C2100000000002.quest_subtitle: "Partager le progrès sans perdre sa place"
	quest.65C2100000000002.quest_desc: [
		"FTB Teams relie les quêtes, les claims et certaines infrastructures de ton groupe."
		""
		"Une quête validée appartient à l'équipe, mais chaque membre peut réclamer sa récompense personnelle. Pour les boss, reste réellement présent dans l'arène : être seulement connecté ou proche du portail ne suffit pas à participer."
		""
		"Crée une équipe durable avant de commencer la campagne afin d'éviter de disperser la progression."
	]
	quest.65C2100000000003.title: "Construire sans enfermer"
	quest.65C2100000000003.quest_subtitle: "Protéger la base et préserver le monde"
	quest.65C2100000000003.quest_desc: [
		"Les claims protègent coffres et blocs contre les interactions ordinaires des autres joueurs. Ils ne remplacent ni l'éclairage, ni les murs, ni une organisation claire des accès."
		""
		"Place les réserves importantes au moins un chunk à l'intérieur de la frontière revendiquée et vérifie les permissions de l'équipe avant d'accueillir un allié."
		""
		"Les réglages plus agressifs sur l'apparition des monstres restent en réserve : la survie doit continuer d'exister autour des villes."
	]
	quest.65C2100000000004.title: "Choisir une direction"
	quest.65C2100000000004.quest_subtitle: "Une campagne, des spécialisations libres"
	quest.65C2100000000004.quest_desc: [
		"La campagne aventure structure les grands voyages et l'endgame. La campagne technologique est facultative : aucune machine ne sert de péage pour combattre un boss."
		""
		"Choisis un premier objectif concret, puis consulte le chapitre du mod concerné. Les liens du livre rapprochent les parcours sans t'imposer de tout accomplir."
		""
		"Pour débuter sans te disperser, prépare un équipement fiable et ouvre la route de Twilight Forest."
	]

	quest.65C2200000000001.title: "Au-delà de l'Overworld"
	quest.65C2200000000001.quest_subtitle: "Chaque portail doit avoir un retour"
	quest.65C2200000000001.quest_desc: [
		"Les autres dimensions apportent des ressources et des dangers que l'Overworld ne peut pas fournir."
		""
		"Avant chaque départ, emporte de quoi éclairer, réparer ton équipement et recréer une voie de retour. Note les coordonnées du portail d'arrivée avant de t'en éloigner."
		""
		"Les Waystones restent libres dans l'Overworld, mais sont désactivées dans les dimensions d'aventure afin que leurs donjons gardent leur sens."
	]
	quest.65C250000000000F.title: "PrÃ©parer le portail"
	quest.65C250000000000F.quest_subtitle: "Eau, vÃ©gÃ©tation et diamant ouvrent le passage"
	quest.65C250000000000F.quest_desc: [
		"Creuse un bassin de 2 x 2 rempli d'eau calme dans un sol naturel, puis entoure ses douze bords de fleurs, champignons ou jeunes pousses."
		""
		"Lorsque le cadre vÃ©gÃ©tal est complet, jette un Diamond dans l'eau : la foudre active le portail. Ã‰loigne les coffres, animaux et constructions fragiles avant l'essai."
		""
		"PrÃ©pare nourriture, blocs et un moyen de noter les coordonnÃ©es avant de franchir le passage."
	]
	quest.65C2500000000002.title: "Franchir le portail"
	quest.65C2500000000002.quest_subtitle: "Ã‰tablir le retour avant de suivre la carte"
	quest.65C2500000000002.quest_desc: [
		"De l'autre côté, le ciel reste suspendu dans un crépuscule éternel et la forêt protège elle-même ses territoires."
		""
		"Entre dans la Twilight Forest. Le portail de retour apparaît normalement près de ton point d'arrivée."
		""
		"Pose immédiatement un repère sur ta carte et sécurise les alentours. Les Waystones ne fonctionnent ni vers, ni depuis, ni à l'intérieur de cette dimension."
		""
		"La progression native est individuelle : chaque joueur doit participer et ramasser les objets-clés des boss pour lever ses propres protections de biome."
	]
	quest.65C2500000000010.title: "Une plume de corbeau"
	quest.65C2500000000010.quest_subtitle: "Le Raven est la seule source de ce composant"
	quest.65C2500000000010.quest_desc: [
		"Cherche un Forest Raven à la surface de la Twilight Forest. Ces petits corbeaux noirs laissent parfois une Raven Feather."
		""
		"Cette ressource n'est pas disponible avant l'entrée dans la dimension : elle constitue la première étape de la Magic Map."
	]
	quest.65C2500000000011.title: "Des Torchberries"
	quest.65C2500000000011.quest_subtitle: "Une baie lumineuse pousse dans les cavernes"
	quest.65C2500000000011.quest_desc: [
		"Explore une petite grotte ou les racines sous les arbres. Les Torchberries poussent sous terre et émettent une faible lumière."
		""
		"Récolte-en au moins une pour le Magic Map Focus."
	]
	quest.65C2500000000012.title: "Une poussière lumineuse"
	quest.65C2500000000012.quest_subtitle: "Le dernier ingrÃ©dient vient de l'Overworld"
	quest.65C2500000000012.quest_desc: [
		"Il faut une Glowstone Dust pour compléter le focus. Tu peux l'avoir apportée du Nether ou en récupérer par une autre source du modpack."
		""
		"Consulte JEI si tu ne connais pas encore les moyens disponibles dans Ascendant."
	]
	quest.65C2500000000013.title: "Le Magic Map Focus"
	quest.65C2500000000013.quest_subtitle: "Trois matÃ©riaux deviennent un outil de cartographie"
	quest.65C2500000000013.quest_desc: [
		"Les chemins de cette forêt se ressemblent tous. Pour révéler ses monuments, il faut d'abord fabriquer le cœur d'une carte capable de lire sa magie."
		""
		"Assemble sans forme imposée une Raven Feather, une Torchberry et une Glowstone Dust."
		""
		"Le résultat est le cœur de la carte magique."
	]
	quest.65C2500000000001.title: "La Blank Magic Map"
	quest.65C2500000000001.quest_subtitle: "Une carte vide attend son premier point dâ€™ancrage"
	quest.65C2500000000001.quest_desc: [
		"Place le Magic Map Focus au centre d'une table de craft et entoure-le de huit feuilles de papier."
		""
		"Tu obtiens une Blank Magic Map. Elle n'affiche encore rien : elle doit être ouverte dans la Twilight Forest."
	]
	quest.65C2500000000014.title: "Ouvrir la Magic Map"
	quest.65C2500000000014.quest_subtitle: "La forÃªt rÃ©vÃ¨le ses grands repÃ¨res"
	quest.65C2500000000014.quest_desc: [
		"Les grandes créatures de la forêt laissent une empreinte jusque dans le paysage. La Magic Map transforme ces traces en symboles visibles."
		""
		"Utilise la Blank Magic Map pendant que tu te trouves dans la Twilight Forest. Elle devient une Filled Magic Map centrée sur ta position."
		""
		"Ses symboles représentent les principaux donjons. La carte indique où chercher, mais elle ne remplace pas l'exploration du terrain."
	]
	quest.65C2500000000003.title: "La Naga"
	quest.65C2500000000003.quest_subtitle: "Le premier verrou naturel de la progression"
	quest.65C2500000000003.quest_desc: [
		"Une cour de pierre oubliée coupe la canopée. Son gardien écailleux est le premier sceau qui retient les secrets de la forêt."
		""
		"Repère une grande cour carrée sur la Magic Map. La Naga est le premier boss obligatoire."
		""
		"Combats dans l'arène, reste mobile et évite ses charges. Elle raccourcit à mesure qu'elle perd des points de vie."
		""
		"Après la victoire, ne quitte pas l'arène avant que chaque joueur concerné ait ramassé ou touché les écailles et le trophée."
	]
	quest.65C2500000000015.title: "Les écailles de Naga"
	quest.65C2500000000015.quest_subtitle: "Un matÃ©riau dÃ©fensif pour le dÃ©but de l'aventure"
	quest.65C2500000000015.quest_desc: [
		"Ramasse une Naga Scale. Avec la progression renforcée active, cet objet participe au déblocage de la tour du Lich."
		""
		"En multijoueur, faites circuler les objets-clés entre les participants avant de les ranger."
	]
	quest.65C2500000000016.title: "Le trophée de Naga"
	quest.65C2500000000016.quest_subtitle: "La preuve qui ouvre la tour du Lich"
	quest.65C2500000000016.quest_desc: [
		"Conserve le Naga Trophy. Il prouve la victoire et pourra aussi servir plus tard à ouvrir la forteresse des Chevaliers fantômes."
	]
	quest.65C2500000000017.title: "La tour du Lich est accessible"
	quest.65C2500000000017.quest_subtitle: "Le trophÃ©e de Naga dissipe la barriÃ¨re"
	quest.65C2500000000017.quest_desc: [
		"L'advancement natif de la Naga confirme que le jeu a enregistré la victoire et ses objets-clés."
		""
		"Si la quête reste incomplète, vérifie que ton personnage a bien participé au combat et pris en main le trophée ainsi qu'une écaille."
	]
	quest.65C2500000000004.title: "Le Twilight Lich"
	quest.65C2500000000004.quest_subtitle: "Trois boucliers et une vraie fenÃªtre de riposte"
	quest.65C2500000000004.quest_desc: [
		"Au-dessus des arbres se dresse la tour d'un souverain déchu. Ses illusions protègent encore un pouvoir que la Naga gardait à distance."
		""
		"Trouve une haute tour coiffée de plusieurs petites tours. Monte avec des blocs, de la nourriture et une arme à distance."
		""
		"Au début du combat, renvoie les projectiles du véritable Lich pour briser ses boucliers. Ignore ses copies transparentes. Il invoque ensuite des créatures, puis termine au corps à corps."
		""
		"Sa défaite ouvre trois branches indépendantes : marais, forêt sombre et neiges."
	]
	quest.65C2500000000018.title: "Le trophée du Lich"
	quest.65C2500000000018.quest_subtitle: "La couronne morte dÃ©bloque trois rÃ©gions"
	quest.65C2500000000018.quest_desc: [
		"Ramasse le Lich Trophy et vérifie aussi le coffre ou les objets tombés au sol. Le Lich fournit notamment l'un de ses sceptres."
		""
		"Fais toucher le trophée et le butin aux autres participants pour que leur progression personnelle soit reconnue."
	]
	quest.65C2500000000019.title: "Trois routes s'ouvrent"
	quest.65C2500000000019.quest_subtitle: "Marais, forÃªt sombre et neige deviennent parallÃ¨les"
	quest.65C2500000000019.quest_desc: [
		"La chute du Lich brise trois anciens verrous. Le marais gronde, la forêt sombre s'éveille et le blizzard se retire juste assez pour laisser passer les voyageurs."
		""
		"La victoire du Lich déverrouille les trois branches affichées ci-dessous. Tu peux les terminer dans l'ordre de ton choix."
		""
		"Marais : Minoshroom puis Hydre. Forêt sombre : Chevaliers fantômes puis Ur-Ghast. Neiges : Alpha Yeti puis Reine des neiges."
	]
	quest.65C250000000001A.title: "Maze Map Focus"
	quest.65C250000000001A.quest_subtitle: "Un Maze Slime ouvre la cartographie souterraine"
	quest.65C250000000001A.quest_desc: [
		"Les Minotaurs et certains coffres du labyrinthe peuvent fournir un Maze Map Focus."
		""
		"Il n'est pas obligatoire, mais il réduit fortement le risque de tourner en rond dans ce donjon à deux niveaux."
	]
	quest.65C250000000001B.title: "La Maze Map"
	quest.65C250000000001B.quest_subtitle: "Lire le Labyrinth sans supprimer le risque"
	quest.65C250000000001B.quest_desc: [
		"Entoure un Maze Map Focus de huit feuilles de papier, puis active la carte à l'intérieur du labyrinthe."
		""
		"Sans cette carte, marque les intersections avec des blocs faciles à reconnaître et garde toujours un chemin de retour."
	]
	quest.65C2500000000005.title: "Le Minoshroom"
	quest.65C2500000000005.quest_subtitle: "Au second niveau du Labyrinth"
	quest.65C2500000000005.quest_desc: [
		"Sous les eaux stagnantes, un labyrinthe enferme une créature devenue maître de ses galeries. Sa viande porte la chaleur nécessaire pour survivre au marais de feu."
		""
		"Cherche un tertre donnant accès au Labyrinth dans un Twilight Swamp. Le Minoshroom se trouve au deuxième niveau, pas au premier."
		""
		"Emporte beaucoup de nourriture, des torches et de quoi marquer les passages. Les murs du labyrinthe résistent fortement au minage ordinaire."
		""
		"Après le combat, ramasse surtout le Meef Stroganoff : le tuer seul ne suffit pas à ouvrir le Fire Swamp."
	]
	quest.65C250000000001C.title: "Manger le Meef Stroganoff"
	quest.65C250000000001C.quest_subtitle: "Le plat du Minoshroom dissipe le feu du marais"
	quest.65C250000000001C.quest_desc: [
		"Mange une portion de Meef Stroganoff obtenue sur le Minoshroom. Cette consommation, et non la seule mort du boss, lève la protection du Fire Swamp."
		""
		"Chaque joueur doit effectuer cette action sur son propre personnage."
	]
	quest.65C2500000000006.title: "L'Hydre"
	quest.65C2500000000006.quest_subtitle: "Les tÃªtes ouvertes sont les seules cibles vulnÃ©rables"
	quest.65C2500000000006.quest_desc: [
		"Au cœur du marais embrasé, plusieurs gueules partagent une même colère. Le feu qui protège l'Hydre est aussi la faiblesse qu'elle révèle lorsqu'elle attaque."
		""
		"Cherche une grande colline éventrée au centre d'un Fire Swamp. Prépare résistance au feu, nourriture et espace de déplacement."
		""
		"Vise les têtes lorsqu'elles ouvrent la gueule pour attaquer. Les coups portés au corps sont beaucoup moins utiles. Évite de rester face à plusieurs têtes."
		""
		"La victoire termine la branche des marais."
	]
	quest.65C250000000001D.title: "Le sang ardent"
	quest.65C250000000001D.quest_subtitle: "Une ressource rare pour les crafts de feu"
	quest.65C250000000001D.quest_desc: [
		"Ramasse du Fiery Blood dans le butin de l'Hydre. Conserve-le : il sert à fabriquer l'équipement Fiery et matérialise cette étape de progression."
	]
	quest.65C250000000001E.title: "Branche des marais terminée"
	quest.65C250000000001E.quest_subtitle: "Le marais et la Fire Swamp sont maÃ®trisÃ©s"
	quest.65C250000000001E.quest_desc: [
		"L'advancement de l'Hydre confirme que cette route est validée. Il faudra aussi terminer les routes de la forêt sombre et des neiges pour entrer dans les Highlands sans pluie acide."
	]
	quest.65C250000000001F.title: "Ouvrir la forteresse sombre"
	quest.65C250000000001F.quest_subtitle: "Le trophÃ©e du Lich ouvre les ruines"
	quest.65C250000000001F.quest_desc: [
		"Les chevaliers enterrés ne reconnaissent plus les vivants, seulement les marques de victoire. Un trophée est la seule autorité que leur forteresse accepte encore."
		""
		"Dans la Dark Forest, cherche une Goblin Knight Stronghold souterraine. L'entrée protégée contient un Trophy Pedestal."
		""
		"Pose n'importe quel trophée de boss Twilight sur le piédestal. Lorsque le jeu valide l'action, la protection de l'entrée disparaît. Tu peux ensuite récupérer ton trophée."
	]
	quest.65C2500000000007.title: "Les Chevaliers fantômes"
	quest.65C2500000000007.quest_subtitle: "Six armures gardent le Knightly Stronghold"
	quest.65C2500000000007.quest_desc: [
		"Explore la forteresse jusqu'à une grande salle funéraire. Le combat oppose l'équipe à plusieurs Knight Phantoms : une seule élimination ne suffit pas."
		""
		"Reste en mouvement pendant leurs formations et élimine tout le groupe. Un coffre de récompense apparaît lorsque la rencontre est réellement terminée."
	]
	quest.65C2500000000020.title: "Le trophée des Chevaliers"
	quest.65C2500000000020.quest_subtitle: "La preuve laissÃ©e par la derniÃ¨re armure"
	quest.65C2500000000020.quest_desc: [
		"Récupère le Knight Phantom Trophy dans le coffre apparu après le combat. Cette victoire lève la protection de la Dark Tower."
	]
	quest.65C2500000000021.title: "Trouver de la Carminite"
	quest.65C2500000000021.quest_subtitle: "Les murs de la Dark Tower contiennent la clÃ©"
	quest.65C2500000000021.quest_desc: [
		"Entre dans la Dark Tower située au centre d'une Dark Forest et récupère de la Carminite dans le donjon."
		""
		"Prévois une longue ascension, des blocs, de la nourriture et du matériel de rechange. La tour contient des mécanismes et des salles dangereuses."
	]
	quest.65C2500000000022.title: "Activer un Ghast Trap"
	quest.65C2500000000022.quest_subtitle: "ChargÃ© par les Carminite Ghastlings vaincus"
	quest.65C2500000000022.quest_desc: [
		"Dans les parties supérieures de la tour, élimine des Carminite Ghastlings près d'un Ghast Trap pour le charger. Lorsqu'il est prêt, active-le avec un signal de redstone."
		""
		"Le piège attire et immobilise les ghasts. Comprendre ce mécanisme prépare directement le combat contre l'Ur-Ghast."
	]
	quest.65C2500000000008.title: "L'Ur-Ghast"
	quest.65C2500000000008.quest_subtitle: "Les piÃ¨ges renvoient la puissance du boss"
	quest.65C2500000000008.quest_desc: [
		"Les pleurs entendus pendant l'ascension viennent du maître de la tour. Trop haut pour être combattu normalement, il faut retourner contre lui les pièges de sa propre forteresse."
		""
		"L'Ur-Ghast attend au sommet de la Dark Tower. Utilise les Ghast Traps de l'arène : charge-les avec les créatures invoquées, puis active-les pour attirer le boss au sol."
		""
		"Détruis rapidement les groupes de ghasts et évite de rester sous les attaques de zone. La victoire termine la branche de la forêt sombre."
	]
	quest.65C2500000000023.title: "Le trophée de l'Ur-Ghast"
	quest.65C2500000000023.quest_subtitle: "La victoire ferme la Dark Tower"
	quest.65C2500000000023.quest_desc: [
		"Ramasse l'Ur-Ghast Trophy et fais-le circuler entre les participants. Le coffre ou les objets de victoire peuvent apparaître sur l'arène supérieure."
	]
	quest.65C2500000000024.title: "Branche sombre terminée"
	quest.65C2500000000024.quest_subtitle: "La Dark Forest et sa tour sont maÃ®trisÃ©es"
	quest.65C2500000000024.quest_desc: [
		"L'advancement de l'Ur-Ghast confirme la fin de cette route. Termine également l'Hydre et la Reine des neiges pour déverrouiller les Highlands."
	]
	quest.65C2500000000009.title: "L'Alpha Yeti"
	quest.65C2500000000009.quest_subtitle: "Le premier gardien de la branche neige"
	quest.65C2500000000009.quest_desc: [
		"Le blizzard n'est pas naturel : il obéit au gardien de la forêt enneigée. Tant que l'Alpha Yeti règne dans sa tanière, le Glacier refuse les intrus."
		""
		"Dans une Snowy Forest, cherche une grande Yeti Lair ouverte sur plusieurs côtés. L'Alpha Yeti vit au centre parmi des groupes de Yetis."
		""
		"Reste mobile pour éviter ses charges, ses projections et les blocs de glace. Éliminer le boss permet ensuite d'affronter la Reine des neiges."
	]
	quest.65C2500000000025.title: "La fourrure d'Alpha Yeti"
	quest.65C2500000000025.quest_subtitle: "Une protection naturelle contre le froid"
	quest.65C2500000000025.quest_desc: [
		"Ramasse l'Alpha Yeti Fur. Cet objet est le jalon qui lève la tempête de neige protégeant le Glacier et l'Aurora Palace."
		""
		"Chaque joueur doit le prendre en main pour garantir sa progression personnelle."
	]
	quest.65C2500000000026.title: "Le Glacier est accessible"
	quest.65C2500000000026.quest_subtitle: "La fourrure du Yeti protÃ¨ge du froid"
	quest.65C2500000000026.quest_desc: [
		"L'advancement de l'Alpha Yeti confirme que le Glacier est déverrouillé. Si le blizzard persiste pour un joueur, faites-lui toucher la fourrure et le trophée."
	]
	quest.65C250000000000A.title: "La Reine des neiges"
	quest.65C250000000000A.quest_subtitle: "Atteindre l'Ã©tage supÃ©rieur de l'Aurora Palace"
	quest.65C250000000000A.quest_desc: [
		"Au sommet du palais, la Reine règne sur un hiver immobile. Sa défaite constitue le dernier sceau de la route des neiges."
		""
		"L'Aurora Palace se trouve au centre d'un Glacier. Grimpe jusqu'aux salles supérieures en surveillant les passages et les ouvertures dans le sol."
		""
		"La Snow Queen alterne plusieurs comportements aériens et des attaques de glace. Reste mobile, garde une option à distance et frappe pendant ses fenêtres accessibles."
	]
	quest.65C2500000000027.title: "Le trophée de la Reine"
	quest.65C2500000000027.quest_subtitle: "La preuve conservÃ©e au sommet du palais"
	quest.65C2500000000027.quest_desc: [
		"Ramasse le Snow Queen Trophy et partage le contact avec les autres participants. Cette victoire termine la branche des neiges."
	]
	quest.65C2500000000028.title: "Branche des neiges terminée"
	quest.65C2500000000028.quest_subtitle: "La branche glacÃ©e est achevÃ©e"
	quest.65C2500000000028.quest_desc: [
		"L'advancement de la Snow Queen confirme cette route. Les Highlands ne deviennent sûrs qu'après la validation simultanée de l'Hydre, de l'Ur-Ghast et de la Reine."
	]
	quest.65C250000000000B.title: "Les trois routes réunies"
	quest.65C250000000000B.quest_subtitle: "Les trois trophÃ©es ouvrent les Highlands"
	quest.65C250000000000B.quest_desc: [
		"Trois puissances sont tombées dans trois régions différentes. La forêt reconnaît enfin que tu peux franchir les hauteurs qu'elle gardait sous une pluie corrosive."
		""
		"Hydre, Ur-Ghast et Reine des neiges sont vaincus. L'advancement natif commun confirme que la pluie acide des Twilight Highlands est levée."
		""
		"Si un joueur subit encore la protection, il lui manque au moins un advancement individuel malgré la progression commune des quêtes FTB."
	]
	quest.65C2500000000029.title: "Dans la grotte des Trolls"
	quest.65C2500000000029.quest_subtitle: "Les Obsidian Vaults cachent le prochain outil"
	quest.65C2500000000029.quest_desc: [
		"Les Highlands semblent mener vers le ciel, mais leur secret commence sous terre. Les Trolls gardent les graines d'un chemin oublié vers les nuages."
		""
		"Explore une Troll Cave sous les Highlands et élimine au moins un Cave Troll dans la structure."
		""
		"Cherche ensuite les grandes cavités, les coffres et les zones d'obsidienne. Les prochaines ressources se trouvent dans ce réseau souterrain."
	]
	quest.65C250000000002A.title: "Les Magic Beans"
	quest.65C250000000002A.quest_subtitle: "Les trolls et leurs coffres gardent les graines"
	quest.65C250000000002A.quest_desc: [
		"Récupère des Magic Beans sur les Trolls ou dans les coffres des Troll Caves. Ne les plante pas sur un bloc ordinaire : elles exigent de l'Uberous Soil."
	]
	quest.65C250000000002B.title: "L'Uberous Soil"
	quest.65C250000000002B.quest_subtitle: "Le sol fertile nÃ©cessaire Ã  leur croissance"
	quest.65C250000000002B.quest_desc: [
		"Trouve un bloc d'Uberous Soil dans les Troll Caves. Il sert de sol à la tige magique permettant d'atteindre les nuages."
		""
		"Place-le dans un espace ouvert vers le ciel avant d'utiliser les Magic Beans."
	]
	quest.65C250000000002C.title: "Faire pousser la tige géante"
	quest.65C250000000002C.quest_subtitle: "Une plante relie les Highlands aux nuages"
	quest.65C250000000002C.quest_desc: [
		"Dans la Twilight Forest, certaines légendes sont aussi des instructions. Une poignée de haricots et une terre prodigue suffisent à construire un escalier vivant."
		""
		"Utilise les Magic Beans directement sur l'Uberous Soil. Une immense tige pousse jusqu'aux Giant Clouds."
		""
		"Monte prudemment et prévois une solution contre les chutes."
	]
	quest.65C250000000002D.title: "Le Giant Miner"
	quest.65C250000000002D.quest_subtitle: "Le double gÃ©ant d'un mineur imprudent"
	quest.65C250000000002D.quest_desc: [
		"Au-dessus des nuages vivent des reflets démesurés du monde inférieur. L'un d'eux porte un outil conçu pour une pierre qu'aucun mineur ordinaire ne peut entamer."
		""
		"Dans la maison sur les nuages, affronte un Giant Miner. Les géants ressemblent à des versions immenses de joueurs et disposent d'une grande portée."
		""
		"Le Giant Miner fournit l'outil nécessaire pour ouvrir le coffre-fort final des Troll Caves."
	]
	quest.65C250000000002E.title: "La Giant Pickaxe"
	quest.65C250000000002E.quest_subtitle: "Un outil immense brise l'Obsidian Vault"
	quest.65C250000000002E.quest_desc: [
		"Ramasse la Giant Pickaxe, puis redescends dans les Troll Caves. Une pioche normale ne permet pas d'ouvrir correctement la grande chambre de Giant Obsidian."
	]
	quest.65C250000000002F.title: "La Lamp of Cinders"
	quest.65C250000000002F.quest_subtitle: "RÃ©duire les Giant Obsidian Blocks en cendres"
	quest.65C250000000002F.quest_desc: [
		"La chambre d'obsidienne protège une flamme ancienne. Elle ne consume pas le bois ni la pierre : elle réduit en cendres les ronces qui barrent la fin du voyage."
		""
		"Utilise la Giant Pickaxe sur le coffre-fort de Giant Obsidian et récupère la Lamp of Cinders."
		""
		"Cette lampe est l'objet final de la progression native fonctionnelle : elle brûle les épais Thorns qui encerclent le Final Plateau."
	]
	quest.65C2500000000030.title: "Atteindre le Final Plateau"
	quest.65C2500000000030.quest_subtitle: "Le dernier plateau devient accessible"
	quest.65C2500000000030.quest_desc: [
		"Au-delà des ronces se trouve un château promis depuis le début du voyage. La forêt permet d'en atteindre les murs, même si son histoire officielle reste inachevée."
		""
		"Va vers les Thornlands, équipe la Lamp of Cinders et utilise-la sur les blocs de Thorns pour ouvrir un passage."
		""
		"Atteins ensuite le biome Final Plateau et le Final Castle. L'advancement natif valide la fin de la progression Twilight Forest standard."
	]
	quest.65C250000000000C.title: "Le Castle Keeper"
	quest.65C250000000000C.quest_subtitle: "Un gardien ajoutÃ© Ã  l'Ã©pilogue du pack"
	quest.65C250000000000C.quest_desc: [
		"Twilight Forest laisse normalement le Final Castle sans boss terminé. Ascendant ajoute le Castle Keeper pour offrir un véritable combat d'épilogue."
		""
		"Cette quête reste facultative : l'extension a été conçue pour Twilight Forest 4.7 alors qu'Ascendant utilise la série 4.8. Le serveur démarre avec elle, mais le combat doit encore être validé en situation réelle."
	]
	quest.65C250000000000D.title: "Ressusciter un boss"
	quest.65C250000000000D.quest_subtitle: "RÃ©affronter un boss sans recrÃ©er sa structure"
	quest.65C250000000000D.quest_desc: [
		"Twilight Forest Bosses Resurrection crée automatiquement un piédestal sous le coffre de victoire de la Naga, du Lich, de l'Hydre, de l'Ur-Ghast ou de la Snow Queen."
		""
		"Interagis avec le piédestal : il indique les blocs à placer autour et l'objet à déposer au sommet. La validation est manuelle car le piédestal n'entre pas dans ton inventaire."
	]
	quest.65C250000000000E.title: "Fin du premier chapitre"
	quest.65C250000000000E.quest_subtitle: "La premiÃ¨re campagne ouvre Eternal Starlight"
	quest.65C250000000000E.quest_desc: [
		"La forêt ne livre pas tous ses mystères, mais elle ne te considère plus comme un intrus. Le premier récit d'Ascendant peut maintenant se refermer."
		""
		"Tu as atteint le Final Plateau et obtenu la Lamp of Cinders. La campagne Twilight Forest principale est terminée, même si tu peux encore explorer ses structures facultatives et affronter le Castle Keeper."
		""
		"Eternal Starlight constitue le prochain palier aventure d'Ascendant."
	]

	quest.65C2600000000001.title: "Les ruines du portail"
	quest.65C2600000000001.quest_subtitle: "Une lumière étrangère affleure dans l'Overworld"
	quest.65C2600000000001.quest_desc: [
		"Les Starlight Flowers apparaissent près des Portal Ruins d'Eternal Starlight. Leur présence indique qu'un ancien passage n'est probablement pas loin."
		""
		"Explore l'Overworld jusqu'à trouver ces ruines, puis examine-les avant de toucher au portail. Le Gatekeeper qui les garde est le véritable point d'entrée de cette campagne."
		""
		"Marque les coordonnées et prépare une voie de retour : les Waystones restent interdites dans les dimensions d'aventure."
	]
	quest.65C2700000000002.title: "Netherite Monstrosity"
	quest.65C2700000000002.quest_subtitle: "L'Eye of Monstrous mène à la Soul Black Smith"
	quest.65C2700000000002.quest_desc: [
		"Fabrique l'Eye of Monstrous et suis-le dans le Nether jusqu'à la Soul Black Smith. Le donjon contient les ressources et le chemin qui conduisent à la Netherite Monstrosity."
		""
		"Le colosse se soigne au contact de la lave et transforme l'arène en zone de siège. Coupez les accès à la lave lorsque c'est possible, gardez une sortie et ne restez pas regroupés devant lui."
		""
		"Le Monstrous Horn obtenu après la victoire servira de preuve pour clore l'Acte I."
	]
	quest.012A03FB9A524D1D.title: "Dissoudre le minerai"
	quest.012A03FB9A524D1D.quest_subtitle: "Le Sulfuric Acid libère cinq unités de slurry"
	quest.012A03FB9A524D1D.quest_desc: [
		"La Chemical Dissolution Chamber combine un minerai avec du Sulfuric Acid et produit une Dirty Slurry, généralement cinq unités par minerai."
		""
		"Configure l'entrée d'acide, la sortie chimique et un tank tampon avant le premier cycle. La machine appartient aussi à certaines chaînes chimiques avancées : filtre les entrées automatisées."
		""
		"La Dirty Slurry ne peut pas être cuite ; elle doit d'abord être lavée."
	]
	quest.015362D46481A343.title: "Énergie sans câble"
	quest.015362D46481A343.quest_subtitle: "Relier un Basic Wireless Energy Crystal"
	quest.015362D46481A343.quest_desc: [
		"Place un Basic Wireless Energy Crystal, puis utilise le Crystal Binder pour le relier à la source et à une machine cible compatible."
		""
		"Vérifie dans l'interface le mode entrée ou sortie et le débit réel. Si rien ne circule, contrôle les liaisons, la portée et la face énergétique de la machine."
		""
		"Valide lorsque l'appareil fonctionne sans câble direct entre les deux points."
	]
	quest.015FD53ADB7EE0E7.title: "Refermer la chaîne"
	quest.015FD53ADB7EE0E7.quest_subtitle: "Cuire automatiquement la poussière enrichie"
	quest.015FD53ADB7EE0E7.quest_desc: [
		"L'Energized Smelter remplace le four dans la chaîne Mekanism. Relie la sortie de l'Enrichment Chamber à son entrée puis le Smelter au stockage."
		""
		"Configure les faces avec le bouton Side Config et active Auto-Eject sur les sorties voulues. Fais passer un minerai du début jusqu'aux deux lingots."
		""
		"Valide seulement lorsque le trajet fonctionne sans déplacement manuel entre les machines."
	]
	quest.016D0F3C11F3BA0A.title: "Composer les gaz"
	quest.016D0F3C11F3BA0A.quest_subtitle: "Le Chemical Infuser combine deux substances"
	quest.016D0F3C11F3BA0A.quest_desc: [
		"Le Chemical Infuser reçoit un produit chimique sur chaque entrée et crée une troisième substance. L'Hydrogen Chloride du traitement x4 en est un usage central."
		""
		"Produis les gaz exacts indiqués par JEI, stocke-les séparément puis relie-les aux deux côtés configurés. Une entrée inversée suffit à bloquer la machine."
		""
		"Place un Chemical Tank sur la sortie avant de lancer une production continue."
	]
	quest.046D0EFECA44A57C.title: "Préparer le réseau cristallin"
	quest.046D0EFECA44A57C.quest_subtitle: "Le Crystal Binder configure les liaisons d'énergie"
	quest.046D0EFECA44A57C.quest_desc: [
		"Le Crystal Binder associe les Energy Crystals entre eux et avec les blocs compatibles. Il permet de construire un réseau sans câble visible."
		""
		"Sélectionne une extrémité puis la seconde et lis le message de confirmation. Une liaison a une portée et un nombre de connexions limités selon le palier du cristal."
		""
		"Teste sur une source et un stockage proches avant de traverser toute la base."
	]
	quest.07685264F621EFBA.title: "Un châssis commun"
	quest.07685264F621EFBA.quest_subtitle: "Le Steel Casing structure les machines avancées"
	quest.07685264F621EFBA.quest_desc: [
		"Le Steel Casing est le cœur de nombreuses machines Mekanism et de certains multiblocs. Sa recette combine les premières productions d'acier, de verre et d'Osmium."
		""
		"Fabrique un exemplaire pour la prochaine machine et garde la chaîne reproductible. Plusieurs paliers utilisent ce même châssis plutôt qu'un nouveau matériau arbitraire."
		""
		"Il mène directement au transport d'énergie et au traitement des minerais."
	]
	quest.088DBE8BB7E62CD8.title: "Les premiers injecteurs"
	quest.088DBE8BB7E62CD8.quest_subtitle: "Quatre points d'alimentation autour du cœur"
	quest.088DBE8BB7E62CD8.quest_desc: [
		"Place au moins quatre Basic Crafting Injectors autour du Fusion Crafting Core, tous orientés vers lui et suffisamment proches."
		""
		"Chaque injecteur reçoit un ingrédient et doit pouvoir accumuler l'énergie demandée. Une même source peut les alimenter, mais le débit total doit couvrir la recette."
		""
		"Vérifie que le multibloc reconnaît chaque injecteur avant d'engager un composant rare."
	]
	quest.09C95101EB082CC5.title: "Préparer l'allumage"
	quest.09C95101EB082CC5.quest_subtitle: "Mélanger le D-T Fuel et remplir le Hohlraum"
	quest.09C95101EB082CC5.quest_desc: [
		"Combine Deuterium et Tritium dans un Chemical Infuser pour produire du D-T Fuel. Stocke une réserve avant la tentative d'allumage."
		""
		"Remplis ensuite le Hohlraum avec ce combustible au moyen de l'appareil indiqué par JEI. L'infobulle doit confirmer qu'il contient la quantité nécessaire."
		""
		"Ne place le Hohlraum dans le réacteur qu'une fois les Lasers chargés et la structure entièrement formée."
	]
	quest.0A75CEDF0D193C19.title: "Au cœur du météore"
	quest.0A75CEDF0D193C19.quest_subtitle: "La Sky Stone protège un coffre technologique"
	quest.0A75CEDF0D193C19.quest_desc: [
		"Atteins le cœur du météore et ouvre son coffre. Récupère de la Sky Stone pour les futures constructions, mais cherche surtout les presses qu'il renferme."
		""
		"Un seul météore ne garantit pas toutes les presses. Réutilise la boussole dans une autre région si la collection reste incomplète."
		""
		"Valide la case après avoir réellement fouillé le centre, pas seulement miné la coque."
	]
	quest.0AA394B0855D7D6A.title: "Les quatre alliages"
	quest.0AA394B0855D7D6A.quest_subtitle: "Chaque famille ouvre une fonction différente"
	quest.0AA394B0855D7D6A.quest_desc: [
		"Produis Redstone Alloy, Conductive Alloy, Energetic Alloy et Pulsating Alloy dans l'Alloy Smelter. Ils servent respectivement aux conduits, à l'énergie et aux machines plus avancées."
		""
		"Consulte JEI avant de lancer un gros lot : certains alliages partagent des ingrédients mais ne répondent pas au même besoin."
		""
		"Utilise les premiers exemplaires pour construire génération, stockage et conduits plutôt que pour remplir un coffre."
	]
	quest.0C6A1A51921E8A6D.title: "La cascade du soufre"
	quest.0C6A1A51921E8A6D.quest_subtitle: "Préparer le Sulfuric Acid du traitement x5"
	quest.0C6A1A51921E8A6D.quest_desc: [
		"Le Chemical Oxidizer transforme notamment le Sulfur en Sulfur Dioxide. Avec Oxygen puis Water Vapor dans les machines indiquées par JEI, la chaîne mène au Sulfuric Acid."
		""
		"Construis chaque étape avec un tank tampon et un réseau de tubes distinct. Le Rotary Condensentrator peut fournir la forme chimique de l'eau nécessaire."
		""
		"Ne branche l'acide à la Dissolution Chamber qu'après avoir vérifié toute la cascade."
	]
	quest.0C89883108562837.title: "Un cœur énergétique draconique"
	quest.0C89883108562837.quest_subtitle: "Construire un stockage multibloc autour d'un noyau"
	quest.0C89883108562837.quest_desc: [
		"Le Draconic Energy Core forme le centre d'un grand stockage sphérique. Son palier détermine la structure de blocs requise, la capacité et le coût d'activation."
		""
		"Place les Energy Core Stabilizers selon le guide, projette ou construis la structure du palier choisi, puis active le cœur. Commence bas avant d'investir dans une sphère maximale."
		""
		"Relie entrée et sortie avec des cristaux séparés pour mesurer clairement les flux."
	]
	quest.0CB0DDB6109D87E5.title: "Éveiller le draconium"
	quest.0CB0DDB6109D87E5.quest_subtitle: "Le Dragon Heart libère un palier supérieur"
	quest.0CB0DDB6109D87E5.quest_desc: [
		"Utilise la recette de Fusion Crafting indiquée par JEI pour transformer le Draconium avec un Dragon Heart et les ingrédients associés."
		""
		"Répartis correctement les quantités sur les injecteurs et confirme que le stockage peut soutenir toute la charge. N'interromps pas l'alimentation pendant le cycle."
		""
		"Les Awakened Draconium Ingots ouvrent l'Awakened Core et les injecteurs avancés."
	]
	quest.0DE61CF1BECCEE50.title: "Armure draconique"
	quest.0DE61CF1BECCEE50.quest_subtitle: "Un châssis d'endgame à configurer avec discipline"
	quest.0DE61CF1BECCEE50.quest_desc: [
		"La Draconic Chestpiece offre une grille de modules plus vaste que le palier Wyvern. Sa puissance dépend toujours des modules installés et de l'énergie réellement disponible."
		""
		"Configure bouclier, capacité et mobilité, puis teste la décharge complète dans un environnement contrôlé. Aucun équipement énergétique ne doit être considéré invulnérable une fois sa réserve vide."
		""
		"Cette étape clôt le parcours guidé ; les spécialisations restantes dépendent du rôle choisi."
	]
	quest.129271E7D3BBCCA1.title: "Le soleil en bouteille"
	quest.129271E7D3BBCCA1.quest_subtitle: "Former puis allumer le Fusion Reactor"
	quest.129271E7D3BBCCA1.quest_desc: [
		"Construis le Fusion Reactor avec Frames, Ports, Controller et Laser Focus Matrix selon le schéma du guide. Relie les entrées Deuterium et Tritium avant toute tentative."
		""
		"Place le Hohlraum rempli dans le Controller, accumule l'énergie demandée dans un faisceau de Lasers puis tire à travers la Focus Matrix. L'interface indique si le seuil d'allumage est atteint."
		""
		"Après démarrage, augmente l'injection progressivement et surveille les deux combustibles."
	]
	quest.15CDCF8E2C8675A1.title: "Le composant fondamental"
	quest.15CDCF8E2C8675A1.quest_subtitle: "Le Draconium Core ouvre les premières machines"
	quest.15CDCF8E2C8675A1.quest_desc: [
		"Le Draconium Core concentre le matériau raffiné dans un composant utilisé par la génération, le transfert d'énergie et le premier palier d'équipement."
		""
		"Fabrique-le lorsque tu peux alimenter les machines qu'il débloque. Vérifie les coûts suivants dans JEI avant d'engager tout ton Draconium."
		""
		"Le prochain objectif est une source d'OP de secours et un moyen de charger les objets."
	]
	quest.15CF9FA6303B7879.title: "Première énergie"
	quest.15CF9FA6303B7879.quest_subtitle: "Produire localement et absorber les variations"
	quest.15CF9FA6303B7879.quest_desc: [
		"Le Stirling Generator transforme les combustibles solides en FE. Le Basic Capacitor Bank stocke cette production et fournit un débit plus stable aux machines."
		""
		"Relie le générateur à la banque, puis la banque à l'Alloy Smelter. Vérifie que le stockage monte lorsque les machines sont arrêtées et descend sous charge."
		""
		"Ce montage convient au départ ; il ne remplace pas une centrale pour l'industrie avancée."
	]
	quest.1883146755F1363C.title: "Les quatre matrices"
	quest.1883146755F1363C.quest_subtitle: "Silicium, logique, calcul et ingénierie"
	quest.1883146755F1363C.quest_desc: [
		"Réunis les quatre Inscriber Presses : Silicon, Logic, Calculation et Engineering. Chacune imprime une famille de composant différente."
		""
		"Les presses ne sont pas consommées. Conserve-les dans l'atelier et prépare plusieurs Inscribers lorsque le réseau demandera beaucoup de processeurs."
		""
		"Cette collection est un vrai verrou d'AE2 ; elle rend maintenant possible une production maîtrisée."
	]
	quest.189CA1F11EE19DFF.title: "Broyage et doublage"
	quest.189CA1F11EE19DFF.quest_subtitle: "Le SAG Mill valorise les produits secondaires"
	quest.189CA1F11EE19DFF.quest_desc: [
		"Le SAG Mill broie minerais et matériaux, avec des sorties secondaires dépendant de la recette. Une Grinding Ball modifie rendement, bonus et durée d'utilisation."
		""
		"Installe une Dark Steel Grinding Ball puis compare une recette avec et sans elle dans JEI. Les bonus ne sont pas identiques pour tous les matériaux."
		""
		"Configure la sortie avant d'automatiser pour éviter que les sous-produits bloquent la machine."
	]
	quest.1930489D5DEDD867.title: "Assembler automatiquement"
	quest.1930489D5DEDD867.quest_subtitle: "Le Molecular Assembler exécute les recettes de grille"
	quest.1930489D5DEDD867.quest_desc: [
		"Le Molecular Assembler fabrique les Crafting Patterns fournis par un Pattern Provider adjacent. Il doit être alimenté par le réseau et disposer d'un canal selon le montage."
		""
		"Place un pattern simple dans le Provider puis vérifie que l'Assembler peut produire l'objet demandé. Des Acceleration Cards augmenteront plus tard sa vitesse."
		""
		"Il manque encore un CPU de fabrication pour planifier et suivre la commande."
	]
	quest.19E96CC9EFC279A8.title: "Acier Sombre"
	quest.19E96CC9EFC279A8.quest_subtitle: "Le matériau des machines liées aux créatures"
	quest.19E96CC9EFC279A8.quest_desc: [
		"Le Dark Steel est un alliage avancé fabriqué dans l'Alloy Smelter. Il ouvre notamment les composants de capture, certaines machines et les Grinding Balls utilisées par le SAG Mill."
		""
		"Produis la quantité demandée pour la prochaine construction, puis conserve la recette dans l'autocraft si le réseau AE2 est disponible."
		""
		"La prochaine branche emploie ce palier pour manipuler les âmes des créatures."
	]
	quest.1B098C291E57F637.title: "Extraire l'eau lourde"
	quest.1B098C291E57F637.quest_subtitle: "Une Electric Pump équipée prépare le Deuterium"
	quest.1B098C291E57F637.quest_desc: [
		"Place une Electric Pump au-dessus d'une source d'eau et installe le Filter Upgrade demandé. La pompe produit alors de la Heavy Water au lieu d'eau ordinaire."
		""
		"Fournis assez d'énergie et transfère le fluide vers un réservoir distinct. Le débit de Heavy Water limitera directement la production de Deuterium."
		""
		"Teste le fluide obtenu avant de connecter l'Electrolytic Separator."
	]
	quest.1B3CFE52B5F5BE24.title: "L'énergie de l'éthylène"
	quest.1B3CFE52B5F5BE24.quest_subtitle: "Transformer une ferme en production FE"
	quest.1B3CFE52B5F5BE24.quest_desc: [
		"Le Gas-Burning Generator consomme l'Ethylene produite par la PRC et fournit une forte production de FE tant que toute la chaîne reste alimentée."
		""
		"Relie un Chemical Tank tampon entre production et générateur, puis branche un Energy Cube en sortie. Surveille Bio Fuel, Hydrogen, eau et sous-produit pendant plusieurs minutes."
		""
		"Valide lorsque le système fonctionne en continu sans vider une entrée cachée."
	]
	quest.1BF8ED2E2BF98FBA.title: "Produire les premiers OP"
	quest.1BF8ED2E2BF98FBA.quest_subtitle: "Une alimentation locale pour tester le mod"
	quest.1BF8ED2E2BF98FBA.quest_desc: [
		"Le Draconium Generator brûle des combustibles solides pour produire des OP, l'unité d'énergie de Draconic Evolution compatible avec le réseau du pack."
		""
		"Branche-le à un stockage et observe son rendement avec un combustible ordinaire. Il convient aux premiers essais, pas à la fusion avancée qui demande de fortes pointes de puissance."
		""
		"Valide après avoir réellement extrait l'énergie produite."
	]
	quest.1CB76247E0D9CC91.title: "Le Drive ME"
	quest.1CB76247E0D9CC91.quest_subtitle: "Dix cellules derrière une seule façade réseau"
	quest.1CB76247E0D9CC91.quest_desc: [
		"Le ME Drive accueille jusqu'à dix cellules et expose leur contenu au réseau. Chaque Drive connecté utilise un canal."
		""
		"Place la cellule 1k dans un emplacement, relie le Drive au câble alimenté et vérifie ses voyants. Garde quelques emplacements libres pour les futures cellules spécialisées."
		""
		"Il reste à construire l'interface depuis laquelle les joueurs consulteront ce stockage."
	]
	quest.1CE3DD64D895C05C.title: "La boussole du météore"
	quest.1CE3DD64D895C05C.quest_subtitle: "Retrouver les matrices tombées du ciel"
	quest.1CE3DD64D895C05C.quest_desc: [
		"La Meteorite Compass pointe vers le météore AE2 le plus proche. Suis son aiguille ; lorsqu'elle tourne sans direction stable, le centre se trouve sous ou près de toi."
		""
		"Les météores peuvent être enterrés. Creuse prudemment autour de la Sky Stone plutôt que droit sous tes pieds."
		""
		"Le coffre central contient les presses nécessaires à la fabrication des processeurs."
	]
	quest.1CE5A98AF78D3314.title: "Acier de l'End"
	quest.1CE5A98AF78D3314.quest_subtitle: "Une agriculture automatisée de haut palier"
	quest.1CE5A98AF78D3314.quest_desc: [
		"L'End Steel est l'alliage tardif nécessaire à la Farming Station. Cette machine travaille une zone agricole avec les outils, graines et réglages fournis."
		""
		"Prépare une parcelle simple, une sortie d'inventaire et des outils remplaçables. Vérifie qu'elle récolte puis replante la culture choisie sans mélanger des graines non prévues."
		""
		"Compare cette solution à Industrial Foregoing : garde celle qui s'intègre le mieux à ta logistique."
	]
	quest.1D062F1021853413.title: "Le Four à Alliage"
	quest.1D062F1021853413.quest_subtitle: "Cuire ou combiner jusqu'à trois ingrédients"
	quest.1D062F1021853413.quest_desc: [
		"L'Alloy Smelter fabrique les alliages propres à Ender IO et peut aussi fonctionner comme four. Son mode détermine s'il accepte les recettes de cuisson, d'alliage ou les deux."
		""
		"Branche l'énergie, règle les faces puis réalise un premier alliage affiché par JEI. Les trois entrées doivent contenir les quantités exactes avant le démarrage."
		""
		"Évite le mode automatique tant que la machine partage ses inventaires avec d'autres fours."
	]
	quest.1E5C182D97AE58E4.title: "Extraire l'Uraninite"
	quest.1E5C182D97AE58E4.quest_subtitle: "Le combustible et catalyseur propre à Powah"
	quest.1E5C182D97AE58E4.quest_desc: [
		"L'Uraninite Ore apparaît dans l'Overworld aux profondeurs indiquées par le guide Powah et JEI. Son produit brut alimente les réacteurs et plusieurs recettes énergisées."
		""
		"Traite la première réserve avec la chaîne de minerais déjà disponible. Garde une partie pour les recettes de composants plutôt que de tout consommer comme combustible."
		""
		"Cette ressource conserve une quête car elle ouvre et entretient toute la branche Powah."
	]
	quest.1EB8D2AD0175E1C9.title: "Préparer le combustible fissile"
	quest.1EB8D2AD0175E1C9.quest_subtitle: "Enrichir l'uranium par une chaîne chimique complète"
	quest.1EB8D2AD0175E1C9.quest_desc: [
		"Le Fissile Fuel provient d'une chaîne d'uranium transformé en Uranium Hexafluoride puis traité dans l'Isotopic Centrifuge."
		""
		"Suis JEI depuis le Yellow Cake Uranium et prépare séparément Uranium Oxide, Hydrofluoric Acid et Uranium Hexafluoride. Chaque intermédiaire doit disposer d'un tank identifié."
		""
		"Ne produis du Fissile Fuel qu'après avoir prévu le refroidissement et le stockage des déchets du réacteur."
	]
	quest.1F01000000000001.quest_desc: [
		"Le manuel décrit les machines, leurs zones de travail et leurs fluides."
		""
		"Garde-le près de l'atelier : Industrial Foregoing repose sur plusieurs chaînes qui se croisent."
	]
	quest.1F01000000000001.quest_subtitle: "Niveau 1 / 5"
	quest.1F01000000000001.title: "Le manuel industriel"
	quest.1F01000000000002.title: "Un premier châssis"
	quest.1F01000000000002.quest_subtitle: "La base commune des machines simples"
	quest.1F01000000000002.quest_desc: [
		"Le Pity Machine Frame est le châssis des premières machines Industrial Foregoing. Il ne produit rien seul, mais ouvre la chaîne du latex."
		""
		"Fabrique-en un pour le Fluid Extractor, puis consulte JEI avant d'en produire davantage : les paliers suivants utilisent des recettes et fluides différents."
		""
		"La progression réelle commence avec une machine placée contre un tronc."
	]
	quest.1F01000000000003.title: "Faire pleurer le bois"
	quest.1F01000000000003.quest_subtitle: "Extraire le latex directement d'un tronc"
	quest.1F01000000000003.quest_desc: [
		"Place la face de travail du Fluid Extractor contre un log. Il produit lentement du Latex et dégrade progressivement le bloc de bois ciblé."
		""
		"Plusieurs extracteurs peuvent entourer un même tronc. L'énergie est facultative, mais elle accélère le cycle ; prévois une sortie fluide avant que le réservoir interne soit plein."
		""
		"Valide après avoir observé du Latex apparaître dans la machine."
	]
	quest.1F01000000000004.title: "Un seau de latex"
	quest.1F01000000000004.quest_subtitle: "Stocker la première production sans bloquer l'extracteur"
	quest.1F01000000000004.quest_desc: [
		"Récupère un seau de Latex ou transfère le fluide vers un réservoir. La Latex Processing Unit en consommera 750 mB par Dry Rubber dans cette version."
		""
		"Une conduite ou un réservoir tampon évite les arrêts lorsque les extracteurs travaillent en continu. Garde une entrée séparée pour l'eau de la machine suivante."
		""
		"Le Latex brut doit maintenant être traité, pas accumulé."
	]
	quest.1F01000000000005.title: "Traiter le latex"
	quest.1F01000000000005.quest_subtitle: "Combiner Latex, eau et énergie"
	quest.1F01000000000005.quest_desc: [
		"La Latex Processing Unit consomme 750 mB de Latex, 500 mB d'eau et de la FE pour produire un Dry Rubber."
		""
		"Branche les deux fluides sur des faces distinctes, configure la sortie d'objet et laisse assez d'espace dans le stockage. L'interface indique immédiatement quelle entrée manque."
		""
		"Valide après un cycle complet réalisé par la machine."
	]
	quest.1F01000000000006.quest_desc: [
		"Produis neuf petits morceaux de caoutchouc sec."
		""
		"Cette quantité permet de les compacter en une unité plus pratique pour les recettes suivantes."
	]
	quest.1F01000000000006.quest_subtitle: "Niveau 1 / 5"
	quest.1F01000000000006.title: "Premier caoutchouc sec"
	quest.1F01000000000007.title: "Compacter le caoutchouc"
	quest.1F01000000000007.quest_subtitle: "Préparer l'intermédiaire qui deviendra plastique"
	quest.1F01000000000007.quest_desc: [
		"Le Dry Rubber obtenu par la machine se compacte selon la recette JEI en un matériau prêt à être cuit."
		""
		"Cette étape relie volontairement le fluide à son premier usage. Automatise seulement lorsque les extracteurs et l'eau fournissent un débit régulier."
		""
		"Passe ensuite ce matériau au four pour obtenir le Plastic."
	]
	quest.1F01000000000008.title: "L'âge du plastique"
	quest.1F01000000000008.quest_subtitle: "Le composant transversal des machines du mod"
	quest.1F01000000000008.quest_desc: [
		"La cuisson du Dry Rubber produit le Plastic utilisé dans presque toutes les machines Industrial Foregoing de palier supérieur."
		""
		"Fabrique les huit unités demandées puis réserve-les à la Dissolution Chamber et aux premiers systèmes automatiques. Une chaîne continue deviendra vite nécessaire."
		""
		"Le plastique reste un verrou de progression, pas une quête de collecte ordinaire."
	]
	quest.1F01000000000009.title: "Recettes sous pression"
	quest.1F01000000000009.quest_subtitle: "Huit objets et un fluide dans la Dissolution Chamber"
	quest.1F01000000000009.quest_desc: [
		"La Dissolution Chamber exécute des recettes avec jusqu'à huit ingrédients et un fluide. Les objets sont généralement sans ordre, mais les quantités et le fluide doivent correspondre exactement."
		""
		"Configure les faces d'entrée et de sortie avant l'automatisation. Un fluide résiduel peut empêcher la recette suivante : sépare les chaînes incompatibles ou vide le réservoir."
		""
		"Cette machine fabrique les châssis et matériaux des paliers avancés."
	]
	quest.1F0100000000000A.title: "Un cadre plus solide"
	quest.1F0100000000000A.quest_subtitle: "Le Simple Machine Frame ouvre l'automatisation agricole"
	quest.1F0100000000000A.quest_desc: [
		"Fabrique le Simple Machine Frame dans la Dissolution Chamber avec les objets et le fluide indiqués par JEI."
		""
		"Le châssis est consommé par une machine utile ; décide ici de construire d'abord le Plant Sower plutôt que d'accumuler des cadres."
		""
		"La prochaine paire de machines doit former une ferme complète, alimentée et testée."
	]
	quest.1F0100000000000B.title: "Semer automatiquement"
	quest.1F0100000000000B.quest_subtitle: "Le Plant Sower distribue neuf familles de graines"
	quest.1F0100000000000B.quest_desc: [
		"Place le Plant Sower sous le centre de la parcelle. Son inventaire en neuf secteurs correspond aux zones de plantation au-dessus de lui."
		""
		"Fournis énergie et graines, règle la portée avec les addons si nécessaire puis observe au moins une plantation. Les blocs au-dessus doivent rester accessibles à sa zone de travail."
		""
		"Le Sower plante ; une autre machine doit récolter et évacuer les produits."
	]
	quest.1F0100000000000C.title: "Récolter et replanter"
	quest.1F0100000000000C.quest_subtitle: "Fermer la boucle avec le Plant Gatherer"
	quest.1F0100000000000C.quest_desc: [
		"Oriente le Plant Gatherer vers la parcelle du Sower et règle une zone couvrant les mêmes cultures. Il récolte les plantes mûres et génère aussi du Sludge."
		""
		"Relie la sortie d'objets à un inventaire et la sortie de Sludge à un réservoir séparé. Avec la paire Sower/Gatherer, la replantation doit rester autonome."
		""
		"Valide après plusieurs cycles sans intervention manuelle."
	]
	quest.1F0100000000000D.title: "Capturer une créature"
	quest.1F0100000000000D.quest_subtitle: "Transporter un type de mob dans un outil sécurisé"
	quest.1F0100000000000D.quest_desc: [
		"Utilise le Mob Imprisonment Tool vide sur une créature compatible. L'outil conserve l'entité pour les machines du mod sans exiger de la conduire physiquement jusqu'à la base."
		""
		"Choisis un mob ordinaire autorisé par le serveur et éloigne-toi des boss ou PNJ importants. Le contenu est affiché dans l'infobulle."
		""
		"La capture servira à configurer une production, pas à stocker indéfiniment une créature unique."
	]
	quest.1F0100000000000E.title: "Transformer les créatures"
	quest.1F0100000000000E.quest_subtitle: "La Mob Slaughter Factory produit des fluides, pas du butin"
	quest.1F0100000000000E.quest_desc: [
		"La Mob Slaughter Factory élimine les créatures dans sa zone et produit Liquid Meat et Pink Slime. Elle ne fournit ni butin ordinaire ni expérience."
		""
		"Construis une chambre fermée, règle la portée et sépare les deux sorties de fluides. Ajoute une coupure redstone accessible avant la première apparition."
		""
		"Valide seulement lorsque les fluides sont récupérés sans fuite ni accumulation de mobs."
	]
	quest.1F0100000000000F.title: "Exploiter la gelée rose"
	quest.1F0100000000000F.quest_subtitle: "Transformer le Pink Slime en matériau avancé"
	quest.1F0100000000000F.quest_desc: [
		"Le Pink Slime Fluid issu de la Slaughter Factory se transforme en Pink Slime Ingot par la chaîne affichée dans JEI."
		""
		"Garde le fluide dans un réservoir dédié et ne le mélange pas au Liquid Meat. Le lingot devient un composant de machines et de châssis avancés."
		""
		"Cette ressource a une quête parce que son origine n'est pas déductible d'une recette de craft classique."
	]
	quest.1F01000000000010.title: "Le châssis avancé"
	quest.1F01000000000010.quest_subtitle: "Accéder aux machines de mobs et de forage"
	quest.1F01000000000010.quest_desc: [
		"Fabrique l'Advanced Machine Frame dans la Dissolution Chamber. Il combine les ressources des chaînes de plastique et de Pink Slime."
		""
		"Vérifie le fluide présent dans la chambre avant d'insérer les huit composants. Automatise cette recette seulement si les deux productions amont sont déjà stables."
		""
		"Le premier usage recommandé est le Mob Crusher ou l'Ore Laser Base selon le besoin de la base."
	]
	quest.1F01000000000011.title: "Automatiser les butins"
	quest.1F01000000000011.quest_subtitle: "Le Mob Crusher simule une élimination avec récompenses"
	quest.1F01000000000011.quest_desc: [
		"Contrairement à la Slaughter Factory, le Mob Crusher récupère le butin des créatures et produit de l'Essence. Il convient aux fermes où les drops sont l'objectif."
		""
		"Ferme la zone, filtre les sorties et prévois assez de stockage pour les objets variés. Une coupure redstone et une limite d'apparition restent obligatoires pour la stabilité du serveur."
		""
		"Valide après un cycle complet sans entités accumulées."
	]
	quest.1F01000000000012.title: "La base du laser"
	quest.1F01000000000012.quest_subtitle: "Définir ce que le forage virtuel peut produire"
	quest.1F01000000000012.quest_desc: [
		"L'Ore Laser Base reçoit les résultats générés par les Laser Drills orientés vers elle. Les probabilités dépendent notamment de la dimension, du biome, de la hauteur et des Laser Lenses."
		""
		"Choisis son emplacement après avoir consulté JEI pour la ressource recherchée. Une base mal située peut fonctionner parfaitement tout en ne donnant jamais le minerai attendu."
		""
		"Prépare une sortie d'inventaire avant d'ajouter les drills."
	]
	quest.1F01000000000013.title: "Extraire sans creuser"
	quest.1F01000000000013.quest_subtitle: "Quatre Laser Drills alimentent une Ore Laser Base"
	quest.1F01000000000013.quest_desc: [
		"Place les quatre Laser Drills face à l'Ore Laser Base dans les positions reconnues par le guide. Chaque drill consomme sa propre énergie pour faire avancer le cycle commun."
		""
		"Ajoute une lens seulement si elle améliore la cible voulue dans ce biome et à cette profondeur. Mesure plusieurs cycles avant de conclure que la configuration est incorrecte."
		""
		"Valide lorsque les minerais arrivent automatiquement dans le stockage sans extraction manuelle."
	]
	quest.1F4E5AD0B1D0C9AB.title: "Produire le tritium"
	quest.1F4E5AD0B1D0C9AB.quest_subtitle: "Concentrer le Lithium puis l'exposer au soleil"
	quest.1F4E5AD0B1D0C9AB.quest_desc: [
		"Une seconde Thermal Evaporation Plant transforme la Brine en Liquid Lithium. Le Rotary Condensentrator convertit ce fluide en Lithium chimique."
		""
		"Un Solar Neutron Activator exposé au ciel transforme ensuite le Lithium en Tritium. Prévois un stockage assez grand pour traverser la nuit sans interrompre les essais."
		""
		"Garde Tritium et Polonium sur des réseaux séparés malgré leur machine solaire commune."
	]
	quest.1F8785366A69402C.title: "Prendre de la hauteur"
	quest.1F8785366A69402C.quest_subtitle: "Le Wind Generator récompense une installation élevée"
	quest.1F8785366A69402C.quest_desc: [
		"Le Wind Generator produit davantage lorsqu'il est placé plus haut dans le monde, jusqu'à la limite prévue par sa configuration."
		""
		"Installe-le sur une tour sûre, protège l'accès et descends l'énergie par câble vers un stockage. Compare sa production au sol puis en hauteur."
		""
		"Valide après avoir confirmé un débit stable, pas seulement posé le bloc."
	]
	quest.207BB1316748E335.title: "Quatre lingots par minerai"
	quest.207BB1316748E335.quest_subtitle: "Injecter l'Hydrogen Chloride avant la purification"
	quest.207BB1316748E335.quest_desc: [
		"La Chemical Injection Chamber traite le minerai avec de l'Hydrogen Chloride et produit des Shards, généralement quatre par unité."
		""
		"Envoie ensuite les Shards dans la Purification Chamber avec Oxygen, puis Crusher, Enrichment Chamber et Energized Smelter. Chaque étape doit disposer de son tampon chimique."
		""
		"Valide sur un cycle complet x4 plutôt qu'en déposant seulement la machine."
	]
	quest.218AA00C4231663D.title: "Cristal chargé"
	quest.218AA00C4231663D.quest_subtitle: "Une matière simple devient réactive"
	quest.218AA00C4231663D.quest_desc: [
		"Récupère un Charged Certus Quartz Crystal dans le Charger. L'objet se distingue du Certus ordinaire par son éclat et par les recettes auxquelles il participe."
		""
		"Sa première utilisation importante est la création du Fluix. Garde le cristal chargé avec une Nether Quartz et de la Redstone."
		""
		"La quête suivante montre le geste que la grille de craft ne peut pas expliquer."
	]
	quest.232A1355C8DFF987.title: "Le boîtier"
	quest.232A1355C8DFF987.quest_subtitle: "Former une enveloppe fermée et valide"
	quest.232A1355C8DFF987.quest_desc: [
		"Les Basic Reactor Casings composent les arêtes et les faces du multibloc. Le réacteur doit former un pavé fermé avec un volume intérieur valide."
		""
		"Prépare assez de blocs pour un modèle 3 x 3 x 3, puis remplace certains casings par Controller, ports et Control Rod. Le verre reste facultatif sur les faces autorisées."
		""
		"Construis l'enveloppe sans combustible et laisse une face accessible pour le diagnostic."
	]
	quest.242979E96A4BCAED.title: "Mesurer avant de manipuler"
	quest.242979E96A4BCAED.quest_subtitle: "Geiger Counter et Dosimeter rendent la radiation visible"
	quest.242979E96A4BCAED.quest_desc: [
		"Le Geiger Counter mesure la radiation ambiante d'une zone. Le Dosimeter suit la dose accumulée par le joueur."
		""
		"Garde les deux accessibles avant toute ouverture de ligne nucléaire et apprends leur affichage dans une zone propre. Une valeur anormale doit interrompre le travail immédiatement."
		""
		"Les outils détectent le danger ; ils ne protègent pas contre lui."
	]
	quest.259EF6BCCE6E21CF.title: "Intrication explosive"
	quest.259EF6BCCE6E21CF.quest_subtitle: "Créer une paire liée à partir d'une singularité"
	quest.259EF6BCCE6E21CF.quest_desc: [
		"Une Singularity devient une paire de Quantum Entangled Singularities lorsqu'elle explose avec la poussière d'Ender requise par JEI."
		""
		"Effectue cette opération dans une zone dégagée, loin des câbles et stockages. Une seule explosion produit les deux éléments appariés nécessaires aux ponts quantiques."
		""
		"Conserve la paire ensemble jusqu'à la construction des deux extrémités."
	]
	quest.25CBEE18498B3B6B.title: "Énergie sans fil"
	quest.25CBEE18498B3B6B.quest_subtitle: "Deux Ender Cells partagent un canal personnel"
	quest.25CBEE18498B3B6B.quest_desc: [
		"Les Ender Cells transfèrent l'énergie à travers un canal associé à leur propriétaire. Utilise la Binding Card pour configurer les deux cellules sur le même canal."
		""
		"Place une cellule près de la production et l'autre près de la consommation, puis règle leurs faces. Les canaux personnels évitent qu'un autre joueur détourne involontairement le réseau."
		""
		"Teste les deux sens avec une petite quantité avant d'y relier une centrale."
	]
	quest.262BDAD9FD5C2A88.title: "Produire le deutérium"
	quest.262BDAD9FD5C2A88.quest_subtitle: "Séparer l'eau lourde pour le premier combustible de fusion"
	quest.262BDAD9FD5C2A88.quest_desc: [
		"Envoie la Heavy Water dans un Electrolytic Separator configuré pour cette recette. Il produit le Deuterium nécessaire au D-T Fuel."
		""
		"Stocke le gaz dans un Chemical Tank de capacité suffisante et gère la seconde sortie afin qu'elle ne bloque pas la machine."
		""
		"La fusion consomme le Deuterium avec le Tritium dans des proportions indiquées par JEI."
	]
	quest.2639DA49D469215C.title: "Stocker les produits chimiques"
	quest.2639DA49D469215C.quest_subtitle: "Le Chemical Tank sécurise un gaz ou une substance"
	quest.2639DA49D469215C.quest_desc: [
		"Le Basic Chemical Tank stocke les produits chimiques de Mekanism : gaz, pigments, slurries ou infusions selon le contenu autorisé."
		""
		"Utilise un réservoir distinct par substance et nomme ou colore la ligne. Le mode seau et les boutons de vidage doivent être employés avec prudence sur les produits rares ou radioactifs."
		""
		"Teste avec de l'Oxygen ou de l'Hydrogen avant de manipuler la chimie avancée."
	]
	quest.265AED53B0F0E084.title: "L'enveloppe d'induction"
	quest.265AED53B0F0E084.quest_subtitle: "Construire un stockage d'énergie multibloc"
	quest.265AED53B0F0E084.quest_desc: [
		"Les Induction Casings forment l'enveloppe creuse de l'Induction Matrix. La structure doit contenir au moins une Induction Cell et un Induction Provider."
		""
		"Choisis une taille adaptée à la base, construis d'abord la coque puis garde l'intérieur accessible. Les ports remplaceront certains blocs de paroi."
		""
		"La Cell fixe la capacité ; le Provider fixe le débit maximal du stockage."
	]
	quest.282931CA0AEAE66D.title: "Cinq lingots par minerai"
	quest.282931CA0AEAE66D.quest_subtitle: "Cristalliser puis réutiliser la chaîne x4"
	quest.282931CA0AEAE66D.quest_desc: [
		"Le Chemical Crystallizer transforme la Clean Slurry en Crystals. Ceux-ci passent ensuite par Injection Chamber, Purification Chamber, Crusher, Enrichment Chamber et Smelter."
		""
		"Relie les sept étapes avec des tampons et teste un seul type de minerai. Mélanger plusieurs slurries sans filtres rend le diagnostic très difficile."
		""
		"Valide lorsque cinq lingots arrivent automatiquement pour un minerai compatible."
	]
	quest.29B3E50D188777B2.title: "Charger et équilibrer"
	quest.29B3E50D188777B2.quest_subtitle: "L'Energy Transfuser gère les objets énergétiques"
	quest.29B3E50D188777B2.quest_desc: [
		"L'Energy Transfuser transfère l'énergie vers ou depuis les objets compatibles selon le mode choisi dans son interface."
		""
		"Relie-le au stockage, place un outil ou une batterie dans la bonne fente et vérifie le sens du transfert. Les réglages d'équilibrage évitent de vider involontairement une pièce d'équipement."
		""
		"Ce poste deviendra utile pour les outils et armures modulaires."
	]
	quest.29EE94AF6B9DFD0C.title: "Recharge à distance"
	quest.29EE94AF6B9DFD0C.quest_subtitle: "Le Player Transmitter alimente l'inventaire lié"
	quest.29EE94AF6B9DFD0C.quest_desc: [
		"Le Basic Player Transmitter envoie de l'énergie aux objets compatibles d'un joueur lié, comme la Basic Battery, tant que le réseau fournit le débit."
		""
		"Associe le transmetteur avec la carte prévue par le guide puis définis les emplacements ou priorités de charge. Surveille la consommation : un équipement vide peut absorber toute une petite centrale."
		""
		"Teste avec la batterie avant d'autoriser une armure complète."
	]
	quest.2B2ABD19FA13B644.title: "Le Cœur éveillé"
	quest.2B2ABD19FA13B644.quest_subtitle: "Le composant des structures draconiques avancées"
	quest.2B2ABD19FA13B644.quest_desc: [
		"L'Awakened Core concentre le Draconium éveillé dans un composant destiné aux machines et équipements de haut palier."
		""
		"Fabrique-le avec un projet précis en tête : injecteurs, stockage énergétique ou équipement. Les Dragon Hearts restent le verrou le plus coûteux de cette branche."
		""
		"La prochaine étape améliore l'atelier de fusion lui-même."
	]
	quest.2C2CBD5A796C05B8.title: "Voir circuler les canaux"
	quest.2C2CBD5A796C05B8.quest_subtitle: "Diagnostiquer le réseau avant qu'il ne s'éteigne"
	quest.2C2CBD5A796C05B8.quest_desc: [
		"Les Smart Cables affichent par segments le nombre de canaux utilisés. Un câble normal en porte huit ; un Dense Smart Cable peut en transporter trente-deux."
		""
		"Place-les aux sorties du Controller et aux embranchements importants. Le visuel permet d'identifier une branche saturée sans démonter le réseau."
		""
		"Le câble dense distribue la capacité ; il ne se connecte pas directement à tous les appareils comme un câble normal."
	]
	quest.2D55D62ECE12B219.title: "Le Réacteur"
	quest.2D55D62ECE12B219.quest_subtitle: "Former trente-six blocs et équilibrer quatre consommables"
	quest.2D55D62ECE12B219.quest_desc: [
		"Place 36 Basic Reactor Blocks dans la forme 3 x 4 x 3 prévue par Powah ; ils fusionnent automatiquement en un seul réacteur."
		""
		"Son interface accepte Uraninite, un matériau carboné, Redstone et un coolant. Chaque entrée agit sur rendement, température ou production : remplis-les progressivement et lis les indicateurs."
		""
		"Valide après une production stable reliée à un stockage, pas à la simple formation du multibloc."
	]
	quest.2D64B87BCE839992.title: "Construire sans allumer"
	quest.2D64B87BCE839992.quest_subtitle: "Former et sécuriser le Fission Reactor avant le combustible"
	quest.2D64B87BCE839992.quest_desc: [
		"Le Fission Reactor mesure au minimum 3 x 4 x 3. Il exige Fuel Assembly sous Control Rod Assembly, plusieurs ports pour coolant, vapeur, Fissile Fuel et Nuclear Waste, ainsi qu'un Logic Adapter de sécurité."
		""
		"Construis la structure vide, connecte le refroidissement et une sortie vapeur capable d'absorber le débit. Configure un arrêt automatique sur température ou dommage critique."
		""
		"Commence ensuite au burn rate minimal. Ce réacteur produit de la vapeur, pas directement de la FE."
	]
	quest.2E6D337C5C4055ED.title: "Mémoriser une fréquence"
	quest.2E6D337C5C4055ED.quest_subtitle: "Copier la configuration d'un appareil AE2"
	quest.2E6D337C5C4055ED.quest_desc: [
		"La Memory Card enregistre les réglages d'un bloc compatible puis les applique à un autre. Elle est indispensable pour associer rapidement les deux extrémités d'un tunnel P2P."
		""
		"Enregistre d'abord l'entrée, puis applique la même fréquence aux sorties en suivant l'indication affichée à l'écran. Renomme ou range la carte lorsque le réseau devient complexe."
		""
		"Une fréquence incorrecte ressemble souvent à un tunnel sans destination."
	]
	quest.2EF71CC5FB2ED4A6.title: "Un outil modulaire"
	quest.2EF71CC5FB2ED4A6.quest_subtitle: "La Wyvern Pickaxe reçoit les fonctions choisies"
	quest.2EF71CC5FB2ED4A6.quest_desc: [
		"La Wyvern Pickaxe fournit une base d'outil dont les caractéristiques dépendent des modules installés : dégâts, vitesse, énergie, zone ou autres fonctions compatibles."
		""
		"Ouvre son interface de modules, installe seulement ceux répondant à un besoin réel et surveille le coût énergétique. Une grande zone de minage peut détruire davantage que prévu."
		""
		"Teste l'outil loin des constructions et des coffres avant de l'utiliser dans la base."
	]
	quest.2FEA8C6C88E8D9B0.title: "Transport sous pression"
	quest.2FEA8C6C88E8D9B0.quest_subtitle: "Les Pressurized Tubes déplacent les produits chimiques"
	quest.2FEA8C6C88E8D9B0.quest_desc: [
		"Les Basic Pressurized Tubes relient machines et Chemical Tanks. Leur capacité et leur débit dépendent du palier du tube."
		""
		"Règle les connexions avec le Configurator et vérifie que la machine source éjecte la bonne substance. Deux produits incompatibles ne doivent jamais partager un réseau déjà rempli."
		""
		"Construis des lignes séparées et clairement identifiables pour Oxygen, Hydrogen et acides."
	]
	quest.302D797870C7D8E5.title: "Les conduits"
	quest.302D797870C7D8E5.quest_subtitle: "Plusieurs réseaux peuvent partager un même bloc"
	quest.302D797870C7D8E5.quest_desc: [
		"Transforme le Conduit Binder Composite selon JEI puis fabrique les conduits nécessaires. Ender IO permet à plusieurs types de conduits d'occuper le même espace."
		""
		"Configure chaque face comme entrée, sortie ou désactivée, avec filtres et priorités si besoin. Le Conduit Probe aide à lire et modifier un réseau déjà dense."
		""
		"Teste énergie et objets séparément avant de superposer leurs lignes."
	]
	quest.3036B0D4BDB47166.title: "Naissance du Fluix"
	quest.3036B0D4BDB47166.quest_subtitle: "Trois ingrédients réagissent dans l'eau"
	quest.3036B0D4BDB47166.quest_desc: [
		"Jette ensemble dans une source d'eau un Charged Certus Quartz, une Nether Quartz et une Redstone Dust. La réaction produit deux Fluix Crystals."
		""
		"Utilise un bassin fermé afin que les objets ne partent pas dans un courant. La transformation est rapide et peut être automatisée plus tard."
		""
		"Le Fluix ouvre les câbles, l'alimentation et les premiers appareils du réseau ME."
	]
	quest.3165F665ED474B75.title: "Des alliages renforcés"
	quest.3165F665ED474B75.quest_subtitle: "L'Osmium Compressor ouvre les paliers supérieurs"
	quest.3165F665ED474B75.quest_desc: [
		"L'Osmium Compressor combine de l'Osmium sous forme chimique avec des matériaux pour produire les alliages renforcés demandés par les machines avancées."
		""
		"Fournis énergie, Osmium dans l'entrée dédiée et l'objet à comprimer. Configure la sortie avant de lancer une série coûteuse."
		""
		"Les alliages obtenus servent surtout à améliorer circuits, machines et capacités de transport."
	]
	quest.31FC18F89A0136D7.title: "Stocker et transporter"
	quest.31FC18F89A0136D7.quest_subtitle: "L'Energy Cell absorbe les écarts de production"
	quest.31FC18F89A0136D7.quest_desc: [
		"Le Basic Energy Cell stocke la FE produite par Powah. Les Basic Energy Cables la distribuent aux machines et autres systèmes compatibles."
		""
		"Configure les faces d'entrée et sortie avec l'outil du mod, puis charge la cellule avant de démarrer une machine. Vérifie le débit maximal si plusieurs appareils partagent la ligne."
		""
		"Une réserve stable évite que l'Energizing Orb s'arrête au milieu d'une recette."
	]
	quest.3209D67912C7A4FD.title: "Matériaux ultimes"
	quest.3209D67912C7A4FD.quest_subtitle: "Le retraitement et la turbine alimentent l'endgame"
	quest.3209D67912C7A4FD.quest_desc: [
		"Le Blutonium provient du retraitement du Cyanite. Le Ludicrite utilise des matériaux avancés et sert notamment aux coils les plus performants et à l'Energizer."
		""
		"Produis uniquement la quantité nécessaire à la structure prévue. Ces matériaux représentent de longues heures de combustible et ne doivent pas rester sans usage."
		""
		"La dernière étape les transforme en infrastructure de très haute énergie."
	]
	quest.320F0A73EAD890BC.title: "Le cœur du Dragon"
	quest.320F0A73EAD890BC.quest_subtitle: "La ressource qui limite le palier éveillé"
	quest.320F0A73EAD890BC.quest_desc: [
		"L'Ender Dragon laisse un Dragon Heart à sa mort. Ce composant n'est pas un minerai renouvelé par une machine ordinaire : il demande une nouvelle victoire contre le Dragon."
		""
		"Le Dragon peut être ressuscité avec les End Crystals de Minecraft. Prépare l'arène et l'équipe avant de consommer les cristaux autour du portail de sortie."
		""
		"Garde le cœur pour la fusion d'Awakened Draconium prévue par JEI."
	]
	quest.32730A76938F054B.title: "Trouver du Yellorite"
	quest.32730A76938F054B.quest_subtitle: "Le combustible du premier réacteur"
	quest.32730A76938F054B.quest_desc: [
		"Le Raw Yellorium extrait dans l'Overworld se transforme en Yellorium Ingots. Ces lingots alimentent les Fuel Rods d'Extreme Reactors et entrent dans plusieurs composants du mod."
		""
		"Traite la première réserve avec la meilleure chaîne déjà disponible, puis garde le combustible séparé des matériaux de construction."
		""
		"Cette quête de ressource existe parce que le Yellorium ouvre et entretient tout le système nucléaire."
	]
	quest.35A47601E0730450.title: "Premier système ME"
	quest.35A47601E0730450.quest_subtitle: "Stocker, rechercher et fabriquer au même endroit"
	quest.35A47601E0730450.quest_desc: [
		"Relie un ME Terminal puis un Crafting Terminal au Drive alimenté. Le second ajoute une grille de craft qui utilise directement les objets visibles dans le réseau."
		""
		"Dépose quelques ressources, recherche leur nom et réalise une recette simple. Si l'écran s'éteint, vérifie d'abord l'énergie puis les canaux."
		""
		"Ce petit réseau fonctionne sans Controller tant qu'il ne dépasse pas huit appareils demandant un canal."
	]
	quest.366D61855998D080.title: "Première fusion Wyvern"
	quest.366D61855998D080.quest_subtitle: "Exécuter le cycle complet sans perdre le diagnostic"
	quest.366D61855998D080.quest_desc: [
		"Place le catalyseur dans le Core et les ingrédients indiqués par JEI sur les injecteurs. Lorsque la recette et l'énergie sont reconnues, lance la fusion depuis l'interface."
		""
		"Observe la charge de chaque injecteur puis la phase de fabrication. Si le bouton reste indisponible, lis le détail du palier, de la disposition ou de l'énergie manquante."
		""
		"Le Wyvern Core obtenu ouvre les outils et le palier supérieur d'injecteurs."
	]
	quest.379EBE79F10BE0DC.title: "Compacter les canaux"
	quest.379EBE79F10BE0DC.quest_subtitle: "Faire passer un faisceau ME dans un tunnel P2P"
	quest.379EBE79F10BE0DC.quest_desc: [
		"Les ME P2P Tunnels transportent jusqu'à trente-deux canaux depuis une entrée vers une ou plusieurs sorties, à travers un réseau porteur distinct."
		""
		"Associe les extrémités avec la Memory Card et vérifie les canaux du réseau qui porte les tunnels eux-mêmes. Un P2P ne crée pas de canaux et ne peut pas se transporter récursivement."
		""
		"Utilise cette technique pour relier des salles éloignées sans tirer plusieurs Dense Cables."
	]
	quest.3919CCF30BE1C163.title: "Palier Nitro"
	quest.3919CCF30BE1C163.quest_subtitle: "Le plus haut débit exige une production à la même échelle"
	quest.3919CCF30BE1C163.quest_desc: [
		"Les Nitro Crystals ouvrent la Nitro Energy Cell et le Nitro Reactor. Leur coût énergétique rend une infrastructure stable indispensable avant le craft."
		""
		"Forme le réacteur comme aux paliers précédents, fournis ses quatre consommables et utilise du Dry Ice lorsque la recette et le guide le permettent pour améliorer son refroidissement."
		""
		"Relie-le à la Nitro Energy Cell et mesure une charge réelle avant de considérer Powah terminé."
	]
	quest.397C09255A922C18.title: "Le cœur de fusion"
	quest.397C09255A922C18.quest_subtitle: "Le centre d'un craft distribué"
	quest.397C09255A922C18.quest_desc: [
		"Le Fusion Crafting Core reçoit le catalyseur ou l'objet à transformer. Les autres ingrédients sont placés sur des Crafting Injectors disposés autour et tournés vers lui."
		""
		"Laisse de l'espace tout autour pour augmenter le nombre et le palier des injecteurs. Le cœur indique les ingrédients ou l'énergie manquants avant le démarrage."
		""
		"Il ne peut rien fabriquer seul : construis maintenant les premiers injecteurs."
	]
	quest.3A2D664BA3902F87.title: "Les organes du réacteur"
	quest.3A2D664BA3902F87.quest_subtitle: "Contrôler, alimenter et extraire l'énergie"
	quest.3A2D664BA3902F87.quest_desc: [
		"Le Reactor Controller affiche l'état du multibloc. Les Fuel Rods occupent l'intérieur et doivent être surmontés chacun d'un Control Rod dans la paroi supérieure."
		""
		"Le Power Tap relie le réacteur au stockage FE. Pour le premier modèle, une seule colonne de Fuel Rod suffit ; conserve les pièces supplémentaires pour l'agrandissement."
		""
		"Le Solid Access Port manquant à cette étape assurera l'entrée du Yellorium et la sortie du Cyanite."
	]
	quest.3A60A869839BAEA2.title: "Fournir les ingrédients"
	quest.3A60A869839BAEA2.quest_subtitle: "Le Pattern Provider présente le travail à effectuer"
	quest.3A60A869839BAEA2.quest_desc: [
		"Le Pattern Provider stocke les patterns et fournit leurs ingrédients à l'appareil adjacent. Son orientation et la face de sortie déterminent où le travail est envoyé."
		""
		"Pour un craft classique, associe-le à un Molecular Assembler. Pour un traitement, place-le contre la machine configurée pour rendre le résultat au réseau."
		""
		"Un Provider peut contenir plusieurs recettes, mais séparer les chaînes critiques facilite le dépannage."
	]
	quest.3AC5147D15355AD4.title: "Deux lingots par minerai"
	quest.3AC5147D15355AD4.quest_subtitle: "Enrichir la matière avant de la cuire"
	quest.3AC5147D15355AD4.quest_desc: [
		"L'Enrichment Chamber transforme un minerai ou Raw Ore compatible en poussière concentrée permettant généralement d'obtenir deux lingots après cuisson."
		""
		"Branche énergie, entrée et sortie, puis traite un minerai complet. Vérifie la recette dans JEI : tous les objets ne suivent pas le même multiplicateur."
		""
		"La chaîne n'est complète qu'après l'ajout d'un Energized Smelter."
	]
	quest.3C67E492ED8AB8BE.title: "Deux mondes, un réseau"
	quest.3C67E492ED8AB8BE.quest_subtitle: "Relier deux Quantum Network Bridges"
	quest.3C67E492ED8AB8BE.quest_desc: [
		"Construis deux cadres 3 x 3 avec huit Quantum Rings autour d'un Quantum Link Chamber, puis place une Quantum Entangled Singularity de la même paire dans chaque chambre."
		""
		"Chaque pont doit être formé, alimenté et relié à son côté du réseau. Une fois actifs, ils transportent énergie et canaux même entre dimensions."
		""
		"Teste d'abord avec un terminal secondaire avant d'y faire dépendre toute la logistique de la base."
	]
	quest.3D210E0033EBDF96.title: "Entrer et sortir l'énergie"
	quest.3D210E0033EBDF96.quest_subtitle: "Le Provider et les Ports ferment la Matrix"
	quest.3D210E0033EBDF96.quest_desc: [
		"Place le Basic Induction Provider à l'intérieur et deux Induction Ports dans la paroi. Configure un port en entrée et l'autre en sortie avec le Configurator."
		""
		"Ferme la structure et vérifie que son interface affiche capacité et débit. Charge-la depuis un générateur puis alimente une machine pour tester les deux sens."
		""
		"Une Matrix formée constitue le tampon recommandé avant les installations nucléaires."
	]
	quest.3DC2FDAF85ECB47C.title: "Un portail à objets"
	quest.3DC2FDAF85ECB47C.quest_subtitle: "Transporter un type de ressource à travers le réseau"
	quest.3DC2FDAF85ECB47C.quest_desc: [
		"Deux Item P2P Tunnels de même fréquence forment un passage logique : une extrémité reçoit les objets et l'autre les restitue ailleurs."
		""
		"Relie les tunnels au réseau porteur, configure l'entrée et les sorties avec la Memory Card, puis teste avec un objet ordinaire. Les tunnels ont besoin de canaux pour fonctionner."
		""
		"Le P2P transporte un service ; il ne stocke pas ce qui traverse."
	]
	quest.3FDB3012F1E7D6A2.title: "Le premier circuit"
	quest.3FDB3012F1E7D6A2.quest_subtitle: "Le composant logique des machines Mekanism"
	quest.3FDB3012F1E7D6A2.quest_desc: [
		"Fabrique des Basic Control Circuits avec le Metallurgic Infuser. Ils sont employés dans presque toutes les machines et servent de base aux circuits de paliers supérieurs."
		""
		"Produis les quatre demandés pour les constructions immédiates, puis encode la recette dans AE2 lorsque l'autocraft est disponible."
		""
		"Cette étape reste dédiée parce que le circuit ouvre plusieurs systèmes, pas parce qu'il faut accumuler du métal."
	]
	quest.405DBE9A6169DA65.title: "Le modérateur"
	quest.405DBE9A6169DA65.quest_subtitle: "Le graphite structure et stabilise le réacteur"
	quest.405DBE9A6169DA65.quest_desc: [
		"Le Graphite Ingot sert à fabriquer casings, Fuel Rods et autres composants. Certains blocs ou fluides placés autour des barres agissent aussi comme modérateurs et modifient rendement et température."
		""
		"Commence avec la conception minimale du guide. Les modérateurs deviennent utiles lorsque tu compares ensuite consommation, chaleur et production."
		""
		"Fabrique maintenant assez de graphite pour l'enveloppe et les organes du premier réacteur."
	]
	quest.43918265C59475BA.title: "Une pastille impossible"
	quest.43918265C59475BA.quest_subtitle: "Condenser l'Antimatter produite par le SPS"
	quest.43918265C59475BA.quest_desc: [
		"L'Antimatter sort du SPS sous forme chimique. Transforme la quantité indiquée par JEI en Antimatter Pellet avec la machine adaptée."
		""
		"Stocke cette substance dans une ligne isolée et ne mélange pas ses tanks avec le Polonium d'entrée. Chaque pastille représente une grande quantité d'énergie et de déchets traités."
		""
		"Réserve la première au Antiprotonic Nucleosynthesizer."
	]
	quest.43C64234E787B02F.title: "Garder une réserve"
	quest.43C64234E787B02F.quest_subtitle: "Le Basic Energy Cube stabilise la ligne"
	quest.43C64234E787B02F.quest_desc: [
		"Le Basic Energy Cube stocke la FE et sépare les variations de production de la consommation des machines."
		""
		"Configure une face en entrée et une autre en sortie, puis observe la réserve pendant un cycle de traitement. Les voyants de face évitent de brancher deux entrées l'une contre l'autre."
		""
		"Place les cubes aux points où un arrêt brutal coûterait des ressources ou du temps."
	]
	quest.4449000000000001.quest_desc: [
		"Dix blocs d'obsidienne et un briquet suffisent à percer vers le Nether."
		""
		"Verse un seau d'eau sur de la lave pour créer l'obsidienne sans descendre au fond du monde."
	]
	quest.4449000000000001.quest_subtitle: "Étape 1 / 4"
	quest.4449000000000001.title: "Ouvrir la voie"
	quest.4449000000000002.quest_desc: [
		"Franchis le portail. La chaleur, les mobs et l'absence d'eau rendent cette dimension hostile."
		""
		"Note bien les coordonnées de ton portail : un pas de travers et le retour devient long."
	]
	quest.4449000000000002.quest_subtitle: "Étape 2 / 4"
	quest.4449000000000002.title: "Le Nether"
	quest.4449000000000003.quest_desc: [
		"Le quartz se récolte en veines dans le netherrack."
		""
		"Il entre dans le Fluix d'AE2 et dans une quantité considérable de circuits."
	]
	quest.4449000000000003.quest_subtitle: "Étape 2 / 4"
	quest.4449000000000003.title: "Le quartz du Nether"
	quest.4449000000000004.quest_desc: [
		"Les Blazes hantent les forteresses du Nether. Leurs bâtons donnent la poudre nécessaire aux yeux de l'End."
		""
		"Un générateur de Blaze automatisé rendra service bien au-delà de cette quête."
	]
	quest.4449000000000004.quest_subtitle: "Étape 2 / 4"
	quest.4449000000000004.title: "Bâtons de Blaze"
	quest.4449000000000005.quest_desc: [
		"Les débris antiques se cachent entre les couches 8 et 22. Seule une pioche en diamant les entame."
		""
		"Le TNT à lit reste la méthode la plus rapide pour balayer une couche entière."
	]
	quest.4449000000000005.quest_subtitle: "Étape 2 / 4"
	quest.4449000000000005.title: "Débris antiques"
	quest.4449000000000006.quest_desc: [
		"Les Endermen lâchent les perles. Chasse-les de nuit ou dans les plaines du Nether."
		""
		"Un piège à Endermen dans les terres de l'End produira bien plus que ce dont tu as besoin ici."
	]
	quest.4449000000000006.quest_subtitle: "Étape 3 / 4"
	quest.4449000000000006.title: "Perles de l'Ender"
	quest.4449000000000007.quest_desc: [
		"Combine perle et poudre de Blaze. Lance un œil pour qu'il pointe vers le portail le plus proche."
		""
		"Un œil sur cinq se brise en vol : prévois large avant de partir en expédition."
	]
	quest.4449000000000007.quest_subtitle: "Étape 3 / 4"
	quest.4449000000000007.title: "Les yeux de l'End"
	quest.4449000000000008.quest_desc: [
		"Remplis les douze cadres du portail au fond de la forteresse, puis saute."
		""
		"Emporte des blocs de construction et de quoi te protéger de la projection : le Dragon frappe fort."
	]
	quest.4449000000000008.quest_subtitle: "Étape 3 / 4"
	quest.4449000000000008.title: "L'End"
	quest.4449000000000009.quest_desc: [
		"Détruis d'abord les cristaux perchés sur les tours d'obsidienne, puis attaque la bête au sol."
		""
		"Sa mort ouvre la passerelle vers les îles extérieures et libère un flot considérable d'expérience."
	]
	quest.4449000000000009.quest_subtitle: "Étape 3 / 4"
	quest.4449000000000009.title: "Terrasser le Dragon"
	quest.444900000000000A.quest_desc: [
		"Draconic Evolution fait tomber un cœur de Dragon à chaque mise à mort."
		""
		"Rallume le Dragon avec quatre cristaux de l'End si tu en veux davantage : c'est la porte d'entrée du draconium éveillé."
	]
	quest.444900000000000A.quest_subtitle: "Étape 3 / 4"
	quest.444900000000000A.title: "Le cœur du Dragon"
	quest.444900000000000B.quest_desc: [
		"Les îles extérieures abritent des cités et leurs navires. Coquilles de Shulker et Élytres t'y attendent."
		""
		"Les coquilles servent aux Sacs à dos et à de nombreux blocs de stockage : ramènes-en une pleine pile."
	]
	quest.444900000000000B.quest_subtitle: "Étape 3 / 4"
	quest.444900000000000B.title: "Les cités de l'End"
	quest.444900000000000C.quest_desc: [
		"Huit blocs d'obsidienne autour d'une pioche en diamant donnent le Portail Minier de JAMD."
		""
		"Pose-le au sol et fais un clic droit : il génère lui-même son cadre et t'ouvre le passage."
	]
	quest.444900000000000C.quest_subtitle: "Étape 4 / 4"
	quest.444900000000000C.title: "Le Portail Minier"
	quest.444900000000000D.quest_desc: [
		"Un monde entier de pierre, sans surface à préserver ni construction à épargner."
		""
		"C'est ici que tu poseras tes foreuses : creuse, dynamite, rase, personne ne s'en plaindra."
	]
	quest.444900000000000D.quest_subtitle: "Étape 4 / 4"
	quest.444900000000000D.title: "La Dimension Minière"
	quest.444900000000000E.quest_desc: [
		"La densité de minerai de cette dimension n'a rien à voir avec l'Overworld."
		""
		"Un Pulverizer Thermal ou une Enrichment Chamber Mekanism doublera ce rendement déjà généreux."
	]
	quest.444900000000000E.quest_subtitle: "Étape 4 / 4"
	quest.444900000000000E.title: "Fer et cuivre en masse"
	quest.444900000000000F.quest_desc: [
		"Deux ressources que la progression technique consomme sans fin."
		""
		"AE2 et Mekanism en réclament des piles entières : ne repars pas les poches à moitié vides."
	]
	quest.444900000000000F.quest_subtitle: "Étape 4 / 4"
	quest.444900000000000F.title: "Redstone et lapis"
	quest.4449000000000010.quest_desc: [
		"Les veines profondes livrent l'or et le diamant nécessaires aux processeurs."
		""
		"Une pioche Fortune III change radicalement le rendement du diamant."
	]
	quest.4449000000000010.quest_subtitle: "Étape 4 / 4"
	quest.4449000000000010.title: "Or et diamant"
	quest.4449000000000011.quest_desc: [
		"Délimite une zone avec les marqueurs QuarryPlus, place la Quarry contre eux et alimente-la."
		""
		"Sans terrain à préserver ici, tu peux voir grand dès le départ."
	]
	quest.4449000000000011.quest_subtitle: "Étape 4 / 4"
	quest.4449000000000011.title: "Poser la première foreuse"
	quest.4449000000000013.quest_desc: [
		"Les câbles ne traversent pas les dimensions, mais le Réseau Quantique d'AE2 si."
		""
		"Il faut deux anneaux complets de 8 Anneaux Quantiques autour d'un Lien Quantique, reliés par une paire de Singularités Intriquées."
	]
	quest.4449000000000013.quest_subtitle: "Étape 4 / 4"
	quest.4449000000000013.title: "Rapatrier le butin"
	quest.4449000000000014.quest_desc: [
		"Huit briques du Nether autour d'une pioche en netherite ouvrent la mine infernale."
		""
		"Il te faut donc d'abord fondre tes débris antiques et monter une pioche complète."
	]
	quest.4449000000000014.quest_subtitle: "Étape 4 / 4"
	quest.4449000000000014.title: "Le Portail Minier Infernal"
	quest.4449000000000015.quest_desc: [
		"Une dimension entière de netherrack saturée de quartz, d'or et de débris antiques."
		""
		"Aucune forteresse, aucun Ghast : rien que du minerai à extraire en paix."
	]
	quest.4449000000000015.quest_subtitle: "Étape 4 / 4"
	quest.4449000000000015.title: "La mine infernale"
	quest.4449000000000016.quest_desc: [
		"Huit blocs d'End Stone autour d'une pioche en diamant. Il faut donc être allé dans l'End au préalable."
		""
		"Ramène une bonne réserve d'End Stone lors de ton expédition au Dragon."
	]
	quest.4449000000000016.quest_subtitle: "Étape 4 / 4"
	quest.4449000000000016.title: "Le Portail Minier de l'End"
	quest.4449000000000017.quest_desc: [
		"La dernière des trois mines, taillée dans l'End Stone."
		""
		"Sans vide ni chute mortelle : la version exploitable de l'End."
	]
	quest.4449000000000017.quest_subtitle: "Étape 4 / 4"
	quest.4449000000000017.title: "La mine de l'End"
	quest.4449000000000018.quest_desc: [
		"Nether, End, et les trois mines de JAMD : tu as ouvert toutes les portes du modpack."
		""
		"Les foreuses tournent désormais à ta place. À toi de bâtir de quoi ne plus jamais miner à la main."
	]
	quest.4449000000000018.quest_subtitle: "Terminé"
	quest.4449000000000018.title: "Aux quatre coins du monde"
	quest.46F62D5F63E9226A.title: "Encoder les recettes"
	quest.46F62D5F63E9226A.quest_subtitle: "Dire au réseau ce qu'il sait fabriquer"
	quest.46F62D5F63E9226A.quest_desc: [
		"Le Pattern Encoding Terminal transforme un Blank Pattern en instruction. Choisis clairement le mode Crafting ou Processing avant d'enregistrer les entrées et sorties."
		""
		"Commence avec une recette simple dont les ingrédients existent déjà dans le réseau. N'encode pas encore une longue chaîne impossible à diagnostiquer."
		""
		"Le pattern devra ensuite être placé dans un Pattern Provider."
	]
	quest.4932175E189C9E71.title: "L'armure modulaire"
	quest.4932175E189C9E71.quest_subtitle: "Construire la protection à partir de ses modules"
	quest.4932175E189C9E71.quest_desc: [
		"La Wyvern Chestpiece n'offre son plein intérêt qu'avec des modules adaptés. Capacité d'énergie, bouclier, vitesse et autres fonctions occupent un espace limité dans la grille."
		""
		"Commence par la survie et l'autonomie énergétique avant les bonus de confort. Vérifie aussi les touches associées aux fonctions actives afin de ne pas charger inutilement le clavier."
		""
		"Une pièce cohérente vaut mieux qu'une grille remplie sans plan."
	]
	quest.4970D189D5B5ACD3.title: "Alliage Vibrant"
	quest.4970D189D5B5ACD3.quest_subtitle: "Augmenter le palier énergétique des machines"
	quest.4970D189D5B5ACD3.quest_desc: [
		"Le Vibrant Alloy ouvre les composants et conduits avancés d'Ender IO. L'Octadic Capacitor améliore fortement vitesse, capacité et consommation des machines compatibles."
		""
		"Installe un capacitor sur une machine dont le débit limite réellement la chaîne. Une machine accélérée peut vider le réseau ou bloquer la suivante si les sorties restent trop lentes."
		""
		"Mesure la chaîne complète avant de multiplier ces améliorations coûteuses."
	]
	quest.49F4354F6AA6ADD9.title: "Du sel à la saumure"
	quest.49F4354F6AA6ADD9.quest_subtitle: "Construire une Thermal Evaporation Plant"
	quest.49F4354F6AA6ADD9.quest_desc: [
		"La Thermal Evaporation Plant est une tour creuse de section 4 x 4, avec Controller et Valves dans ses parois. Sa hauteur augmente sa capacité de traitement."
		""
		"Forme le multibloc selon le guide, injecte de l'eau et chauffe-le par le soleil ou les méthodes compatibles. Il produit d'abord de la Brine, puis une seconde tour peut concentrer cette Brine en Lithium."
		""
		"Valide lorsque la structure est formée et que le premier fluide sort réellement."
	]
	quest.4A0A2ADC9130E9F2.title: "Le supercollisionneur"
	quest.4A0A2ADC9130E9F2.quest_subtitle: "Le SPS convertit Polonium et énergie en Antimatter"
	quest.4A0A2ADC9130E9F2.quest_desc: [
		"Le Supercritical Phase Shifter est un grand multibloc formé de SPS Casings et Ports avec au moins une Supercharged Coil placée dans son volume intérieur."
		""
		"Construis-le selon le guide, alimente la coil avec un débit énergétique massif et injecte le Polonium par un port configuré. L'autre port doit évacuer l'Antimatter sans bloquer la production."
		""
		"Commence avec une seule coil et mesure la consommation avant d'augmenter la vitesse."
	]
	quest.4A800F994ACA9A84.title: "Fusion éveillée"
	quest.4A800F994ACA9A84.quest_subtitle: "Des injecteurs adaptés aux recettes draconiques"
	quest.4A800F994ACA9A84.quest_desc: [
		"Construis quatre Awakened Crafting Injectors et intègre-les autour du Core. Ils supportent les recettes qui dépassent le palier Wyvern."
		""
		"Vérifie leur orientation, leur liaison énergétique et la capacité du réseau à les charger simultanément. Garde des cristaux d'énergie dédiés près de l'atelier si le reste de la base provoque des chutes de débit."
		""
		"Valide après une fusion de palier Awakened réussie."
	]
	quest.4AF3729F319FCA73.title: "Générer de l'énergie"
	quest.4AF3729F319FCA73.quest_subtitle: "Comparer production solaire et combustible solide"
	quest.4AF3729F319FCA73.quest_desc: [
		"Le Basic Solar Panel produit sans combustible lorsqu'il voit le ciel et reçoit la lumière. Le Basic Furnator brûle des combustibles et fonctionne indépendamment de l'heure."
		""
		"Branche chacun à un Energy Cell et compare leur débit ainsi que leurs périodes d'arrêt. Le solaire convient à une charge continue faible ; le Furnator sert de complément pilotable."
		""
		"Conserve les deux sources séparées jusqu'à avoir vérifié leurs sorties."
	]
	quest.4B0B29DED24E1AE5.title: "Broyer et recycler"
	quest.4B0B29DED24E1AE5.quest_subtitle: "Le Crusher prépare minerais, biomasse et matériaux"
	quest.4B0B29DED24E1AE5.quest_desc: [
		"Le Crusher traite les clumps du triplement, transforme des plantes en Bio Fuel et exécute diverses recettes de broyage."
		""
		"Installe-le avec des faces configurées puis teste une recette utile à la prochaine branche. Ne le confonds pas avec l'Enrichment Chamber : leurs sorties ne sont pas interchangeables."
		""
		"Il deviendra un maillon obligatoire du traitement x3 et de la production d'éthylène."
	]
	quest.4B438C8DE8EF77BC.title: "Nettoyer les boues"
	quest.4B438C8DE8EF77BC.quest_subtitle: "La Chemical Washer sépare la matière utile"
	quest.4B438C8DE8EF77BC.quest_desc: [
		"La Chemical Washer reçoit Dirty Slurry et eau pour produire Clean Slurry. Les deux slurries doivent circuler dans des tubes et tanks chimiques compatibles."
		""
		"Fournis une alimentation en eau continue et évacue la sortie vers un tank dédié. Une conduite contenant déjà une autre slurry empêchera la connexion."
		""
		"La Clean Slurry doit ensuite être cristallisée pour rejoindre la chaîne de minerais."
	]
	quest.4B58B43FEEAC7B91.title: "Première commande automatique"
	quest.4B58B43FEEAC7B91.quest_subtitle: "Tester une chaîne courte de bout en bout"
	quest.4B58B43FEEAC7B91.quest_desc: [
		"Encode une recette simple, place le pattern dans son Provider et demande plusieurs exemplaires depuis le Crafting Terminal."
		""
		"Lis l'aperçu avant de confirmer : il indique les ingrédients disponibles, manquants et les étapes prévues. Observe ensuite le statut de la commande dans le réseau."
		""
		"Valide seulement lorsque l'objet final revient automatiquement dans le stockage ME."
	]
	quest.4D43000000000001.title: "Le point de départ"
	quest.4D43000000000001.quest_subtitle: "Choisir un territoire où la colonie pourra respirer"
	quest.4D43000000000001.quest_desc: [
		"MineColonies est une campagne facultative de gestion et de construction. Choisis une zone assez vaste, praticable et proche des ressources sans empiéter sur les projets des autres joueurs."
		""
		"Observe le relief, les routes possibles et la place nécessaire aux grands bâtiments. Déplacer une colonie développée coûte beaucoup plus cher que préparer correctement son implantation."
		""
		"Valide lorsque l'équipe connaît les limites approximatives du futur territoire."
	]
	quest.4D43000000000002.title: "L'outil de construction"
	quest.4D43000000000002.quest_subtitle: "Prévisualiser chaque bâtiment avant de le commander"
	quest.4D43000000000002.quest_desc: [
		"Le Build Tool affiche le modèle complet d'une hutte avant sa pose. Choisis le style, déplace et tourne l'aperçu, puis vérifie ses limites et son entrée."
		""
		"Le bloc de hutte n'est que le point de contrôle du bâtiment : après sa pose, utilise Build Options pour créer l'ordre de construction destiné au Builder."
		""
		"Garde cet outil sur toi ; il sert aussi aux décorations et au positionnement des extensions."
	]
	quest.4D43000000000003.title: "Fonder la colonie"
	quest.4D43000000000003.quest_subtitle: "Le Town Hall enregistre le territoire et ses règles"
	quest.4D43000000000003.quest_desc: [
		"Fabrique le Town Hall, place-le avec le Build Tool puis confirme la création de la colonie. Son interface centralise citoyens, événements, permissions et ordres de construction."
		""
		"Choisis soigneusement le nom et le style. Vérifie les limites du claim avant d'ajouter d'autres huttes ou d'inviter des officiers."
		""
		"La quête doit être validée après l'enregistrement de la colonie, pas à la simple fabrication du bloc."
	]
	quest.4D43000000000004.title: "Le premier Bâtisseur"
	quest.4D43000000000004.quest_subtitle: "Transformer les ressources livrées en bâtiments"
	quest.4D43000000000004.quest_desc: [
		"Place la Builder's Hut avec le Build Tool puis lance sa construction. Le Builder réalise ensuite les ordres selon leur priorité et les matériaux disponibles."
		""
		"Consulte régulièrement ses demandes et ses racks. Une amélioration au niveau 2 tôt dans la partie accélère nettement la suite et permet des bâtiments de niveau supérieur."
		""
		"Valide lorsque le Builder est recruté et a achevé au moins son propre bâtiment."
	]
	quest.4D43000000000005.title: "Loger les habitants"
	quest.4D43000000000005.quest_subtitle: "Chaque niveau de Residence ouvre une place"
	quest.4D43000000000005.quest_desc: [
		"Construis une Residence pour augmenter la capacité de citoyens. Chaque niveau fournit une place supplémentaire et améliore le logement de ses occupants."
		""
		"Place les habitations près des emplois ou d'une route simple afin de réduire les longs déplacements quotidiens. Assigne les résidents si l'attribution automatique ne correspond pas à l'organisation voulue."
		""
		"Valide après la construction et l'arrivée effective d'un habitant."
	]
	quest.4D43000000000006.title: "Attirer de nouveaux colons"
	quest.4D43000000000006.quest_subtitle: "La Tavern accueille visiteurs et recrues"
	quest.4D43000000000006.quest_desc: [
		"La Tavern fait apparaître des visiteurs pouvant être recrutés et fournit des lits temporaires. Construis-la avec un accès clair depuis l'extérieur de la colonie."
		""
		"Examine les compétences et le coût d'une recrue avant de l'accepter. Une grande population sans logements, nourriture ni emplois fait chuter le fonctionnement général."
		""
		"Valide lorsque la Tavern est achevée et qu'un premier visiteur a été observé."
	]
	quest.4D43000000000007.title: "Première ligne de défense"
	quest.4D43000000000007.quest_subtitle: "Une Guard Tower protège un secteur précis"
	quest.4D43000000000007.quest_desc: [
		"La Guard Tower emploie un garde et définit une zone de patrouille. Place-la près d'une entrée, d'un quartier exposé ou d'un trajet fréquent des travailleurs."
		""
		"Fournis arme, armure et nourriture adaptées au garde, puis règle son comportement dans l'interface. Une tour isolée trop loin de la logistique restera souvent sans équipement."
		""
		"Valide après le recrutement et une patrouille réelle."
	]
	quest.4D43000000000008.title: "Le cœur logistique"
	quest.4D43000000000008.quest_subtitle: "Le Warehouse rassemble les stocks de la colonie"
	quest.4D43000000000008.quest_desc: [
		"Le Warehouse fournit le stockage central utilisé par le système de demandes. Choisis un emplacement desservi par les routes et laisse de la place pour ses améliorations."
		""
		"Le bâtiment n'aspire rien tout seul : les Couriers assurent les déplacements entre huttes et entrepôt. Organise les racks et les minimum stocks avant que les demandes se multiplient."
		""
		"Valide lorsque le Warehouse est construit et enregistré dans la colonie."
	]
	quest.4D43000000000009.title: "Faire circuler les ressources"
	quest.4D43000000000009.quest_subtitle: "Le Courier relie les travailleurs au Warehouse"
	quest.4D43000000000009.quest_desc: [
		"Construis une Courier's Hut près du Warehouse et recrute un Courier. Il collecte les productions, livre les demandes et évite au joueur de servir chaque travailleur à la main."
		""
		"Améliore les routes et règle les priorités de collecte dans les huttes importantes. Un seul Courier peut devenir le goulot d'étranglement d'une colonie qui grandit vite."
		""
		"Valide après une livraison automatique complète."
	]
	quest.4D4300000000000A.title: "Suivre les demandes"
	quest.4D4300000000000A.quest_subtitle: "Le Clipboard montre ce qui bloque réellement"
	quest.4D4300000000000A.quest_desc: [
		"Le Clipboard affiche les demandes ouvertes de la colonie et permet d'identifier le bâtiment, l'objet et l'étape responsables d'un arrêt."
		""
		"Consulte-le avant de fabriquer au hasard une grande réserve. Une demande peut être bloquée par une recette non enseignée, un Courier occupé ou un matériau vraiment absent."
		""
		"Garde-le près du Warehouse ou dans ton sac lors des phases d'expansion."
	]
	quest.4D4300000000000B.title: "Une source de bois durable"
	quest.4D4300000000000B.quest_subtitle: "Le Forester coupe et replante dans sa zone"
	quest.4D4300000000000B.quest_desc: [
		"Construis la Forester's Hut près d'une zone arborée et règle les types d'arbres autorisés. Le Forester abat, collecte et replante selon les options du bâtiment."
		""
		"Laisse assez d'espace entre les pousses et fournis outils ainsi que saplings. Une zone trop petite ne suivra pas la demande du Builder et du Sawmill."
		""
		"Valide après un cycle complet de coupe et replantation."
	]
	quest.4D4300000000000C.title: "Creuser pour grandir"
	quest.4D4300000000000C.quest_subtitle: "La Mine construit ses niveaux et ses galeries"
	quest.4D4300000000000C.quest_desc: [
		"La Mine emploie un Miner qui creuse un puits structuré puis des galeries aux niveaux autorisés par le bâtiment."
		""
		"Prévois une grande emprise souterraine, des outils, torches, échelles et supports. Les améliorations du bâtiment permettent de descendre davantage et d'utiliser de meilleurs équipements."
		""
		"Valide lorsque le Miner a commencé un niveau de mine, pas seulement lorsque la hutte est posée."
	]
	quest.4D4300000000000D.title: "Pêcher pour la colonie"
	quest.4D4300000000000D.quest_subtitle: "Une source de nourriture simple pour le début"
	quest.4D4300000000000D.quest_desc: [
		"La Fisher's Hut fournit rapidement du poisson et quelques trouvailles liées à la pêche. Place-la avec un accès dégagé à une étendue d'eau suffisante."
		""
		"Équipe le Fisher et relie la hutte au réseau de Courier. Le poisson devient réellement utile lorsque le Dining Hall le cuit et le distribue."
		""
		"Valide après le retour d'une première prise dans le stockage de la hutte."
	]
	quest.4D4300000000000E.title: "Organiser l'agriculture"
	quest.4D4300000000000E.quest_subtitle: "La Farmer's Hut coordonne plusieurs Fields"
	quest.4D4300000000000E.quest_desc: [
		"La Farmer's Hut emploie le Farmer et gère les Field Blocks associés. Le bâtiment seul ne crée aucune parcelle."
		""
		"Place-le près d'un terrain plat avec accès à l'eau et au Warehouse. Vérifie le nombre de champs permis par son niveau avant d'étendre la zone."
		""
		"Construis ensuite le premier Field et choisis sa culture."
	]
	quest.4D4300000000000F.title: "Le premier champ"
	quest.4D4300000000000F.quest_subtitle: "Définir une parcelle et sa culture"
	quest.4D4300000000000F.quest_desc: [
		"Place un Field Block dans la zone du Farmer puis utilise le Build Tool pour prévisualiser et confirmer la parcelle. Associe-la à la Farmer's Hut dans l'interface."
		""
		"Choisis une culture dont la colonie a besoin et fournis les premières graines. Le Farmer prépare, récolte et replante lorsqu'outils et logistique sont disponibles."
		""
		"Valide après une première récolte livrée."
	]
	quest.4D43000000000010.title: "Nourrir tout le monde"
	quest.4D43000000000010.quest_subtitle: "Le Dining Hall cuit et distribue les repas"
	quest.4D43000000000010.quest_desc: [
		"Le Dining Hall emploie un Waiter qui cuit les aliments simples et les remet aux citoyens affamés. Active les nourritures et combustibles autorisés dans ses listes."
		""
		"Place-le près des logements et alimente-le par Courier. Pour les plats complexes, il dépendra plus tard de la Chef's Kitchen."
		""
		"Valide lorsque le Waiter a servi un citoyen sans intervention du joueur."
	]
	quest.4D43000000000011.title: "Recycler les déchets"
	quest.4D43000000000011.quest_subtitle: "Le Composter transforme l'organique en ressource"
	quest.4D43000000000011.quest_desc: [
		"Le Composter reçoit les matières organiques autorisées et les transforme en compost utile à la colonie."
		""
		"Règle la liste des objets acceptés pour ne pas consommer une nourriture ou une ressource rare. Le Courier peut maintenir son stock et récupérer les produits."
		""
		"Valide après un cycle réalisé par le travailleur avec des apports automatiques."
	]
	quest.4D43000000000012.title: "Former la nouvelle génération"
	quest.4D43000000000012.quest_subtitle: "La School améliore les enfants avant leur premier métier"
	quest.4D43000000000012.quest_desc: [
		"La School accueille les enfants de la colonie et améliore leur Intelligence pendant leur croissance, ce qui facilite l'apprentissage de leurs futures compétences."
		""
		"Assigne un Teacher compétent, fournis les ressources demandées et garde le bâtiment accessible depuis les Residences."
		""
		"Valide lorsqu'un enfant suit effectivement les cours."
	]
	quest.4D43000000000013.title: "Entrer dans l'âge de la recherche"
	quest.4D43000000000013.quest_subtitle: "L'University ouvre les branches Civilian, Technology et Combat"
	quest.4D43000000000013.quest_desc: [
		"L'University emploie des Researchers et débloque des recherches qui modifient bâtiments, travailleurs et défense. Les prérequis forment plusieurs arbres durables."
		""
		"Choisis d'abord une recherche répondant à un blocage concret : capacité de logement, production, logistique ou sécurité. Certaines constructions avancées exigent un résultat précis."
		""
		"Valide après avoir lancé puis terminé une première recherche."
	]
	quest.4D43000000000014.title: "Industrialiser le travail du bois"
	quest.4D43000000000014.quest_subtitle: "Le Sawmill fabrique sur demande les composants en bois"
	quest.4D43000000000014.quest_desc: [
		"Le Sawmill reçoit les demandes de composants en bois et exécute les recettes enseignées dans son interface."
		""
		"Apprends une recette réellement utilisée par le Builder, fournis les matières depuis le Forester puis laisse le Courier livrer le résultat. Le niveau du bâtiment limite le nombre et la complexité des recettes."
		""
		"Valide après une fabrication déclenchée par le système de demandes."
	]
	quest.4D43000000000015.title: "Façonner la pierre"
	quest.4D43000000000015.quest_subtitle: "Le Stonemason répond aux demandes minérales"
	quest.4D43000000000015.quest_desc: [
		"Le Stonemason fabrique escaliers, dalles et autres composants de pierre à partir des recettes qui lui sont enseignées."
		""
		"Relie son approvisionnement à la Mine et enseigne d'abord les blocs présents dans le style architectural de la colonie. Une recette inutilisée occupe inutilement une place au niveau bas."
		""
		"Valide après une commande produite et livrée automatiquement."
	]
	quest.4D43000000000016.title: "Traiter les métaux"
	quest.4D43000000000016.quest_subtitle: "La Smeltery transforme les minerais pour la colonie"
	quest.4D43000000000016.quest_desc: [
		"La Smeltery traite les minerais et recettes de cuisson métallurgiques demandés par les autres bâtiments. Elle réduit le travail manuel du joueur lorsque la Mine alimente le Warehouse."
		""
		"Enseigne une recette utile, active un combustible disponible et règle le minimum stock si une réserve de lingots doit toujours être maintenue."
		""
		"Valide après un cycle commandé par la logistique."
	]
	quest.4D43000000000017.title: "Structurer la défense"
	quest.4D43000000000017.quest_subtitle: "La Barracks coordonne plusieurs gardes"
	quest.4D43000000000017.quest_desc: [
		"La Barracks forme le centre d'une défense plus large que les Guard Towers isolées et accueille ses propres Barracks Towers selon le niveau."
		""
		"Place-la près d'un axe exposé sans couper les routes civiles. Fournis un stock régulier d'armes, armures et nourriture avant d'augmenter le nombre de gardes."
		""
		"Valide lorsque le complexe est construit et qu'au moins un garde y est affecté."
	]
	quest.4D43000000000018.title: "Former les archers"
	quest.4D43000000000018.quest_subtitle: "L'Archery prépare les futurs Rangers"
	quest.4D43000000000018.quest_desc: [
		"L'Archery entraîne des citoyens destinés au combat à distance. Leur progression demande du temps, un formateur et les ressources prévues par le bâtiment."
		""
		"Choisis des recrues dont les compétences conviennent au rôle et prépare arcs, flèches et armures avant leur affectation sur le terrain."
		""
		"Valide lorsqu'un citoyen a commencé sa formation."
	]
	quest.4D43000000000019.title: "Former les combattants"
	quest.4D43000000000019.quest_subtitle: "La Combat Academy prépare les futurs Knights"
	quest.4D43000000000019.quest_desc: [
		"La Combat Academy entraîne des citoyens pour les rôles de mêlée. Elle complète l'Archery plutôt que de la remplacer."
		""
		"Fournis un équipement cohérent et ne retire pas tous les gardes actifs pour les former simultanément. La colonie doit rester défendue pendant leur progression."
		""
		"Valide lorsqu'une formation de combattant est en cours."
	]
	quest.4D4300000000001A.title: "Prendre soin des citoyens"
	quest.4D4300000000001A.quest_subtitle: "L'Hospital traite blessures et maladies"
	quest.4D4300000000001A.quest_desc: [
		"L'Hospital emploie un Healer qui traite les citoyens blessés ou malades avec les remèdes demandés par leur état."
		""
		"Place-le sur une route centrale, conserve un minimum stock de médicaments et surveille les demandes lors des épidémies. Un bâtiment vide ne soigne rien sans travailleur ni ressources."
		""
		"Valide après la prise en charge effective d'un citoyen."
	]
	quest.4D4300000000001B.title: "Améliorer les repas"
	quest.4D4300000000001B.quest_subtitle: "La Chef's Kitchen prépare les plats complexes"
	quest.4D4300000000001B.quest_desc: [
		"La Chef's Kitchen emploie un Chef et fabrique sur demande les plats que le Dining Hall ne sait pas préparer seul."
		""
		"Enseigne quelques recettes adaptées aux cultures disponibles puis relie la Kitchen au Warehouse et au Dining Hall. Chaque niveau augmente le nombre de recettes mémorisables."
		""
		"Valide lorsqu'un plat a été commandé, cuisiné puis livré."
	]
	quest.4D4300000000001C.title: "Développer le savoir"
	quest.4D4300000000001C.quest_subtitle: "La Library augmente l'Intelligence des adultes"
	quest.4D4300000000001C.quest_desc: [
		"La Library accueille des adultes comme Library Students et augmente progressivement leur Intelligence, compétence qui accélère ensuite les autres apprentissages."
		""
		"Deux citoyens peuvent étudier par niveau de bâtiment. Papier et livres améliorent leur progression, mais étudier devient leur emploi à plein temps pendant cette période."
		""
		"Valide après l'affectation d'un étudiant et un gain observé."
	]
	quest.4D4300000000001D.title: "Maîtriser l'enchantement"
	quest.4D4300000000001D.quest_subtitle: "L'Enchanter's Tower transforme l'expérience en livres"
	quest.4D4300000000001D.quest_desc: [
		"L'Enchanter observe les autres travailleurs pour accumuler de l'expérience et crée des enchanted books lorsqu'il dispose des Ancient Tomes nécessaires."
		""
		"Construis la tour dans une colonie déjà active, relie-la au système de demandes et conserve les tomes rares pour les enchantements réellement utiles."
		""
		"Valide après une première production réalisée par l'Enchanter."
	]
	quest.4D4300000000001E.title: "Une colonie accomplie"
	quest.4D4300000000001E.quest_subtitle: "Le Mystical Site soutient le bonheur sans nouveau travailleur"
	quest.4D4300000000001E.quest_desc: [
		"Le Mystical Site est débloqué par la recherche Ambition. Il n'emploie personne : sa présence augmente le bonheur global de la colonie et le maximum de chance de résurrection lié à l'Undertaker."
		""
		"Son bonus ne se cumule pas ; seul le site de plus haut niveau compte. Construis-en un dans un lieu cohérent avec la ville plutôt que d'en multiplier les copies."
		""
		"Cette étape conclut le parcours conseillé, mais la colonie peut continuer à s'étendre selon vos projets."
	]
	quest.4EF7B15079171BB2.title: "La turbine industrielle"
	quest.4EF7B15079171BB2.quest_subtitle: "Convertir la vapeur et fermer la boucle d'eau"
	quest.4EF7B15079171BB2.quest_desc: [
		"L'Industrial Turbine reçoit la vapeur du Fission Reactor. Rotor, blades, Rotational Complex et Electromagnetic Coils transforment le débit en FE."
		""
		"Les Pressure Dispersers répartissent la vapeur et les Saturating Condensers récupèrent l'eau. Relie cette eau au réacteur avec un réservoir tampon pour fermer la boucle."
		""
		"Valide après plusieurs minutes à burn rate faible avec niveaux d'eau, vapeur et énergie stables."
	]
	quest.4F10C8BFA87BC0D3.title: "Le cerveau de fabrication"
	quest.4F10C8BFA87BC0D3.quest_subtitle: "Stocker les étapes d'une commande automatique"
	quest.4F10C8BFA87BC0D3.quest_desc: [
		"Un Crafting CPU est un multibloc contigu composé au minimum d'une Crafting Unit et d'un stockage de fabrication, ici 1k."
		""
		"Sa capacité limite la taille des tâches intermédiaires qu'il peut planifier. Place les blocs ensemble et vérifie que le terminal reconnaît un CPU disponible."
		""
		"Le CPU ne connaît aucune recette seul : il coordonne les patterns déjà installés dans les Providers."
	]
	quest.4F16FEF3727FAFC6.title: "Dépasser huit appareils"
	quest.4F16FEF3727FAFC6.quest_subtitle: "Le Controller organise un réseau à canaux"
	quest.4F16FEF3727FAFC6.quest_desc: [
		"Le ME Controller devient nécessaire lorsque le réseau principal dépasse huit appareils utilisant un canal. Chacune de ses faces distribue des groupes de canaux aux câbles connectés."
		""
		"Installe-le au centre d'une distribution claire et alimente-le. Un multibloc de Controllers doit garder une forme valide ; son interface indique immédiatement une construction incorrecte."
		""
		"Le Controller augmente la capacité d'organisation, pas celle des cellules."
	]
	quest.50341080C6AFCFF1.title: "Un outil, cinq usages"
	quest.50341080C6AFCFF1.quest_subtitle: "Découvrir les alliages de Mekanism avec un outil polyvalent"
	quest.50341080C6AFCFF1.quest_desc: [
		"L'Osmium Paxel réunit pioche, hache, pelle et fonctions associées dans un seul outil. Il introduit l'Osmium sans demander une pile de minerai sans but."
		""
		"Fabrique-le si cette polyvalence t'est utile, puis vérifie sa vitesse et sa durabilité sur plusieurs blocs. Les outils technologiques plus avancés arriveront plus tard."
		""
		"Le cœur de Mekanism commence avec une source d'énergie et le Metallurgic Infuser."
	]
	quest.504574A21B0F27FD.title: "Premier réacteur"
	quest.504574A21B0F27FD.quest_subtitle: "Former, charger puis démarrer à faible puissance"
	quest.504574A21B0F27FD.quest_desc: [
		"Ajoute le Solid Access Port et termine un réacteur Basic 3 x 3 x 3 avec une colonne de combustible centrale. Le Controller change d'apparence lorsque la structure est valide."
		""
		"Charge peu de Yellorium, branche un stockage et démarre avec les Control Rods fortement insérés. Observe température, production et consommation avant d'augmenter la réactivité."
		""
		"Valide seulement après avoir produit de la FE et récupéré le Cyanite usé sans casser la structure."
	]
	quest.511BAC2A0CE42342.title: "Relier le réseau"
	quest.511BAC2A0CE42342.quest_subtitle: "Énergie, données et canaux sur un même câble"
	quest.511BAC2A0CE42342.quest_desc: [
		"Le Fluix Glass Cable relie les appareils ME, transporte l'énergie AE et porte jusqu'à huit canaux sur chaque branche normale."
		""
		"Les appareils adjacents peuvent aussi se connecter directement. Dessine des branches lisibles et garde une couleur ou un trajet distinct pour les réseaux qui ne doivent pas fusionner."
		""
		"Le câble ne crée pas l'énergie : ajoute maintenant une entrée FE."
	]
	quest.511D1F4EC733FC8C.title: "La boucle vapeur"
	quest.511D1F4EC733FC8C.quest_subtitle: "Faire revenir l'eau au réacteur"
	quest.511D1F4EC733FC8C.quest_desc: [
		"Relie la sortie vapeur du réacteur à l'entrée de la turbine. Les composants de condensation de la turbine transforment ensuite la vapeur utilisée en eau."
		""
		"Ramène cette eau vers l'entrée froide du réacteur et ajoute un appoint contrôlé. Une boucle fermée réduit fortement le besoin d'alimentation extérieure."
		""
		"Valide lorsque débit, vitesse du rotor et niveau de fluide restent stables pendant plusieurs minutes."
	]
	quest.513F7EBC5AA32D8B.title: "Le guide draconique"
	quest.513F7EBC5AA32D8B.quest_subtitle: "Lire les structures avant de manipuler leur énergie"
	quest.513F7EBC5AA32D8B.quest_desc: [
		"L'Information Tablet ouvre le guide intégré de Draconic Evolution. Il décrit les recettes de fusion, les cristaux d'énergie, les modules et les grands multiblocs."
		""
		"Consulte-le dès qu'une structure affiche une erreur : son schéma est plus fiable qu'une ancienne vidéo d'une autre version."
		""
		"Cette branche commence à haut coût ; prépare d'abord une production d'énergie stable."
	]
	quest.521196B1E4C70473.title: "Premier Certus"
	quest.521196B1E4C70473.quest_subtitle: "Prélever les cristaux sans condamner la géode"
	quest.521196B1E4C70473.quest_desc: [
		"Le Certus Quartz pousse dans les géodes d'AE2. Récolte les buds arrivés à maturité, mais évite de casser les Flawless Budding Certus Quartz : ils produisent de nouveaux cristaux sans s'épuiser."
		""
		"Marque la géode et aménage un accès propre. Une source renouvelable de Certus devient plus importante que quelques cristaux obtenus immédiatement."
		""
		"Ces premiers cristaux servent au Charger, aux câbles et à presque toute l'électronique ME."
	]
	quest.54E0BCA8A3D0EE7A.title: "Réécrire la matière"
	quest.54E0BCA8A3D0EE7A.quest_subtitle: "Le Nucleosynthesizer réalise les transmutations finales"
	quest.54E0BCA8A3D0EE7A.quest_desc: [
		"L'Antiprotonic Nucleosynthesizer combine Antimatter, énergie et un objet d'entrée pour produire les ressources de ses recettes de transmutation."
		""
		"Branche un tank d'Antimatter, une alimentation capable de soutenir le cycle et des inventaires filtrés. Teste d'abord une recette clairement identifiée dans JEI."
		""
		"Cette machine clôt Mekanism : elle transforme une infrastructure complète, pas un simple minerai, en matière rare."
	]
	quest.556916510241852E.title: "Du liquide au gaz"
	quest.556916510241852E.quest_subtitle: "Le Rotary Condensentrator change l'état d'une substance"
	quest.556916510241852E.quest_desc: [
		"Le Rotary Condensentrator convertit certains fluides en produits chimiques et inversement. Son mode Condensentrating ou Decondensentrating fixe le sens de la transformation."
		""
		"Vérifie le mode avant de connecter les conduites, puis teste avec la recette indiquée par JEI. Les faces fluides et chimiques utilisent des réseaux différents."
		""
		"Il intervient notamment dans les chaînes de Water Vapor, Lithium, fusion et refroidissement."
	]
	quest.5714343BE8C291D3.title: "Scinder l'eau"
	quest.5714343BE8C291D3.quest_subtitle: "Produire Oxygen et Hydrogen en parallèle"
	quest.5714343BE8C291D3.quest_desc: [
		"L'Electrolytic Separator consomme eau et énergie pour produire Oxygen et Hydrogen sur deux sorties chimiques distinctes."
		""
		"Relie chaque côté à son propre tank ou active un mode de rejet contrôlé sur le gaz excédentaire. Si une sortie se remplit, toute la machine s'arrête."
		""
		"Conserve l'Oxygen pour le triplement des minerais et l'Hydrogen pour l'éthylène ou la chimie suivante."
	]
	quest.5775AF7086B66BBF.title: "Retraiter les déchets"
	quest.5775AF7086B66BBF.quest_subtitle: "Le Cyanite devient un combustible de palier supérieur"
	quest.5775AF7086B66BBF.quest_desc: [
		"Le réacteur transforme progressivement le Yellorium en Cyanite. Le Reprocessor convertit ce déchet avec le fluide demandé par son guide afin d'obtenir du Blutonium."
		""
		"Construis le multibloc de retraitement selon le schéma intégré, avec son Controller, ses casings et ses ports. Prévois des inventaires séparés pour l'entrée et la sortie."
		""
		"Le Blutonium réintègre la chaîne comme combustible et composant avancé."
	]
	quest.57B200F99EE6F5FB.title: "Verre de quartz"
	quest.57B200F99EE6F5FB.quest_subtitle: "La base isolante des câbles ME"
	quest.57B200F99EE6F5FB.quest_desc: [
		"Le Quartz Glass combine poussière de quartz et verre pour former l'enveloppe utilisée par les câbles et plusieurs appareils AE2."
		""
		"Fabrique la quantité demandée puis consulte JEI pour choisir entre Certus Quartz Dust et Nether Quartz Dust selon tes réserves."
		""
		"Il mène immédiatement aux Fluix Glass Cables : ne le considère pas comme un objectif de stockage."
	]
	quest.580B96D121DEC345.title: "Travailler en parallèle"
	quest.580B96D121DEC345.quest_subtitle: "Accélérer le CPU sans masquer un blocage"
	quest.580B96D121DEC345.quest_desc: [
		"Le Crafting Accelerator rejoint le multibloc du CPU et permet de traiter davantage d'opérations en parallèle lorsque le montage et les machines le permettent."
		""
		"Ajoute-le après avoir réussi une commande simple. Une accélération ne résout ni un ingrédient absent, ni une sortie de machine mal configurée."
		""
		"Surveille la consommation d'énergie avant de multiplier les accélérateurs et les assemblers."
	]
	quest.58C962C2148F410E.title: "Matériaux de base"
	quest.58C962C2148F410E.quest_subtitle: "Préparer l'acier énergisé et l'isolation diélectrique"
	quest.58C962C2148F410E.quest_desc: [
		"Energized Steel et Dielectric Paste sont les composants communs des premiers générateurs, câbles et Energizing Rods."
		""
		"Fabrique seulement la quantité nécessaire à l'Energizing Orb et à ses quatre rods. Les paliers suivants réutilisent cette infrastructure au lieu d'exiger un nouvel atelier."
		""
		"JEI fournit les quantités ; la prochaine quête explique comment la recette énergisée fonctionne."
	]
	quest.5A3D81440C679346.title: "Faire les calculs"
	quest.5A3D81440C679346.quest_subtitle: "Le processeur du stockage et de la capacité"
	quest.5A3D81440C679346.quest_desc: [
		"Imprime un Certus Quartz Crystal pur avec la Calculation Processor Press, puis assemble le circuit comme les autres processeurs."
		""
		"Les Calculation Processors entrent dans les composants de cellules et plusieurs appareils de gestion. Ils ouvrent directement la première cellule de stockage."
		""
		"Garde une chaîne d'Inscriber reproductible : AE2 en demandera régulièrement."
	]
	quest.5AE974DEC8043286.title: "Prévoir les déchets"
	quest.5AE974DEC8043286.quest_subtitle: "Stocker sans casser ni téléporter la radioactivité"
	quest.5AE974DEC8043286.quest_desc: [
		"Les Radioactive Waste Barrels reçoivent Nuclear Waste et autres déchets compatibles par Pressurized Tubes. Place-les dans une zone protégée, éloignée des passages."
		""
		"Les déchets radioactifs ne passent pas par les Quantum Entangloporters. Ne casse jamais un barrel ou un tube plein : vide ou traite la ligne avant toute modification."
		""
		"Installe plusieurs barils et vérifie leur capacité avant d'allumer le réacteur."
	]
	quest.5DA01F9529CE0EB6.title: "Cellule de stockage"
	quest.5DA01F9529CE0EB6.quest_subtitle: "Un inventaire numérique amovible"
	quest.5DA01F9529CE0EB6.quest_desc: [
		"La 1k ME Item Storage Cell stocke les objets insérés dans un réseau et peut être déplacée entre Drives. Elle n'est lisible qu'à travers un appareil ME."
		""
		"Une petite cellule convient aux ressources variées en faible quantité. Utilise un Cell Workbench plus tard pour la partitionner lorsqu'elle doit accepter seulement certains objets."
		""
		"Insère-la dans un ME Drive avant de déposer quoi que ce soit."
	]
	quest.5DEECE240E38D481.title: "Compresser la matière"
	quest.5DEECE240E38D481.quest_subtitle: "Transformer les surplus en matière quantique"
	quest.5DEECE240E38D481.quest_desc: [
		"Le Matter Condenser détruit les objets ou fluides envoyés et accumule leur matière. Un composant de stockage détermine le mode et la capacité nécessaires au produit choisi."
		""
		"Insère le composant 64k demandé, lis l'interface puis alimente le Condenser avec une ressource renouvelable et contrôlée. Ne branche jamais un inventaire précieux sans filtre."
		""
		"L'objectif est de préparer une Singularity, pas de supprimer les déchets au hasard."
	]
	quest.5EA7C62A56830D5A.title: "Valoriser les déchets"
	quest.5EA7C62A56830D5A.quest_subtitle: "La lumière solaire transforme le Nuclear Waste"
	quest.5EA7C62A56830D5A.quest_desc: [
		"Le Solar Neutron Activator convertit le Nuclear Waste en Polonium lorsqu'il voit le ciel et reçoit assez de lumière. La production s'arrête la nuit ou sous un toit."
		""
		"Transporte le déchet par tubes radioactifs, stocke le Polonium dans une ligne dédiée puis suis JEI pour fabriquer un Polonium Pellet dans la PRC."
		""
		"Le Polonium ouvre le SPS ; garde aussi une voie sûre pour les sous-produits radioactifs."
	]
	quest.5F413FA88732F401.title: "Le Chargeur"
	quest.5F413FA88732F401.quest_subtitle: "Donner au Certus l'état nécessaire au Fluix"
	quest.5F413FA88732F401.quest_desc: [
		"Le Charger transforme un Certus Quartz Crystal ordinaire en Charged Certus Quartz. Insère le cristal dans sa fente et fournis-lui de l'énergie AE."
		""
		"Au tout début, une Wooden Crank permet de l'actionner manuellement ; plus tard, relie-le au réseau alimenté par un Energy Acceptor."
		""
		"Ne charge que ce dont tu as besoin avant d'avoir automatisé la production."
	]
	quest.6063E644783AAA1F.title: "Passer en actif"
	quest.6063E644783AAA1F.quest_subtitle: "Produire de la vapeur au lieu de la FE directe"
	quest.6063E644783AAA1F.quest_desc: [
		"Un réacteur à refroidissement actif utilise des Fluid Ports et un liquide de refroidissement pour produire un fluide chaud, généralement de la vapeur destinée à une turbine."
		""
		"Construis d'abord la version Reinforced demandée, identifie clairement l'entrée froide et la sortie chaude, puis garde le réacteur arrêté jusqu'à ce que les réservoirs et la turbine soient prêts."
		""
		"La chaleur n'est plus convertie directement en FE : la turbine devient une partie obligatoire de la centrale."
	]
	quest.648F0C6CB455D8ED.title: "Accepter l'énergie"
	quest.648F0C6CB455D8ED.quest_subtitle: "Convertir la FE en énergie AE"
	quest.648F0C6CB455D8ED.quest_desc: [
		"L'Energy Acceptor reçoit l'énergie FE des générateurs du pack et alimente le réseau AE connecté à ses faces."
		""
		"Branche une source stable et laisse une marge de production. Un réseau sous-alimenté éteint ses appareils et peut faire croire à tort à un problème de canaux."
		""
		"Une fois le Controller installé, celui-ci pourra également recevoir l'énergie du réseau."
	]
	quest.64D9EBB68DC7CCEF.title: "Supports vierges"
	quest.64D9EBB68DC7CCEF.quest_subtitle: "Préparer les instructions de l'autocraft"
	quest.64D9EBB68DC7CCEF.quest_desc: [
		"Les Blank Patterns deviennent des Crafting Patterns ou des Processing Patterns lorsqu'ils sont encodés."
		""
		"Le premier type décrit une recette de grille classique. Le second décrit une transformation externe, par exemple minerai entrant et lingots sortants d'une machine."
		""
		"Fabrique seulement quelques supports avant d'avoir construit le terminal qui les programme."
	]
	quest.6541B92F30357F2F.title: "Raffiner le draconium"
	quest.6541B92F30357F2F.quest_subtitle: "Le matériau commun de toute la technologie draconique"
	quest.6541B92F30357F2F.quest_desc: [
		"Transforme le Draconium Dust extrait en Draconium Ingots. Cette ressource sert aux cores, machines et structures de tous les paliers du mod."
		""
		"Utilise JEI pour la méthode de traitement disponible dans ta base ; les chaînes industrielles peuvent améliorer le rendement par rapport à une simple cuisson."
		""
		"Les premiers lingots doivent servir au Draconium Core plutôt qu'à une réserve sans fonction."
	]
	quest.655A1785DDF6F42B.title: "Penser logique"
	quest.655A1785DDF6F42B.quest_subtitle: "Le processeur des appareils courants"
	quest.655A1785DDF6F42B.quest_desc: [
		"Imprime de l'or avec la Logic Processor Press, prépare du Printed Silicon, puis assemble les deux avec de la Redstone dans l'Inscriber."
		""
		"Les Logic Processors servent notamment aux terminaux et à de nombreux blocs d'interface. Produis-en quelques-uns, pas une réserve sans limite."
		""
		"L'objectif est de maîtriser le cycle d'impression complet."
	]
	quest.6832F811F080F86A.title: "Transformer la chaleur"
	quest.6832F811F080F86A.quest_subtitle: "Le Heat Generator alimente le premier atelier"
	quest.6832F811F080F86A.quest_desc: [
		"Le Heat Generator produit de la FE avec un combustible dans son interface et peut aussi exploiter la chaleur de la lave placée autour de lui."
		""
		"Branche un Basic Universal Cable vers une machine ou un stockage et observe la production. Une installation passive est lente mais utile comme secours."
		""
		"Valide après avoir réellement extrait de l'énergie du générateur."
	]
	quest.699A9D688B56A058.title: "Biomasse sous pression"
	quest.699A9D688B56A058.quest_subtitle: "La PRC transforme le Bio Fuel en Ethylene"
	quest.699A9D688B56A058.quest_desc: [
		"La Pressurized Reaction Chamber combine Bio Fuel, Hydrogen, eau et énergie pour produire de l'Ethylene ainsi qu'un sous-produit solide."
		""
		"Le Crusher fournit le Bio Fuel à partir de végétaux. Branche séparément l'eau et l'Hydrogen, puis évacue les deux sorties afin qu'aucune ne bloque le cycle."
		""
		"L'Ethylene peut alimenter un Gas-Burning Generator très efficace."
	]
	quest.6AFF931F0836D86B.title: "La Turbine"
	quest.6AFF931F0836D86B.quest_subtitle: "Transformer un débit de vapeur en énergie"
	quest.6AFF931F0836D86B.quest_desc: [
		"Construis l'enveloppe de Turbine avec Controller, Rotor Bearing, Rotor Shafts, Blades et Power Tap. Les coils placés à l'extrémité du rotor extraient l'énergie de la rotation."
		""
		"Le rotor doit être continu entre le Bearing et l'autre extrémité, avec des pales correctement réparties. Consulte le guide intégré pour les dimensions et matériaux de coils disponibles."
		""
		"Ne connecte la vapeur qu'après validation visuelle du multibloc."
	]
	quest.6D69D265C2D4C77F.title: "Trois lingots par minerai"
	quest.6D69D265C2D4C77F.quest_subtitle: "Ajouter l'Oxygen à la chaîne de traitement"
	quest.6D69D265C2D4C77F.quest_desc: [
		"La Purification Chamber combine minerai et Oxygen pour produire des Clumps, généralement trois par unité. Le Crusher transforme ensuite les Clumps en Dirty Dust."
		""
		"Fais suivre Enrichment Chamber puis Energized Smelter pour obtenir les lingots. Configure une sortie chimique stable et laisse un tank tampon d'Oxygen."
		""
		"Valide avec un minerai parcourant les quatre machines sans intervention manuelle."
	]
	quest.6E52786A71265180.title: "Ferme à mobs"
	quest.6E52786A71265180.quest_subtitle: "Configurer un Powered Spawner et maîtriser sa sortie"
	quest.6E52786A71265180.quest_desc: [
		"Le Powered Spawner crée la créature définie par son composant lié à une âme. Il demande de l'énergie et doit être intégré à une chambre de mise à mort contrôlée."
		""
		"Avant l'activation, ferme la zone, prévois collecte des objets et arrêt redstone, puis vérifie les règles serveur concernant le mob choisi."
		""
		"Valide après un cycle complet : apparition, élimination, récupération et arrêt de sécurité."
	]
	quest.6F6D264AE81C9C48.title: "L'Orbe Énergisante"
	quest.6F6D264AE81C9C48.quest_subtitle: "Les rods projettent l'énergie vers la recette"
	quest.6F6D264AE81C9C48.quest_desc: [
		"Place l'Energizing Orb puis jusqu'à quatre Basic Energizing Rods alimentés dans une zone de 9 x 9 autour. Les rods doivent avoir une ligne de travail valide vers l'orbe."
		""
		"Dépose les ingrédients dans l'Orb selon JEI : les rods transfèrent l'énergie jusqu'à atteindre le coût de la recette. Davantage de rods augmente le débit, pas la capacité du réseau amont."
		""
		"Teste un craft Basic complet avant d'automatiser l'entrée et la sortie."
	]
	quest.6FAEE5BE84BED3A6.title: "Thermoélectricité"
	quest.6FAEE5BE84BED3A6.quest_subtitle: "Un bloc chaud dessous, un coolant dans la machine"
	quest.6FAEE5BE84BED3A6.quest_desc: [
		"Le Thermo Generator produit de l'énergie lorsqu'il est posé sur une source de chaleur valide et contient un coolant, généralement de l'eau au premier palier."
		""
		"Compare les blocs chauds dans le guide Powah ; les plus efficaces augmentent la production. Maintiens le coolant disponible et place la machine hors des zones inflammables."
		""
		"Le Dry Ice deviendra un choix important pour refroidir les réacteurs des paliers élevés."
	]
	quest.701FF8F20819795E.title: "Injecteurs Wyvern"
	quest.701FF8F20819795E.quest_subtitle: "Augmenter le palier des recettes de fusion"
	quest.701FF8F20819795E.quest_desc: [
		"Remplace ou complète les injecteurs Basic par quatre Wyvern Crafting Injectors. Leur palier autorise des recettes plus avancées et des besoins énergétiques supérieurs."
		""
		"Tous les injecteurs utilisés par une recette doivent respecter son palier minimal. Conserve les anciens pour un second atelier ou les crafts simples."
		""
		"Vérifie le débit de ton réseau avant d'enchaîner plusieurs fusions."
	]
	quest.705B2F05995A000F.title: "Premier composant de cellule"
	quest.705B2F05995A000F.quest_subtitle: "La capacité qui sera enfermée dans une cellule"
	quest.705B2F05995A000F.quest_desc: [
		"Le 1k ME Storage Component est le cœur d'une petite cellule. Il définit sa capacité en octets, tandis que le nombre de types d'objets stockés utilise aussi cette capacité."
		""
		"Fabrique-le pour comprendre la hiérarchie 1k, 4k, 16k et 64k. Les composants supérieurs remplacent plusieurs petites cellules lorsqu'un stock grossit."
		""
		"Transforme immédiatement ce composant en cellule utilisable."
	]
	quest.71C300101B5F26F6.title: "L'Inscriber"
	quest.71C300101B5F26F6.quest_subtitle: "Imprimer puis assembler les processeurs"
	quest.71C300101B5F26F6.quest_desc: [
		"L'Inscriber utilise une presse et son matériau pour créer un circuit imprimé. Une seconde opération assemble ce circuit avec Printed Silicon et Redstone."
		""
		"Ses trois entrées ont des rôles distincts ; affiche les faces dans l'interface avant de l'automatiser. Une machine par recette simplifie fortement les grandes productions."
		""
		"Fabrique maintenant les trois processeurs afin d'ouvrir les branches du réseau."
	]
	quest.7260A13B23E12185.title: "L'Énergiseur"
	quest.7260A13B23E12185.quest_subtitle: "Concentrer la puissance dans un multibloc dédié"
	quest.7260A13B23E12185.quest_desc: [
		"L'Energizer forme un multibloc d'au moins 3 x 3 x 3 avec Controller, casings et Energy Core interne selon le guide d'Extreme Reactors."
		""
		"Construis-le à proximité d'un stockage capable de fournir son débit, puis vérifie la structure avant d'insérer un objet coûteux. Ses recettes consomment de grandes quantités d'énergie accumulée."
		""
		"Cette machine clôt la branche guidée ; agrandir la centrale dépend ensuite de la demande réelle de la base."
	]
	quest.7538AA5F80C639FE.title: "S'habiller pour survivre"
	quest.7538AA5F80C639FE.quest_subtitle: "La Hazmat Suit limite l'exposition radioactive"
	quest.7538AA5F80C639FE.quest_desc: [
		"Équipe les quatre pièces de Hazmat Suit avant de manipuler les machines, tubes ou déchets radioactifs. Une protection incomplète ne doit pas être considérée suffisante."
		""
		"Conserve un ensemble de secours dans une zone propre et accessible. La combinaison réduit le risque, mais ne rend pas acceptable la destruction d'un tube plein."
		""
		"Vérifie toujours le Geiger Counter avant de retirer l'équipement."
	]
	quest.75A92A73A17CA7A7.title: "Grains d'Infinité"
	quest.75A92A73A17CA7A7.quest_subtitle: "Le verrou singulier d'Ender IO"
	quest.75A92A73A17CA7A7.quest_desc: [
		"Les Grains of Infinity s'obtiennent par l'interaction indiquée par JEI avec du feu sur la Bedrock, généralement au fond du monde. Ils ouvrent les premières machines et alliages du mod."
		""
		"Aménage une zone sûre, sans bois ni stockage proche, et laisse plusieurs emplacements de Bedrock accessibles. La production peut être automatisée plus tard."
		""
		"Cette ressource garde une quête dédiée parce que son obtention ne ressemble pas à une recette ordinaire."
	]
	quest.77861D8D2442576C.title: "Distribuer l'énergie"
	quest.77861D8D2442576C.quest_subtitle: "Les Universal Cables relient toutes les machines FE"
	quest.77861D8D2442576C.quest_desc: [
		"Les Basic Universal Cables transportent la FE entre générateurs, stockages et machines. Leur palier limite le débit de chaque réseau connecté."
		""
		"Utilise le Configurator pour régler les connexions ou forcer une extraction si nécessaire. Les couleurs de réseau permettent d'éviter des jonctions involontaires."
		""
		"Teste huit câbles sur un trajet réel et vérifie que la machine reçoit assez d'énergie sous charge."
	]
	quest.77BC23D91687C968.title: "Capturer une âme"
	quest.77BC23D91687C968.quest_subtitle: "La Soul Vial identifie la créature à reproduire"
	quest.77BC23D91687C968.quest_desc: [
		"Utilise une Soul Vial vide sur une créature compatible pour capturer son type. Le Soul Binder transfère ensuite cette information dans les composants qui demandent une âme."
		""
		"Choisis une créature autorisée et utile avant de consommer de l'énergie et de l'expérience. Les boss et certaines entités spéciales refusent volontairement la capture."
		""
		"Teste le cycle sur un mob ordinaire avant de construire le Powered Spawner."
	]
	quest.7CB501BF16741158.title: "Stocker dans la matrice"
	quest.7CB501BF16741158.quest_subtitle: "L'Induction Cell détermine la capacité"
	quest.7CB501BF16741158.quest_desc: [
		"Place une Basic Induction Cell dans le volume intérieur de la Matrix. Plusieurs cells et des paliers supérieurs augmentent l'énergie totale stockable."
		""
		"La cellule ne touche pas les réseaux extérieurs directement : toute entrée et sortie passe par les Induction Ports de la coque."
		""
		"Ajoute ensuite un Provider pour que la matrice puisse accepter et restituer un débit utile."
	]
	quest.7D739878538EBF52.title: "Ingénierie avancée"
	quest.7D739878538EBF52.quest_subtitle: "Le diamant devient contrôle et calcul intensif"
	quest.7D739878538EBF52.quest_desc: [
		"Imprime un Diamond avec l'Engineering Processor Press puis assemble l'Engineering Processor dans l'Inscriber."
		""
		"Ce processeur coûte davantage, mais il est indispensable au Controller, aux unités de fabrication et aux infrastructures quantiques."
		""
		"Réserve les premiers exemplaires aux blocs qui débloquent un système complet."
	]
	quest.7DF5D46C60B325CF.title: "Cristaux avancés"
	quest.7DF5D46C60B325CF.quest_subtitle: "Faire évoluer le même atelier vers Niotic et Spirited"
	quest.7DF5D46C60B325CF.quest_desc: [
		"Les Niotic Crystals puis Spirited Crystals se fabriquent dans l'Energizing Orb avec les ingrédients et coûts indiqués par JEI."
		""
		"Améliore rods, cellules, câbles et générateurs seulement lorsque leur débit limite réellement le système. Les blocs de différents paliers restent compatibles mais conservent leurs propres limites."
		""
		"Produis quatre cristaux de chaque niveau pour les upgrades immédiats."
	]
	quest.7F21F24420700C68.title: "Infuser le métal"
	quest.7F21F24420700C68.quest_subtitle: "Ajouter une substance à un matériau de base"
	quest.7F21F24420700C68.quest_desc: [
		"Le Metallurgic Infuser combine un objet avec un type d'infusion, par exemple Redstone, Carbon ou Diamond selon la recette."
		""
		"Charge une petite quantité d'infusion, place le matériau dans l'entrée et récupère la sortie. Les produits enrichis augmentent le rendement de l'infusion lorsque la chaîne le permet."
		""
		"Évite de remplir entièrement le réservoir : deux types d'infusion incompatibles ne peuvent pas y cohabiter."
	]
	task.0284427A849024CD.title: "Faire fonctionner la chaîne de traitement x5"
	task.045FEC2E679A0CA6.title: "Vaincre l'Ender Dragon"
	task.09FD17D87083509F.title: "Réaliser une transmutation à l'antimatière"
	task.0A3C6A09FF73BF19.title: "Former une structure de fusion éveillée"
	task.0A7A000000020002.title: "Former un rectangle avec les marqueurs"
	task.0A7A000000030002.title: "Extraire les premiers blocs sans débordement"
	task.0A7A0000000C0002.title: "Tester une petite excavation"
	task.0A7A000000100002.title: "Excaver une zone avec modules actifs"
	task.0A7A000000120002.title: "Faire fonctionner la carrière avec son module"
	task.0F8E152359FBF46B.title: "Terminer une recette de fusion Wyvern"
	task.10B246618CEF7007.title: "Faire tourner une ferme à mobs automatisée"
	task.121AB7E5E1D21DF1.title: "Commander et terminer une fabrication automatique"
	task.12809DC5099DFE17.title: "Produire de l'énergie avec de l'éthylène"
	task.15F70EA8E20BFE49.title: "Alimenter une machine par cristal"
	task.1D2E5E8E83AB2358.title: "Relier deux zones avec le pont quantique"
	task.1F0A000000030002.title: "Extraire du latex d'une bûche"
	task.1F0A000000050002.title: "Alimenter l'unité en latex, eau et énergie"
	task.1F0A0000000C0002.title: "Faire fonctionner une boucle semis-récolte"
	task.1F0A0000000D0002.title: "Capturer une créature adaptée"
	task.1F0A0000000E0002.title: "Produire de la viande liquide et de la gelée rose"
	task.1F0A000000110002.title: "Collecter butin et essence d'une créature"
