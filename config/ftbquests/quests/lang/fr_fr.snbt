	task.5676C58E7CB0782B.title: "Former une tour d'évaporation thermique"
	task.5B909DC02255FF30.title: "Installer et alimenter ses modules essentiels"
	task.5D68A35C45DD2862.title: "Transférer un objet entre les deux tunnels"
	task.64FA5406C14C7E4C.title: "Stocker puis reprendre un objet dans le réseau"
	task.656C6E246C065A5B.title: "Faire produire une éolienne en altitude"
	task.667A1D13E170C814.title: "Allumer et stabiliser le Réacteur à fusion"
	task.6B17E096D60C4B87.title: "Atteindre le cube mystérieux"
	task.6DB1CE8BD67690A5.title: "Faire passer des canaux à travers le tunnel"
	task.778131F448631986.title: "Démarrer un réacteur passif complet"
	task.7E46888DECB0C3D6.title: "Former une structure de fusion basique"
	quest.0A71000000000001.quest_desc: [
		"Le Marqueur est la brique de base de tout QuarryPlus."
		""
		"Poudre de pierre lumineuse, lapis et torche de redstone. Toutes les machines et tous les modules du mod le réclament dans leur recette : fabriques-en large dès maintenant."
	]
	quest.0A71000000000001.quest_subtitle: "Niveau 1 / 5"
	quest.0A71000000000001.title: "Le Marqueur"
	quest.0A71000000000002.quest_desc: [
		"Le Marqueur flexible se règle à la main, hauteur comprise."
		""
		"Commence par une petite zone visible et vérifie chaque bord avant de poser la carrière. Un clic droit ouvre le réglage des dimensions."
	]
	quest.0A71000000000002.quest_subtitle: "Niveau 1 / 5"
	quest.0A71000000000002.title: "Délimiter une zone"
	quest.0A71000000000003.quest_desc: [
		"La Carrière excave toute la zone définie et laisse un trou permanent."
		""
		"Teste-la sur une petite surface, avec énergie et stockage surdimensionnés. La dimension minière est préférable aux grands chantiers."
	]
	quest.0A71000000000003.quest_subtitle: "Niveau 2 / 5"
	quest.0A71000000000003.title: "La première carrière"
	quest.0A71000000000004.quest_desc: [
		"Le Vérificateur d'état lit ce que fait une machine et où elle en est."
		""
		"Indispensable quand une carrière semble bloquée : il distingue un manque d'énergie d'un stockage plein."
	]
	quest.0A71000000000004.quest_subtitle: "Niveau 2 / 5"
	quest.0A71000000000004.title: "Vérifier l'état"
	quest.0A71000000000005.quest_desc: [
		"Le Régleur de Y fixe l'altitude à laquelle la carrière s'arrête."
		""
		"Évite de creuser jusqu'à la bedrock quand seule la couche des diamants t'intéresse. Gros gain de temps et d'énergie."
	]
	quest.0A71000000000005.quest_subtitle: "Niveau 2 / 5"
	quest.0A71000000000005.title: "Régler la profondeur"
	quest.0A71000000000006.quest_desc: [
		"Le Module de pompe évacue les fluides rencontrés pendant l'excavation."
		""
		"Sans lui, une nappe de lave ou un océan noie le chantier et bloque la machine. C'est le premier module à installer."
	]
	quest.0A71000000000006.quest_subtitle: "Niveau 3 / 5"
	quest.0A71000000000006.title: "Module de pompe"
	quest.0A71000000000007.quest_desc: [
		"Le Module de filtre choisit ce que la carrière ramasse et ce qu'elle laisse."
		""
		"Écarte la pierre et la terre : ton réseau de stockage te remerciera. Il se configure avec un livre écrit."
	]
	quest.0A71000000000007.quest_subtitle: "Niveau 3 / 5"
	quest.0A71000000000007.title: "Module de filtre"
	quest.0A71000000000008.quest_desc: [
		"Le Module d'expérience collecte les orbes libérées par l'extraction."
		""
		"L'expérience s'accumule dans la machine et se récupère à la demande. Pratique avec un module anti-bedrock qui casse énormément de blocs."
	]
	quest.0A71000000000008.quest_subtitle: "Niveau 3 / 5"
	quest.0A71000000000008.title: "Module d'expérience"
	quest.0A71000000000009.quest_desc: [
		"Le Module de répétition fait travailler la machine plusieurs fois par tick."
		""
		"La vitesse monte, la consommation d'énergie aussi. À réserver aux installations déjà bien alimentées."
	]
	quest.0A71000000000009.quest_subtitle: "Niveau 3 / 5"
	quest.0A71000000000009.title: "Accélérer l'extraction"
	quest.0A7100000000000A.quest_desc: [
		"Le Déplaceur transfère les enchantements d'un outil vers une machine."
		""
		"C'est ainsi qu'on donne Fortune ou Toucher de soie à une carrière. Prépare une pioche enchantée avant de le poser."
	]
	quest.0A7100000000000A.quest_subtitle: "Niveau 3 / 5"
	quest.0A7100000000000A.title: "Déplacer les enchantements"
	quest.0A7100000000000B.quest_desc: [
		"Le Module anti-bedrock autorise l'extraction de la roche-mère."
		""
		"Il ouvre le fond du monde. Attention dans le Nether : sous la bedrock il n'y a que le vide."
	]
	quest.0A7100000000000B.quest_subtitle: "Niveau 4 / 5"
	quest.0A7100000000000B.title: "Percer la bedrock"
	quest.0A7100000000000C.quest_desc: [
		"Le Marqueur de chunk aligne automatiquement la zone sur les limites du chunk."
		""
		"Bien plus rapide que de poser des marqueurs à la main, et la zone tombe juste avec le chargement de chunks."
	]
	quest.0A7100000000000C.quest_subtitle: "Niveau 4 / 5"
	quest.0A7100000000000C.title: "Marquer un chunk entier"
	quest.0A7100000000000D.quest_desc: [
		"Le Placeur pose des blocs depuis son inventaire."
		""
		"Il sert à reboucher derrière une carrière, ou à automatiser la pose de n'importe quel bloc."
	]
	quest.0A7100000000000D.quest_subtitle: "Niveau 4 / 5"
	quest.0A7100000000000D.title: "Le Placeur"
	quest.0A7100000000000E.quest_desc: [
		"Le Placeur distant agit à plusieurs blocs de lui."
		""
		"Sa portée se règle dans son interface. Utile pour intervenir dans une zone déjà excavée."
	]
	quest.0A7100000000000E.quest_subtitle: "Niveau 4 / 5"
	quest.0A7100000000000E.title: "Placer à distance"
	quest.0A7100000000000F.quest_desc: [
		"La Pompe avancée vide un océan entier et fonctionne de façon autonome."
		""
		"Elle remplace le module de pompe quand tu passes à l'échelle industrielle."
	]
	quest.0A7100000000000F.quest_subtitle: "Niveau 5 / 5"
	quest.0A7100000000000F.title: "La Pompe avancée"
	quest.0A71000000000010.quest_desc: [
		"La Carrière avancée est la machine ultime du mod : elle ne laisse aucun trou."
		""
		"Étoile du Nether, tête de dragon et blocs de diamant et d'émeraude. Elle accepte tous les modules à la fois."
	]
	quest.0A71000000000010.quest_subtitle: "Niveau 5 / 5"
	quest.0A71000000000010.title: "La Carrière avancée"
	quest.65C2C00000000001.title: "Fondations mécaniques"
	quest.65C2C00000000001.quest_subtitle: "Produire, transmettre et utiliser une rotation"
	quest.65C2C00000000001.quest_desc: [
		"Construis un premier atelier Create avec une Water Wheel, une Mechanical Press, un Mechanical Mixer et son Basin. Ces blocs couvrent la production de rotation et les deux traitements de base."
		""
		"Relie-les avec shafts, cogwheels ou belts, puis vérifie dans les lunettes de Create que le réseau n'est pas overstressed. Une machine posée mais non alimentée ne constitue pas un atelier."
		""
		"Utilise Ponder sur chaque bloc si son sens de rotation ou sa géométrie n'est pas clair."
	]
	quest.65C2200000000003.title: "Le Nether"
	quest.65C2200000000003.quest_subtitle: "Huit blocs pour un"
	quest.65C2200000000003.quest_desc: [
		"Sécurise d'abord le point d'arrivée avec un sol fermé, un éclairage visible et une protection contre les projectiles."
		""
		"Un bloc parcouru dans le Nether correspond à environ huit blocs dans l'Overworld. Cette échelle transforme les galeries ou trains protégés en véritables routes interrégionales."
		""
		"Repère ensuite une forteresse : les Blazes et les verrues du Nether ouvrent l'alchimie, les Eyes of Ender et plusieurs crafts de mods."
	]
	quest.65C2200000000006.title: "Chercher le Stronghold"
	quest.65C2200000000006.quest_subtitle: "Suivre les Eyes of Ender sans les gaspiller"
	quest.65C2200000000006.quest_desc: [
		"Fabrique plusieurs Eyes of Ender avec Ender Pearls et Blaze Powder, puis lance-en un depuis deux positions éloignées pour recouper la direction du Stronghold."
		""
		"Un œil peut se briser après son lancer. Prévois-en assez pour la recherche et pour remplir les emplacements manquants du portail."
		""
		"Quand la trajectoire commence à revenir derrière toi, creuse prudemment en escalier plutôt qu'à la verticale."
	]
	quest.65C2200000000007.title: "L'End"
	quest.65C2200000000007.quest_subtitle: "Un aller simple jusqu'à la victoire"
	quest.65C2200000000007.quest_desc: [
		"Le portail du Stronghold débouche sur l'île centrale. Le retour normal reste fermé tant que l'Ender Dragon vit."
		""
		"Emporte des blocs, de la nourriture, un arc et un moyen de ralentir une chute. Pose un coffre près du portail avant d'insérer le dernier œil."
		""
		"Ne pars pas immédiatement vers les îles extérieures : commence par dégager une zone sûre et observer les cristaux qui soignent le Dragon."
	]
	quest.65C2200000000008.title: "Le Dragon de l'End"
	quest.65C2200000000008.quest_subtitle: "Briser les cristaux, attendre l'ouverture"
	quest.65C2200000000008.quest_desc: [
		"Détruis les End Crystals au sommet des piliers pour couper les soins du Dragon. Les cages exigent de grimper ou de tirer à travers une ouverture."
		""
		"Évite de rester dans le souffle violet et garde tes attaques de mêlée pour les phases où le Dragon se pose au centre."
		""
		"Sa défaite ouvre les gateways vers les îles extérieures, les Elytras et plusieurs contenus de fin de jeu. Elle peut aussi produire un unique Simply Swords, volontairement rare."
	]
	quest.65C2400000000001.title: "Construire un style de combat"
	quest.65C2400000000001.quest_subtitle: "Une intention avant une collection de bonus"
	quest.65C2400000000001.quest_desc: [
		"Ascendant combine armes, sorts, compétences et affixes. Leur valeur vient des synergies, pas du nombre de systèmes empilés."
		""
		"Choisis d'abord une portée et un rythme : mêlée mobile, arme lourde, distance ou magie. Compare ensuite les attributs qui servent réellement ce choix."
		""
		"Teste ton équipement sur des ennemis ordinaires avant de dépenser des matériaux rares ou d'affronter un boss."
	]
	quest.65C2400000000002.title: "Mobilité et rythme"
	quest.65C2400000000002.quest_subtitle: "Attaquer, se replacer, recommencer"
	quest.65C2400000000002.quest_desc: [
		"Better Combat donne aux armes des enchaînements et des portées distinctes ; Combat Roll ajoute une esquive avec son propre tempo."
		""
		"Sur clavier AZERTY, vérifie les touches dans les contrôles avant un donjon. Garde l'esquive près des déplacements et évite de lui attribuer une touche déjà utilisée par la carte ou la voix."
		""
		"Apprends surtout quand interrompre une série d'attaques : survivre à un boss demande souvent de renoncer au dernier coup."
	]
	quest.65C2400000000003.title: "Compétences RPG"
	quest.65C2400000000003.quest_subtitle: "Renforcer une boucle de jeu cohérente"
	quest.65C2400000000003.quest_desc: [
		"Les arbres de compétences spécialisent progressivement le personnage. Une amélioration modeste mais souvent déclenchée vaut mieux qu'un bonus spectaculaire hors de ton style."
		""
		"Commence par les nœuds qui soutiennent ta survie et ton type de dégâts, puis observe leur effet en combat avant d'ouvrir une seconde branche."
		""
		"Les choix ne doivent pas empêcher l'expérimentation : garde une marge pour adapter ton build aux équipements trouvés."
	]
	quest.65C2400000000004.title: "Le carnet d'Ars Nouveau"
	quest.65C2400000000004.quest_subtitle: "La magie comme langage à composer"
	quest.65C2400000000004.quest_desc: [
		"Le Worn Notebook est le manuel vivant d'Ars Nouveau. Il décrit les glyphes, la Source, les appareils et les créatures auxiliaires avec les règles exactes de la version installée."
		""
		"Consulte-le dès qu'une quête demande une géométrie ou une interaction difficile à montrer dans JEI. Le chapitre annexe propose un parcours court pour mettre ces notions en pratique."
		""
		"Ars Nouveau excelle autant dans la mobilité et l'utilitaire que dans les dégâts."
	]
	quest.65C2400000000005.title: "Composer un sort"
	quest.65C2400000000005.quest_subtitle: "Forme, effet, puis augmentations"
	quest.65C2400000000005.quest_desc: [
		"Un sort commence par une forme, comme Projectile ou Touch, suivie d'un effet et éventuellement d'augmentations."
		""
		"Crée d'abord une formule simple répondant à un besoin précis : produire une lumière, casser un bloc, se déplacer ou contrôler un ennemi. Vérifie son coût en mana avant d'ajouter de la puissance."
		""
		"Le Scribe's Table du chapitre Ars Nouveau permet ensuite d'apprendre les glyphes qui élargissent ce vocabulaire."
	]
	quest.65C2400000000006.title: "Un premier grimoire"
	quest.65C2400000000006.quest_subtitle: "Des sorts trouvés dans le monde"
	quest.65C2400000000006.quest_desc: [
		"Iron's Spells 'n Spellbooks adopte une progression de RPG : les parchemins se trouvent dans les structures, sur les mages et dans leurs coffres."
		""
		"Le Flimsy Journal offre peu d'emplacements, mais suffit pour apprendre le fonctionnement des sorts. Place ensuite les parchemins utiles dans le livre avec une Inscription Table."
		""
		"La rareté du grimoire limite les sorts qu'il peut accueillir ; l'exploration reste donc au cœur de la montée en puissance."
	]
	quest.65C2400000000007.title: "Équiper ses sorts"
	quest.65C2400000000007.quest_subtitle: "Un grimoire, une école, une réserve de mana"
	quest.65C2400000000007.quest_desc: [
		"Inscris plusieurs sorts complémentaires plutôt que des variantes du même projectile : dégâts, contrôle, défense et mobilité couvrent davantage de situations."
		""
		"Les armures, bijoux et bâtons renforcent certaines écoles ou réduisent le temps de lancement. Lis leurs attributs avant de choisir un ensemble."
		""
		"Le chapitre Iron's Spells explique ensuite comment fabriquer des parchemins et atteindre les Catacombes."
	]
	quest.65C2400000000008.title: "Arsenal, Armory et Relics"
	quest.65C2400000000008.quest_subtitle: "Trois familles, trois usages"
	quest.65C2400000000008.quest_desc: [
		"Arsenal fournit des armes liées aux classes, Armory fait évoluer des ensembles d'armure et Relics ajoute des objets rares aux comportements particuliers."
		""
		"Ces équipements complètent la campagne ; ils ne sont pas des clés obligatoires. Compare leurs effets avec ton build avant de remplacer une pièce déjà cohérente."
		""
		"Les récompenses personnelles de boss donnent des matériaux et utilitaires, jamais une seconde copie automatique d'une arme rare."
	]
	quest.65C2400000000009.title: "Reforger sans tout écraser"
	quest.65C2400000000009.quest_subtitle: "Changer les affixes avec intention"
	quest.65C2400000000009.quest_desc: [
		"La Reforging Table d'Apotheosis transforme une pièce compatible en proposant de nouveaux ensembles d'affixes."
		""
		"Ne reroule pas une bonne pièce sans réserve de matériaux et sans objectif d'attribut. La Salvaging Table permet justement de recycler le butin inutile en ressources de rareté."
		""
		"Les armes signatures de Cataclysm et certains équipements technologiques restent volontairement hors de ce système."
	]
	quest.65C240000000000A.title: "Prêt à explorer"
	quest.65C240000000000A.quest_subtitle: "Un build testé, une voie de retour préparée"
	quest.65C240000000000A.quest_desc: [
		"Tu disposes maintenant des bases pour construire un style de combat et comprendre les équipements rencontrés."
		""
		"Prépare nourriture, soins, blocs, outil de repli et place libre dans le sac. Répare avant de partir plutôt qu'au pied de l'arène."
		""
		"Twilight Forest est le premier chapitre conseillé. Les deux écoles de magie restent disponibles comme campagnes annexes indépendantes."
	]
	quest.65C2800000000006.title: "Le Scribe's Table"
	quest.65C2800000000006.quest_subtitle: "Transformer des ressources en vocabulaire magique"
	quest.65C2800000000006.quest_desc: [
		"Utilise ton grimoire sur la table pour ouvrir le codex, choisis un glyphe, puis dépose les ingrédients affichés au-dessus du bloc. L'apprentissage consomme aussi de l'expérience."
		""
		"La table peut prendre les objets dans les inventaires voisins. Une Dominion Wand permet de désactiver cette collecte automatique si elle gêne ton rangement."
		""
		"Les recettes exactes restent visibles dans le carnet et JEI ; choisis d'abord des glyphes répondant à un besoin réel."
	]
	quest.65C2800000000002.title: "Imprégner la matière"
	quest.65C2800000000002.quest_subtitle: "Des cristaux ordinaires aux Source Gems"
	quest.65C2800000000002.quest_desc: [
		"L'Imbuement Chamber transforme notamment Lapis Lazuli ou Amethyst en Source Gems, base de nombreuses recettes du mod."
		""
		"Pose l'objet dans la chambre et laisse-la accumuler lentement la Source. Des Source Jars placés à moins de deux blocs accélèrent les recettes qui en consomment."
		""
		"Certaines imprégnations demandent des objets sur des Arcane Pedestals voisins ; ces catalyseurs ne sont pas toujours consommés."
	]
	quest.65C2800000000003.title: "Stocker la Source"
	quest.65C2800000000003.quest_subtitle: "Donner une réserve aux machines magiques"
	quest.65C2800000000003.quest_desc: [
		"Le Source Jar reçoit l'énergie produite par les Sourcelinks et l'offre aux appareils proches, aux rituels et aux auxiliaires magiques."
		""
		"Place les jarres à portée de la future zone de travail plutôt que de les disperser. Un comparateur peut lire leur niveau pour automatiser plus tard les seuils de production."
		""
		"Une jarre vide ne produit rien seule : construis maintenant un premier Sourcelink."
	]
	quest.65C2800000000007.title: "Une Source renouvelable"
	quest.65C2800000000007.quest_subtitle: "L'Agronomic Sourcelink observe ce qui pousse"
	quest.65C2800000000007.quest_desc: [
		"L'Agronomic Sourcelink génère de la Source lorsque des cultures ou des arbres poussent naturellement dans un rayon de quinze blocs."
		""
		"Pose un Source Jar à moins de cinq blocs du Sourcelink et aménage une petite ferme autour. Magebloom, Source Berries et jeunes Archwood donnent un meilleur rendement."
		""
		"La poudre d'os ne déclenche pas cette production : teste le système avec une croissance naturelle et vérifie que la jarre se remplit."
	]
	quest.65C2800000000004.title: "L'appareil d'enchantement"
	quest.65C2800000000004.quest_subtitle: "Un objet central, des ingrédients disposés autour"
	quest.65C2800000000004.quest_desc: [
		"L'Enchanting Apparatus réalise les crafts avancés en puisant de la Source. Il exige un Arcane Core contre sa base et des Arcane Pedestals dans un rayon de trois blocs."
		""
		"Dépose les ingrédients secondaires sur les piédestaux, puis utilise l'objet central sur l'appareil. Leur ordre autour de la machine n'a pas d'importance."
		""
		"Laisse de la place pour ajouter des piédestaux et relier plusieurs jarres : les recettes de haut niveau consomment davantage de Source."
	]
	quest.65C2800000000008.title: "Le grimoire du mage"
	quest.65C2800000000008.quest_subtitle: "Plus de glyphes, plus de choix à chaque lancement"
	quest.65C2800000000008.quest_desc: [
		"Le Mage's Spell Book élargit les possibilités du grimoire novice et donne accès à une magie plus complexe."
		""
		"Avant de l'adopter, organise tes formules par rôle et garde au moins un sort peu coûteux. Les augmentations se lisent de gauche à droite et modifient le dernier effet compatible."
		""
		"Le palier supérieur n'est pas une obligation immédiate : un bon sort utilitaire reste utile pendant toute la partie."
	]
	quest.65C2800000000009.title: "Un sort devient machine"
	quest.65C2800000000009.quest_subtitle: "Automatiser avec un Basic Spell Turret"
	quest.65C2800000000009.quest_desc: [
		"Le Basic Spell Turret lance, sur signal redstone, un sort inscrit sur un Spell Parchment. Il accepte notamment les formes Touch et Projectile."
		""
		"Inscris une formule simple avec le Scribe's Table, alimente la tourelle depuis une Source Jar proche et déclenche-la avec un levier. Un inventaire adjacent permet aux glyphes de prise ou de pose d'objets d'interagir avec des ressources."
		""
		"Teste d'abord une action sans danger : lumière, récolte ou placement contrôlé."
	]
	quest.65C2800000000005.title: "Une magie d'infrastructure"
	quest.65C2800000000005.quest_subtitle: "Relier Source, sorts et automatisation"
	quest.65C2800000000005.quest_desc: [
		"Ton atelier sait maintenant apprendre des glyphes, produire de la Source, fabriquer des artefacts et répéter un sort automatiquement."
		""
		"Le Worn Notebook ouvre ensuite plusieurs spécialisations : rituels, familiers, transport de Source et auxiliaires comme Starbuncle ou Drygmy."
		""
		"Poursuis celle qui résout un problème de ta base ; Ars Nouveau récompense davantage l'invention que l'accumulation de machines."
	]
	quest.65C2900000000001.title: "La table d'inscription"
	quest.65C2900000000001.quest_subtitle: "Faire d'un parchemin un sort réutilisable"
	quest.65C2900000000001.quest_desc: [
		"Les parchemins sont des sorts portables : ils peuvent être lancés une fois directement ou inscrits dans un grimoire pour être utilisés avec du mana."
		""
		"Place un grimoire compatible et le parchemin voulu dans l'Inscription Table. Si la rareté du sort dépasse celle du livre, il faudra d'abord obtenir un meilleur grimoire."
		""
		"Cette table est le véritable point de départ du mod ; l'exploration fournit ensuite les sorts à y inscrire."
	]
	quest.65C2900000000006.title: "Un premier parchemin"
	quest.65C2900000000006.quest_subtitle: "Lire les traces laissées par les mages"
	quest.65C2900000000006.quest_desc: [
		"Cherche dans les tours de mages, forts, cryptes et autres structures d'Iron's Spells. Les coffres et les lanceurs de sorts sont les principales sources de parchemins et d'encres."
		""
		"Lis l'école, le niveau, le coût en mana et le temps de recharge avant de choisir. Un sort rare n'est pas forcément adapté à ton grimoire ou à ton build."
		""
		"Conserve les doublons : l'Arcane Anvil pourra fusionner des parchemins compatibles pour les améliorer."
	]
	quest.65C2900000000002.title: "La forge à parchemins"
	quest.65C2900000000002.quest_subtitle: "Choisir une école plutôt qu'attendre le bon coffre"
	quest.65C2900000000002.quest_desc: [
		"Le Scroll Forge fabrique un parchemin avec du papier, une encre et le focus de l'école recherchée."
		""
		"La rareté de l'encre fixe le niveau accessible ; un sort dont le minimum est plus élevé refusera une encre trop faible. Le focus détermine l'école, par exemple une Blaze Rod pour le feu ou un Frozen Bone pour la glace."
		""
		"Utilise JEI pour la liste exacte des focus et garde les encres haut niveau pour les sorts qui structurent réellement ton build."
	]
	quest.65C2900000000003.title: "L'enclume arcanique"
	quest.65C2900000000003.quest_subtitle: "Faire évoluer le savoir déjà trouvé"
	quest.65C2900000000003.quest_desc: [
		"L'Arcane Anvil combine des objets magiques : elle améliore des parchemins, fait évoluer certains grimoires et armures avec des Upgrade Orbs, ou imprègne une arme d'un sort."
		""
		"Vérifie l'aperçu avant de confirmer. Une arme ne peut porter qu'une imprégnation à la fois et le parchemin utilisé n'est pas récupéré."
		""
		"Cette étape transforme les trouvailles de donjon en progression maîtrisée plutôt qu'en simple collection."
	]
	quest.65C2900000000004.title: "Élargir la réserve de mana"
	quest.65C2900000000004.quest_subtitle: "Tenir pendant les combats longs"
	quest.65C2900000000004.quest_desc: [
		"Le Ring of Mana augmente la réserve disponible pour enchaîner les sorts. Équipe-le dans un emplacement Curios adapté."
		""
		"Une grande réserve ne corrige pas un sort inefficace : compare aussi la régénération, le temps de lancement, le cooldown et la puissance de l'école."
		""
		"Teste ton cycle complet sur plusieurs ennemis afin de savoir quand revenir à l'arme principale."
	]
	quest.65C2900000000005.title: "Un véritable mage de combat"
	quest.65C2900000000005.quest_subtitle: "Un équipement construit autour de quelques sorts"
	quest.65C2900000000005.quest_desc: [
		"Compose un grimoire couvrant au moins une attaque fiable, une réponse défensive ou de contrôle, et un outil de mobilité."
		""
		"Associe ensuite une armure ou un bâton renforçant ton école dominante. Le résultat doit rester jouable lorsque le mana manque ou qu'un sort est en recharge."
		""
		"Les Catacombes forment une branche facultative pour éprouver ce build et chercher des récompenses plus rares."
	]
	quest.65C2900000000007.title: "La boussole égarée"
	quest.65C2900000000007.quest_subtitle: "Une âme captive connaît le chemin des Catacombes"
	quest.65C2900000000007.quest_desc: [
		"Le Wayward Compass pointe vers les Catacombes chargées dans le monde. Son âme emprisonnée cherche à rejoindre le lieu auquel elle appartenait."
		""
		"Fabrique-la, attends que les chunks voisins soient disponibles, puis suis-la comme un Eye of Ender. Si elle ne trouve rien, explore une nouvelle région avant de recommencer la recherche."
		""
		"Cette branche est facultative et peut être entreprise quand ton grimoire possède déjà plusieurs réponses défensives."
	]
	quest.65C2900000000008.title: "Descendre dans les Catacombes"
	quest.65C2900000000008.quest_subtitle: "Un donjon de magie, pas une simple mine"
	quest.65C2900000000008.quest_desc: [
		"Les Catacombes abritent morts-vivants, lanceurs de sorts, pièges et butin magique. Marque l'entrée et prépare une retraite avant de descendre."
		""
		"Progresse pièce par pièce, éclaire les voies déjà vérifiées et conserve une place pour les encres, parchemins et objets uniques."
		""
		"Le Wayward Compass trouve la structure ; il ne remplace pas l'observation une fois à l'intérieur."
	]
	quest.65C2900000000009.title: "Le Roi défunt"
	quest.65C2900000000009.quest_subtitle: "La couronne se souvient encore de la guerre"
	quest.65C2900000000009.quest_desc: [
		"Au fond des Catacombes repose le Dead King, un boss conçu pour punir les mages immobiles et les aventuriers sans solution de repli."
		""
		"Nettoie l'arène, garde de l'espace pour esquiver et n'entre pas avec un grimoire composé uniquement de sorts lents. Ses récompenses ouvrent des pièces uniques du mod."
		""
		"Un Dead King Phylactery peut servir plus tard à provoquer une nouvelle rencontre ; ne le consomme pas sans l'accord du groupe."
	]
	quest.65C2A00000000001.title: "Première reforge"
	quest.65C2A00000000001.quest_subtitle: "Jusqu'à la rareté Rare sans attendre l'endgame"
	quest.65C2A00000000001.quest_desc: [
		"La Simple Reforging Table accepte les équipements compatibles et peut leur attribuer des affixes jusqu'à la rareté Rare."
		""
		"Elle consomme un matériau correspondant à la rareté visée, un Sigil of Rebirth et de l'expérience. Les trois propositions sont différentes, mais aucune position n'est secrètement meilleure qu'une autre."
		""
		"Reforge une pièce remplaçable pour apprendre l'interface avant de risquer ton équipement principal."
	]
	quest.65C2A00000000002.title: "Récupérer les matériaux"
	quest.65C2A00000000002.quest_subtitle: "Le butin inutile alimente les choix futurs"
	quest.65C2A00000000002.quest_desc: [
		"La Salvaging Table démonte les objets à affixes et rend les matériaux de leur rareté : scrap commun, tissu uncommon, éclats rares, sables épiques ou perles mythiques."
		""
		"Ne recycle pas automatiquement chaque doublon. Compare d'abord ses affixes, ses sockets et sa compatibilité avec les autres membres de l'équipe."
		""
		"Une petite réserve par rareté évite de bloquer une reforge intéressante au moment où elle apparaît."
	]
	quest.65C2A00000000003.title: "Tailler les gemmes"
	quest.65C2A00000000003.quest_subtitle: "Améliorer la pureté d'un bonus choisi"
	quest.65C2A00000000003.quest_desc: [
		"La Gem Cutting Table améliore une gemme avec Gem Dust, des matériaux de rareté et une autre gemme compatible. Le coût augmente avec la pureté."
		""
		"Lis le bonus pour chaque type d'équipement : une même gemme peut produire des effets différents dans une arme, une armure ou un bijou."
		""
		"Consulte JEI avant de sacrifier une gemme rare et réserve les améliorations coûteuses aux pièces que tu comptes vraiment conserver."
	]
	quest.65C2A00000000004.title: "Augmenter un équipement"
	quest.65C2A00000000004.quest_subtitle: "Modifier un affixe sans rerouler toute la pièce"
	quest.65C2A00000000004.quest_desc: [
		"L'Augmenting Table est l'atelier de précision d'Apotheosis. Elle améliore ou remplace un affixe sélectionné en laissant les autres intacts."
		""
		"Elle demande notamment une Nether Star, deux Godforged Pearls et des Sigils of Enhancement. Ce coût la réserve surtout aux objets Epic solides ou Mythic destinés à durer."
		""
		"Choisis l'affixe selon le rôle de la pièce ; chercher uniquement la valeur la plus élevée produit rarement le meilleur build."
	]
	quest.65C2A00000000005.title: "Optimisation contrôlée"
	quest.65C2A00000000005.quest_subtitle: "La cohérence avant la rareté"
	quest.65C2A00000000005.quest_desc: [
		"Tu sais désormais reforger, recycler, tailler des gemmes et corriger un affixe précis."
		""
		"Active aussi les World Tiers que tu as réellement débloqués : ils sont personnels et modifient à la fois les récompenses disponibles et la force des ennemis."
		""
		"Le Chronicle of Shadows affiche les règles exactes du tier actuel. Vérifie-le avant de conclure qu'un type de butin ne peut pas apparaître."
	]
	quest.65C2B00000000001.title: "Trois familles de butin"
	quest.65C2B00000000001.quest_subtitle: "Arme de classe, armure évolutive, relique singulière"
	quest.65C2B00000000001.quest_desc: [
		"Arsenal, Armory et Relics ne suivent pas la même logique. Une arme définit souvent le rythme du build, une armure soutient sa progression et une Relic ajoute une capacité particulière."
		""
		"Examine les attributs et conditions d'activation avant d'équiper une nouveauté. Un objet plus rare peut rompre une synergie déjà efficace."
		""
		"Ces trouvailles restent des récompenses d'exploration, jamais des clés obligatoires de la campagne."
	]
	quest.65C2B00000000002.title: "Trouver une arme Arsenal"
	quest.65C2B00000000002.quest_subtitle: "Essayer son mouvement avant de juger ses chiffres"
	quest.65C2B00000000002.quest_desc: [
		"Les armes Arsenal apparaissent dans le butin lié à la progression et aux combats. Leur portée, vitesse et enchaînement comptent autant que les dégâts affichés."
		""
		"Teste l'arme sur des ennemis ordinaires, puis observe les attributs soutenus par ton arbre de compétences et ton armure."
		""
		"Une arme rare n'est pas dupliquée dans la récompense personnelle d'un boss : partagez les exemplaires selon les builds de l'équipe."
	]
	quest.65C2B00000000003.title: "Ouvrir Armory"
	quest.65C2B00000000003.quest_subtitle: "Un composant important par palier"
	quest.65C2B00000000003.quest_desc: [
		"Les composants Armory font évoluer les ensembles RPG à des moments précis de la campagne."
		""
		"Les récompenses d'acte proposent peu de matériaux vraiment importants, avec au maximum un composant majeur par choix. Cette rareté doit encourager une spécialisation, pas une montée uniforme de toute l'équipe."
		""
		"Vérifie dans JEI l'ensemble concerné avant de consommer un upgrade Epic."
	]
	quest.65C2B00000000004.title: "Chasser les Relics"
	quest.65C2B00000000004.quest_subtitle: "Une capacité à comprendre, pas seulement un slot à remplir"
	quest.65C2B00000000004.quest_desc: [
		"Les Relics se découvrent dans le butin et proposent souvent une mécanique propre, parfois renforcée par l'usage."
		""
		"Lis la description complète, vérifie l'emplacement Curios et essaie l'objet hors combat. Certaines reliques demandent une action, une charge ou une condition que leurs attributs seuls ne montrent pas."
		""
		"Garde les pièces inutilisées pour les autres builds plutôt que de les considérer comme du simple matériau."
	]
	quest.65C2B00000000005.title: "Définir un build"
	quest.65C2B00000000005.quest_subtitle: "Faire travailler les systèmes ensemble"
	quest.65C2B00000000005.quest_desc: [
		"Choisis une arme principale, une armure, une Relic et quelques affixes servant la même boucle de combat."
		""
		"Vérifie ensuite trois faiblesses : survivre quand la mobilité est bloquée, continuer lorsque la ressource principale manque, et répondre à une cible hors de portée."
		""
		"Un build capable de gérer ces situations vaut davantage qu'un total de dégâts idéal dans des conditions parfaites."
	]
	quest.65C2600000000002.title: "Le Gatekeeper"
	quest.65C2600000000002.quest_subtitle: "Le gardien jauge ceux qui réclament le passage"
	quest.65C2600000000002.quest_desc: [
		"Parle d'abord au Gatekeeper des Portal Ruins. Lorsque son épreuve commence, reste réellement dans la zone du combat pour être reconnu comme participant."
		""
		"Il constitue l'introduction d'Eternal Starlight : observe ses télégraphes, garde le cadre du portail intact et ne l'attire pas vers une base voisine."
		""
		"Son butin reste celui du mod. Les récompenses personnelles du pack donnent des matériaux utiles, jamais une copie supplémentaire de son objet rare."
	]
	quest.65C260000000000B.title: "L'Orb of Prophecy"
	quest.65C260000000000B.quest_subtitle: "La clé laissée par le gardien"
	quest.65C260000000000B.quest_desc: [
		"Le Gatekeeper laisse l'Orb of Prophecy avec le livre d'Eternal Starlight. L'orbe n'est pas un trophée décoratif : elle active le cadre ancien des Portal Ruins."
		""
		"Rapporte-la au portail et utilise-la sur la structure prévue par le mod. Ne démonte pas les ruines avant d'avoir confirmé que le passage fonctionne dans les deux sens."
		""
		"Si plusieurs joueurs arrivent plus tard, le portail déjà ouvert leur reste accessible."
	]
	quest.65C2600000000003.title: "Eternal Starlight"
	quest.65C2600000000003.quest_subtitle: "Entrer sous un ciel qui ne s'éteint jamais"
	quest.65C2600000000003.quest_desc: [
		"Franchis le portail activé par l'Orb of Prophecy. La dimension possède ses propres biomes, structures et dangers ; elle n'est pas une simple extension de l'Overworld."
		""
		"Sécurise immédiatement le point d'arrivée avec des blocs, de la lumière et un repère visible. Vérifie le retour avant de partir explorer loin."
		""
		"Les Waystones ne peuvent pas y être posées : le réseau de portails et les itinéraires préparés font partie de l'expédition."
	]
	quest.65C260000000000C.title: "Le livre et le Seeking Eye"
	quest.65C260000000000C.quest_subtitle: "Comprendre comment la lumière désigne un lieu"
	quest.65C260000000000C.quest_desc: [
		"Le livre remis par le Gatekeeper présente les systèmes du mod. Garde-le dans l'atelier ou consulte-le avant de chercher une arène inconnue."
		""
		"Le Seeking Eye se fabrique avec huit Starlight Flowers autour d'une Ender Pearl. Dans Starlight, tiens-le avec un matériau lié à la structure recherchée pour obtenir une direction."
		""
		"JEI donne la recette exacte ; la quête suivante explique quels objets servent de repères."
	]
	quest.65C2600000000004.title: "Lire les arènes"
	quest.65C2600000000004.quest_subtitle: "Le bon matériau transforme l'œil en boussole"
	quest.65C2600000000004.quest_desc: [
		"Pour la Golem Forge, essaie le Seeking Eye avec de la Redstone, de l'Oxidized Golem Steel ou du Golem Steel. Pour le Cursed Garden, utilise des plantes associées au lieu, comme des vines ou du Cave Moss."
		""
		"L'œil indique une direction, pas un chemin sûr. Emporte de quoi franchir le terrain, marque l'entrée et rassemble l'équipe avant d'activer quoi que ce soit."
		""
		"Les trois boss suivants peuvent être affrontés dans l'ordre de votre choix."
	]
	quest.65C2600000000005.title: "Le Starlight Golem"
	quest.65C2600000000005.quest_subtitle: "Désassembler une défense plutôt que frapper un mur"
	quest.65C2600000000005.quest_desc: [
		"La Golem Forge protège le Starlight Golem avec plusieurs Energy Blocks. Tant qu'ils soutiennent son armure, une attaque frontale gaspille surtout du temps et des ressources."
		""
		"Repère ces blocs, coordonne leur désactivation et profite de la fenêtre où la protection du boss s'effondre. Garde néanmoins un joueur attentif aux attaques de zone."
		""
		"Le combat récompense l'observation du donjon autant que la puissance brute."
	]
	quest.65C2600000000006.title: "Permafrost"
	quest.65C2600000000006.quest_subtitle: "Quand la forge ancienne se couvre de glace"
	quest.65C2600000000006.quest_desc: [
		"Permafrost appartient lui aussi à la branche de la Golem Forge. Le Seeking Eye et les matériaux métalliques du lieu permettent donc de retrouver son territoire."
		""
		"Prévois mobilité, résistance et un espace dégagé : ses effets de froid punissent les joueurs regroupés ou bloqués contre le décor."
		""
		"Ce boss est parallèle au Starlight Golem ; vaincre l'un ne remplace pas l'autre."
	]
	quest.65C2600000000007.title: "La Lunar Monstrosity"
	quest.65C2600000000007.quest_subtitle: "Le jardin maudit nourrit sa carapace"
	quest.65C2600000000007.quest_desc: [
		"Le Cursed Garden se recherche avec le Seeking Eye et des plantes liées à cette structure. Sous sa végétation repose la Lunar Monstrosity."
		""
		"Le boss réduit fortement les dégâts reçus dans son état normal. L'enflammer ou l'étourdir ouvre une période où cette défense disparaît : prépare au moins un moyen fiable de provoquer cet état."
		""
		"Ne brûle pas tout le terrain avant d'avoir identifié l'arène et les issues."
	]
	quest.65C2600000000008.title: "Maîtriser Starlight"
	quest.65C2600000000008.quest_subtitle: "Trois menaces, trois leçons comprises"
	quest.65C2600000000008.quest_desc: [
		"Le Starlight Golem, Permafrost et la Lunar Monstrosity forment le cœur de cette campagne. Leur ordre reste libre, mais chacun doit être vaincu."
		""
		"Rassemble le butin, remets en état l'équipement commun et conserve les matériaux propres à la dimension : certains restent utiles bien après ces combats."
		""
		"Eternal Starlight prépare l'équipe à Cataclysm, sans chercher encore la même brutalité."
	]
	quest.65C2600000000009.title: "Participant reconnu"
	quest.65C2600000000009.quest_subtitle: "Être présent dans l'arène, pas seulement dans l'équipe"
	quest.65C2600000000009.quest_desc: [
		"Un joueur est considéré comme participant lorsqu'il est réellement présent pendant le combat. Être membre de l'équipe ou rester près du portail ne suffit pas."
		""
		"Cette règle protège les récompenses personnelles contre les duplications passives. Elles contiennent des matériaux et utilitaires adaptés au palier, jamais une seconde arme rare du boss."
		""
		"Cette quête est informative et facultative ; valide-la après avoir compris la règle du serveur."
	]
	quest.65C260000000000A.title: "Aux portes de Cataclysm"
	quest.65C260000000000A.quest_subtitle: "La lumière éternelle n'était qu'un avertissement"
	quest.65C260000000000A.quest_desc: [
		"L'équipe sait maintenant localiser une structure, préparer une arène et exploiter une mécanique de vulnérabilité au lieu de compter uniquement sur les dégâts."
		""
		"Répartissez les rôles, préparez une réserve commune et choisissez des équipements réellement testés. Les donjons de Cataclysm sont légèrement renforcés et leurs boss prennent surtout en puissance avec le nombre de joueurs présents."
		""
		"La campagne suivante suit trois actes dans un ordre conseillé, avec liberté à l'intérieur de chaque acte."
	]
	quest.65C2700000000001.title: "Cataclysm"
	quest.65C2700000000001.quest_subtitle: "Trois actes, huit gardiens et aucune route unique"
	quest.65C2700000000001.quest_desc: [
		"Les grandes structures de Cataclysm abritent des boss conçus comme des expéditions de fin de campagne. Chaque rencontre commence par un Eye de localisation, se poursuit dans un donjon, puis s'achève dans une arène."
		""
		"Les actes indiquent une montée en difficulté, mais les boss d'un même acte restent parallèles. Explorez ensemble, posez un point de rassemblement hors du donjon et confirmez que tout le monde est prêt avant l'engagement."
		""
		"Les armes signatures restent des butins natifs uniques ; les récompenses personnelles privilégient les matériaux utiles."
	]
	quest.65C2700000000003.title: "Ender Guardian"
	quest.65C2700000000003.quest_subtitle: "L'Eye of Void révèle la Ruined Citadel"
	quest.65C2700000000003.quest_desc: [
		"L'Eye of Void cherche la Ruined Citadel dans les îles extérieures de l'End. Traverse la citadelle jusqu'à son autel et prépare l'arène avant d'approcher le gardien."
		""
		"L'Ender Guardian contrôle les distances avec téléportations, ondes de choc et attraction. Garde des appuis stables, une réponse à la chute et plusieurs angles d'attaque."
		""
		"Le Gauntlet of Guard est son trophée majeur et l'une des preuves de l'Acte I."
	]
	quest.65C2700000000004.title: "The Harbinger"
	quest.65C2700000000004.quest_subtitle: "L'Eye of Mech suit un signal oublié"
	quest.65C2700000000004.quest_desc: [
		"L'Eye of Mech localise l'Ancient Factory dans l'Overworld. Fouille l'usine méthodiquement : ses couloirs et ses machines préparent le combat contre The Harbinger."
		""
		"Le boss alterne tirs, missiles et phases où rester immobile devient dangereux. Répartissez-vous autour de l'arène afin qu'une seule attaque ne frappe pas tout le groupe."
		""
		"Le Witherite Block récupéré après la victoire complète les preuves demandées pour l'Acte I."
	]
	quest.65C27A0000000005.title: "Fin de l'Acte I"
	quest.65C27A0000000005.quest_subtitle: "Les premières reliques changent de mains"
	quest.65C27A0000000005.quest_desc: [
		"Réunis le Monstrous Horn, le Gauntlet of Guard et le Witherite Block. Ces objets attestent que les trois donjons du premier acte ont été réellement parcourus."
		""
		"La récompense propose peu de matériaux, mais ils comptent pour le palier suivant : au maximum un composant majeur par choix, sans duplication des armes signatures."
		""
		"Avant l'Acte II, réparez l'équipement, partagez les trouvailles selon les builds et complétez les faiblesses révélées par ces combats."
	]
	quest.65C2700000000006.title: "Ancient Remnant"
	quest.65C2700000000006.quest_subtitle: "L'Eye of Desert désigne une pyramide ensevelie"
	quest.65C2700000000006.quest_desc: [
		"Suis l'Eye of Desert jusqu'à la Cursed Pyramid. L'Ancient Remnant sommeille dans ses profondeurs ; l'excavation du sable suspect du sanctuaire permet de réveiller ce gardien ancien."
		""
		"Ses charges et impacts couvrent une large zone. Libère l'espace autour de l'arène, évite les angles morts et garde une solution de mobilité qui ne dépend pas d'un sol intact."
		""
		"Le désert donne des indices, mais il ne pardonne pas une équipe arrivée sans eau, nourriture et blocs."
	]
	quest.65C2700000000007.title: "Scylla"
	quest.65C2700000000007.quest_subtitle: "L'Eye of Storm appelle l'Acropolis"
	quest.65C2700000000007.quest_desc: [
		"L'Eye of Storm localise l'Acropolis. Explore cette forteresse céleste jusqu'au domaine de Scylla et sécurise les passages exposés avant de commencer le combat."
		""
		"La rencontre mêle mobilité, éclairs et contrôle de zone. Écartez-vous suffisamment pour lire les attaques sans isoler un joueur derrière le décor."
		""
		"Les chutes font partie du danger : prévois un moyen fiable de revenir sur une plateforme ou d'en survivre."
	]
	quest.65C2700000000008.title: "The Leviathan"
	quest.65C2700000000008.quest_subtitle: "L'Eye of Abyss descend vers la Sunken City"
	quest.65C2700000000008.quest_desc: [
		"L'Eye of Abyss indique la Sunken City sous les océans. Prépare respiration, visibilité et mobilité aquatique avant d'en chercher l'arène et l'Altar of Abyss."
		""
		"The Leviathan combat dans un volume, pas sur un sol plat. Ses déplacements et attaques aspirantes exigent de surveiller la profondeur autant que la distance horizontale."
		""
		"Installe le point de repli hors de la structure afin qu'une défaite ne transforme pas la récupération en seconde expédition improvisée."
	]
	quest.65C27A0000000009.title: "Fin de l'Acte II"
	quest.65C27A0000000009.quest_subtitle: "Désert, ciel et abîme sont franchis"
	quest.65C27A0000000009.quest_desc: [
		"Les trois gardiens de l'Acte II sont tombés. Cette étape vérifie leurs trophées et ouvre la dernière partie de la campagne principale."
		""
		"Choisis la récompense en fonction d'un projet précis : équipement, amélioration de build ou préparation d'un membre de l'équipe. Les composants importants restent volontairement peu nombreux."
		""
		"L'Acte III ne compte que deux boss principaux, mais chacun demande une préparation plus rigoureuse que les rencontres précédentes."
	]
	quest.65C270000000000A.title: "Maledictus"
	quest.65C270000000000A.quest_subtitle: "L'Eye of Curse ouvre la route de la Frosted Prison"
	quest.65C270000000000A.quest_desc: [
		"L'Eye of Curse localise la Frosted Prison. Le donjon enferme Maledictus et ses propres gardiens ; ne confonds pas l'arrivée dans la structure avec l'arrivée dans l'arène."
		""
		"La malédiction alterne pression rapprochée, déplacements brusques et attaques difficiles à encaisser en groupe compact. Nettoie les alentours et conserve plusieurs axes d'esquive."
		""
		"L'Acte III peut commencer ici ou auprès d'Ignis : les deux branches doivent finalement être terminées."
	]
	quest.65C270000000000B.title: "Ignis"
	quest.65C270000000000B.quest_subtitle: "L'Eye of Flame trouve la Burning Arena"
	quest.65C270000000000B.quest_desc: [
		"Suis l'Eye of Flame dans le Nether jusqu'à la Burning Arena. Les Burning Ashes s'emploient à l'Altar of Fire pour appeler Ignis lorsque toute l'équipe est en place."
		""
		"Ignis enchaîne les attaques de feu, les frappes de mêlée et des ripostes qui punissent l'acharnement. Apprends ses fenêtres au lieu de vider toute l'endurance sur son bouclier."
		""
		"Prépare résistance au feu et soins, mais ne compte pas sur eux pour ignorer les mécaniques de l'arène."
	]
	quest.65C27A000000000C.title: "Ascendant"
	quest.65C27A000000000C.quest_subtitle: "La campagne s'achève, le monde reste ouvert"
	quest.65C27A000000000C.quest_desc: [
		"Maledictus et Ignis sont vaincus. Avec eux s'achève la campagne principale prévue pour la version 1.0 d'Ascendant."
		""
		"Cette victoire ne verrouille ni la construction, ni l'industrie, ni les boss ajoutés plus tard. Elle marque seulement le moment où l'équipe a traversé les trois actes conseillés."
		""
		"La récompense finale soutient un projet d'endgame ; elle ne distribue pas automatiquement toutes les armes rares manquantes."
	]
	quest.65C270000000000D.title: "Ignited Revenant"
	quest.65C270000000000D.quest_subtitle: "Une menace facultative dans les terres brûlées"
	quest.65C270000000000D.quest_desc: [
		"L'Ignited Revenant est un mini-boss de Cataclysm rencontré en marge des objectifs principaux. Il protège du butin utile, mais ne bloque aucun acte."
		""
		"Son bouclier et ses attaques enflammées favorisent les ouvertures courtes. Élimine d'abord les ennemis ordinaires et évite de te battre dans un passage trop étroit."
		""
		"Cette branche peut être remise à plus tard sans ralentir la campagne."
	]
	quest.65C270000000000E.title: "Ender Golem"
	quest.65C270000000000E.quest_subtitle: "Les pierres de la citadelle se mettent en marche"
	quest.65C270000000000E.quest_desc: [
		"L'Ender Golem garde certaines zones liées aux ruines de l'End. Il constitue une rencontre facultative sur la route du contenu principal."
		""
		"Ses coups lourds projettent et contrôlent le terrain. Garde le vide hors de ton dos et exploite ses récupérations lentes plutôt que d'échanger les coups."
		""
		"Vaincre ce gardien apporte du butin et une meilleure lecture des dangers de la Ruined Citadel."
	]
	quest.65C270000000000F.title: "The Prowler"
	quest.65C270000000000F.quest_subtitle: "Une machine de chasse dans l'Ancient Factory"
	quest.65C270000000000F.quest_desc: [
		"The Prowler patrouille dans l'Ancient Factory. Ce mini-boss facultatif complète l'exploration de l'usine sans remplacer The Harbinger."
		""
		"Ses attaques mécaniques deviennent difficiles à lire au milieu d'autres créatures. Nettoie le secteur, utilise les obstacles avec prudence et garde de la place pour ses charges."
		""
		"Sa défaite récompense les joueurs qui fouillent réellement le donjon plutôt que de courir directement vers l'arène finale."
	]
	quest.65C2700000000010.title: "L'endgame reste ouvert"
	quest.65C2700000000010.quest_subtitle: "D'autres gardiens pourront rejoindre la campagne"
	quest.65C2700000000010.quest_desc: [
		"La fin de l'Acte III n'est pas une frontière technique. De nouveaux boss ou chapitres peuvent être ajoutés plus tard sans retirer les victoires déjà acquises."
		""
		"Les quêtes conservent leurs identifiants afin que les mises à jour n'effacent pas la progression des joueurs. Les futures branches partiront de jalons existants ou resteront facultatives."
		""
		"Pour l'instant, l'endgame peut se poursuivre par les constructions ambitieuses, l'automatisation et l'optimisation des builds."
	]
	quest.65C2C00000000002.title: "Convertir le mouvement en énergie"
	quest.65C2C00000000002.quest_subtitle: "Faire circuler la puissance entre Create et les machines FE"
	quest.65C2C00000000002.quest_desc: [
		"L'Alternator transforme la rotation en énergie FE ; l'Electric Motor effectue la conversion inverse. Ensemble, ils relient l'atelier mécanique au reste de l'industrie."
		""
		"Teste chaque direction séparément avec un stockage d'énergie et surveille le stress cinétique. La conversion a un coût : évite de boucler moteur et alternateur l'un sur l'autre."
		""
		"Ce pont permet de choisir la source d'énergie adaptée à chaque phase du projet."
	]
	quest.65C2C00000000003.title: "Traitement industriel"
	quest.65C2C00000000003.quest_subtitle: "Une première chaîne Mekanism complète"
	quest.65C2C00000000003.quest_desc: [
		"Installe un Metallurgic Infuser, une Enrichment Chamber et un Energized Smelter. Ils produisent les circuits, concentrent les minerais et ferment les recettes nécessitant une cuisson."
		""
		"Branche l'énergie, configure les faces d'entrée et de sortie, puis fais passer un minerai de bout en bout. Les composants doivent circuler sans déplacement manuel une fois la chaîne réglée."
		""
		"Cette base ouvre les machines avancées de Mekanism et le traitement multiplié des minerais."
	]
	quest.65C2C00000000004.title: "Centraliser le réseau"
	quest.65C2C00000000004.quest_subtitle: "Un premier système ME réellement utilisable"
	quest.65C2C00000000004.quest_desc: [
		"Assemble un Energy Acceptor, un ME Drive, une cellule 4k et un Crafting Terminal. Ce petit réseau stocke les objets et permet de fabriquer directement depuis son inventaire."
		""
		"Alimente l'Acceptor, insère la cellule dans le Drive et relie les blocs avec du câble Fluix. Vérifie que le terminal affiche les objets déposés et qu'une recette peut utiliser ce stock."
		""
		"Le Controller viendra seulement lorsque le réseau dépassera huit appareils demandant un canal."
	]
	quest.65C2C00000000005.title: "Automatiser la production"
	quest.65C2C00000000005.quest_subtitle: "Une ferme Industrial Foregoing qui travaille seule"
	quest.65C2C00000000005.quest_desc: [
		"Construis un Plant Sower sous la zone cultivée et un Plant Gatherer orienté vers elle. Le premier replante ; le second récolte et produit aussi du Sludge."
		""
		"Fournis de l'énergie aux deux machines, place les graines dans les secteurs du Sower et règle leurs zones de travail. Attends un cycle naturel pour confirmer récolte, stockage et replantation."
		""
		"Une ferme validée doit continuer sans qu'un joueur replante manuellement."
	]
	quest.65C2C00000000006.title: "Produire à grande échelle"
	quest.65C2C00000000006.quest_subtitle: "Construire le premier vrai réacteur Extreme Reactors"
	quest.65C2C00000000006.quest_desc: [
		"Réunis les pièces d'un réacteur Basic minimal : 22 casings, un Controller, un Fuel Rod, un Control Rod, un Solid Access Port et un Active FE Power Tap."
		""
		"Forme un multibloc 3 x 3 x 3, place le Fuel Rod au centre sous le Control Rod et garde l'intérieur valide. Charge du Yellorium, branche une réserve d'énergie, puis démarre à faible taux d'insertion."
		""
		"Observe température, rendement et consommation avant d'agrandir : la quête demande un réacteur compris, pas seulement ses blocs."
	]
	quest.65C2C00000000007.title: "Technologie de fin de jeu"
	quest.65C2C00000000007.quest_subtitle: "La fusion Draconic transforme les composants rares"
	quest.65C2C00000000007.quest_desc: [
		"Installe un Fusion Crafting Core entouré d'au moins quatre Basic Crafting Injectors. Les injecteurs doivent viser le cœur, recevoir les ingrédients et disposer de l'énergie requise."
		""
		"Réalise une première fusion contrôlée, puis fabrique un Awakened Core lorsque les Dragon Hearts et le Draconium éveillé sont disponibles. L'interface indique les injecteurs mal placés ou insuffisants."
		""
		"Ce système ouvre l'équipement modulaire et le stockage d'énergie de fin de jeu."
	]
	quest.65C2300000000001.title: "L'alliage d'andésite"
	quest.65C2300000000001.quest_subtitle: "Le matériau qui ouvre toute la cinétique"
	quest.65C2300000000001.quest_desc: [
		"L'Andesite Alloy est l'exception utile parmi les quêtes de matériaux : presque tous les premiers composants mécaniques de Create en dépendent."
		""
		"Fabrique-en une petite réserve avec la recette affichée par JEI, puis transforme-la immédiatement en shafts, cogwheels et casings selon les besoins de l'atelier."
		""
		"Le but n'est pas de stocker l'alliage, mais d'obtenir les pièces nécessaires à une première rotation."
	]
	quest.65C2300000000002.title: "Première rotation"
	quest.65C2300000000002.quest_subtitle: "Produire de la force et lire le stress"
	quest.65C2300000000002.quest_desc: [
		"Place une Water Wheel dans un courant correctement orienté, puis récupère sa rotation avec un Shaft. Des Cogwheels et Gearboxes changent l'axe ou transmettent le mouvement."
		""
		"Observe la vitesse et la capacité de stress avec les lunettes de Create. Chaque machine consomme une partie de cette capacité ; un réseau overstressed s'arrête entièrement."
		""
		"Ponder montre les montages valides sans imposer la forme de ta future usine."
	]
	quest.65C2300000000003.title: "Presser"
	quest.65C2300000000003.quest_subtitle: "Le premier traitement mécanique visible"
	quest.65C2300000000003.quest_desc: [
		"La Mechanical Press travaille au-dessus d'un Depot, d'un Belt ou d'un Basin. Alimente-la par son axe et laisse un bloc d'espace sous la tête."
		""
		"Teste une recette de compactage indiquée par JEI et regarde le cycle complet. Sur convoyeur, la presse traite les objets qui passent sans inventaire intermédiaire."
		""
		"Cette logique de positionnement se retrouvera dans presque toutes les machines Create."
	]
	quest.65C2300000000004.title: "Transport continu"
	quest.65C2300000000004.quest_subtitle: "Déplacer les objets sans menus ni tuyaux invisibles"
	quest.65C2300000000004.quest_desc: [
		"Un Mechanical Belt se tend entre deux Shafts alignés. Il transporte les objets, relie certaines rotations et sert de surface de travail à plusieurs machines."
		""
		"Ajoute un Funnel ou un Chute pour contrôler l'entrée et la sortie, puis vérifie qu'aucun objet ne s'accumule au bout de la ligne."
		""
		"Commence par un trajet court et lisible ; les filtres et tunnels viendront lorsque plusieurs produits partageront le convoyeur."
	]
	quest.65C2300000000005.title: "Mélanger et chauffer"
	quest.65C2300000000005.quest_subtitle: "Le Basin devient une cuve de traitement"
	quest.65C2300000000005.quest_desc: [
		"Place le Mechanical Mixer au-dessus d'un Basin et alimente-le à une vitesse suffisante. Le Basin accepte objets et fluides puis expose le résultat aux sorties configurées."
		""
		"Réalise d'abord une recette sans chaleur. Les recettes marquées Heated ou Superheated demanderont ensuite un Blaze Burner sous la cuve."
		""
		"Utilise Ponder pour vérifier la hauteur et JEI pour distinguer mélange, compactage et brassage."
	]
	quest.65C2300000000006.title: "La chaleur du Blaze"
	quest.65C2300000000006.quest_subtitle: "Capturer une flamme plutôt que fabriquer un brûleur plein"
	quest.65C2300000000006.quest_desc: [
		"Fabrique un Empty Blaze Burner, emporte-le dans le Nether et utilise-le directement sur un Blaze. Le bloc capture la créature et devient un Blaze Burner utilisable sous un Basin."
		""
		"Le combustible ordinaire fournit l'état Heated. Un Blaze Cake pousse temporairement le brûleur vers Superheated pour les recettes les plus exigeantes."
		""
		"Teste la température avant de construire une chaîne qui dépend d'un état que tu ne peux pas encore entretenir."
	]
	quest.65C2300000000007.title: "Assemblage mécanique"
	quest.65C2300000000007.quest_subtitle: "Faire converger plusieurs grilles vers une sortie"
	quest.65C2300000000007.quest_desc: [
		"Les Mechanical Crafters forment une grille de fabrication à la verticale. Place les ingrédients dans le motif de la recette et oriente leurs flèches pour que tous les chemins convergent vers une seule sortie."
		""
		"Relie la grille à une rotation suffisante, puis déclenche le craft. Si un crafter reste bloqué, vérifie sa flèche, son ingrédient et la capacité de stress du réseau."
		""
		"Ne construis que la taille nécessaire au premier objet important ; la grille pourra être étendue plus tard."
	]
	quest.65C2300000000008.title: "Le rail devient réseau"
	quest.65C2300000000008.quest_subtitle: "Assembler un train avant d'écrire son horaire"
	quest.65C2300000000008.quest_desc: [
		"Pose une voie continue, une Track Station et les bogeys du futur train. Passe la station en mode assemblage, construis les wagons reliés avec de la Super Glue et ajoute des Train Controls."
		""
		"Une fois le train assemblé, utilise un Schedule pour lui donner des destinations et conditions d'attente. Les Train Signals deviennent importants lorsque plusieurs trains partagent les mêmes rails."
		""
		"Valide d'abord un aller-retour simple avant d'étendre le réseau."
	]
	quest.65C2300000000009.title: "Pont vers l'énergie FE"
	quest.65C2300000000009.quest_subtitle: "Convertir la rotation dans les deux sens"
	quest.65C2300000000009.quest_desc: [
		"L'Alternator produit de l'énergie FE à partir d'un réseau cinétique. L'Electric Motor consomme de la FE pour fournir une rotation réglable."
		""
		"Branche un stockage entre les systèmes et mesure ce qui entre et sort. La vitesse augmente la demande de stress ou d'énergie ; dimensionne la transmission au lieu de forcer le réglage maximal."
		""
		"Ce pont permet à Create de coopérer avec Mekanism, Powah et les autres réseaux du pack."
	]
	quest.65C230000000000A.title: "Fret pour la colonie"
	quest.65C230000000000A.quest_subtitle: "Relier Create au système de demandes MineColonies"
	quest.65C230000000000A.quest_desc: [
		"Create: Colony Logistics relie une infrastructure de fret aux demandes de MineColonies. Le Logistics Controller coordonne le réseau et le Freight Depot sert de point d'échange."
		""
		"Installe d'abord le Warehouse et les Couriers de la colonie, puis relie un trajet Create stable. Teste une ressource simple et abondante avant de confier au système un composant rare."
		""
		"Cette branche est utile à une colonie développée, mais elle n'est pas nécessaire pour progresser dans Create."
	]
	quest.65C230000000000B.title: "Raffinerie et diesel"
	quest.65C230000000000B.quest_subtitle: "Transformer des fluides en force mécanique"
	quest.65C230000000000B.quest_desc: [
		"Create: Diesel Generators ajoute une chaîne de distillation et des moteurs alimentés par des carburants liquides. Le Distillation Controller forme le cœur de la raffinerie ; le Diesel Engine reconvertit le carburant en rotation."
		""
		"Utilise Ponder et JEI pour la structure et les fluides exacts de ta version, puis sépare clairement les réservoirs d'entrée et de sortie. Vérifie le sens des pompes avant le premier démarrage."
		""
		"Cette production est une branche avancée de Create, pas un prérequis pour les trains ou l'assemblage mécanique."
	]
	quest.65C230000000000C.title: "Infrastructure mécanique"
	quest.65C230000000000C.quest_subtitle: "Une usine lisible, alimentée et extensible"
	quest.65C230000000000C.quest_desc: [
		"Ton réseau sait désormais traiter, transporter, assembler, convertir de l'énergie et déplacer du fret. Valide cette étape lorsque plusieurs fonctions travaillent réellement ensemble."
		""
		"Sépare les lignes critiques, affiche les sens de circulation et garde une marge de stress. Une usine compacte mais impossible à diagnostiquer devient vite plus coûteuse qu'une ligne un peu plus longue."
		""
		"Les prochaines extensions doivent résoudre un besoin concret de la base ou de la colonie."
	]
	quest.65C2200000000002.title: "Ouvrir le Nether"
	quest.65C2200000000002.quest_subtitle: "L'obsidienne ouvre le premier carrefour"
	quest.65C2200000000002.quest_desc: [
		"Construis un cadre d'obsidienne et allume son intérieur avec un briquet. Dix blocs suffisent si les quatre angles sont laissés vides."
		""
		"Le Nether fournit Blaze Rods, quartz, verrues et débris antiques, mais sert aussi de réseau rapide entre bases."
		""
		"Garde un briquet dans un coffre des deux côtés : un Ghast peut éteindre un portail sans détruire son cadre."
	]
	quest.65C2800000000001.title: "Le grimoire du novice"
	quest.65C2800000000001.quest_subtitle: "Écrire une formule plutôt qu'apprendre un sort figé"
	quest.65C2800000000001.quest_desc: [
		"Le Novice's Spell Book est ton atelier de composition portable. Il stocke plusieurs formules construites avec une forme, un effet et des augmentations."
		""
		"Commence par un sort court et peu coûteux. Une formule spectaculaire mais trop chère en mana ne t'aidera pas lorsque le combat dure."
		""
		"Le Worn Notebook décrit chaque glyphe ; le Scribe's Table permettra d'en apprendre de nouveaux."
	]
}
