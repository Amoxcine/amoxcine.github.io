	task.2FA7F95BF7484D96.title: "Faire fonctionner la chaîne de traitement x3"
	task.30A1F1ADC31ACF70.title: "Former la Turbine et recycler son eau"
	task.30DF11350A2D7186.title: "Former le Réacteur à fission sans l'allumer"
	task.316F3A6D30B5B152.title: "Former et tester la Matrice d'induction"
	task.4261D7A3BB9EA88A.title: "Régler le Condenseur sur le mode Singularité"
	task.444A000000001104.title: "Faire tourner la foreuse sur une zone délimitée"
	task.444A000000001801.title: "Avoir visité les cinq dimensions"
